// Data shapes shared by Rust and the UI.

export struct HistoryItem {
    desk_id: string,
    alias: string,
    last_connected: string,
}

export struct HostItem {
    desk_id: string,
    device_name: string,
    alias: string,          // name an administrator gave it on the relay ("" = none)
    platform: string,
    online: bool,
    last_seen: string,
}

// ---- Viewer sessions (see docs/features/viewer-sessions.md). Rust fills these; the UI only renders them. ----

export struct MonitorItem {
    index: int,        // host monitor index, sent back in select_monitor
    label: string,     // "1", "2", ...
    width: int,        // native pixels
    height: int,
    primary: bool,
}

export struct SessionView {
    id: string,             // host clean desk ID: the session key for every callback
    title: string,          // alias or formatted ID
    subtitle: string,       // device name / platform
    connecting: bool,       // true until the first frame arrives
    has_frame: bool,
    frame: image,
    cursor: int,            // cursor shape code (see remote_canvas.slint)
    path: string,           // "P2P" or "Relay"
    fps: int,
    stream_width: int,
    stream_height: int,
    status: string,         // short per-session status line (transfers, errors)
    mic_muted: bool,
    privacy_mode: int,
    block_input: bool,
    privacy_unavailable: bool,      // the host cannot show a privacy screen (Linux hosts)
    block_input_unavailable: bool,  // the host cannot lock its local input (Linux hosts)
    resolution_mode: int,   // 1 = automatic, 0 = native, 1080/720/480 presets
    audio_quality: int,
    monitors: [MonitorItem],
    active_monitor: int,    // index into the host's monitor list
}

// ---- Monitor wall, admin edition (see docs/features/monitor-wall.md at the repository root) ----

export struct MonitorTile {
    id: string,             // host clean desk ID
    title: string,          // device name
    subtitle: string,       // formatted desk ID
    state: int,             // 0 waiting, 1 live, 2 offline, 3 unsupported, 4 denied
    has_frame: bool,
    frame: image,
}

export struct MonitorPick {
    id: string,             // host clean desk ID
    name: string,
    online: bool,
    selected: bool,
}

// ---- Settings, admin edition (see docs/features/device-security.md at the repository root) ----

export struct SecurityItem {
    desk_id: string,        // formatted desk ID; also the argument of every security callback
    name: string,           // relay alias or reported device name ("" when it never connected)
    admin: bool,
    enrolled: bool,         // holds its token
    enrolled_at: string,    // local date and time, "" while not enrolled
    online: bool,
}
