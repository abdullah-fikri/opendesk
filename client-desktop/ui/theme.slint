// Colors, sizes and stroke icons shared by every view: the OpenDesk redesign's palette in light and dark.
// `Theme.appearance` picks light, dark or the system's choice; `dark` follows it and switches every token at
// once (Rust sets the appearance from config.json at start; the Appearance control changes it and calls
// `save_appearance`).

import { Palette } from "std-widgets.slint";

export global Theme {
    // 0 = follow the system (the default), 1 = light, 2 = dark.
    in-out property <int> appearance: 0;
    // The system's setting. Slint's report by default; on Windows Rust sets it from the registry and keeps it
    // current, since Slint's (winit's) reading there can be wrong.
    in property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    out property <bool> dark: appearance == 2 || (appearance == 0 && system-dark);

    // ---- Redesign tokens
    out property <color> bg: dark ? #242424 : #F6F5F2;
    out property <color> side: dark ? #2B2B2B : #ECEAE6;
    out property <color> surf: dark ? #333333 : #FFFFFF;
    out property <color> surf2: dark ? #303030 : #F0EFEB;
    out property <color> elev: dark ? #3A3A3A : #FFFFFF;
    out property <color> card-hover: dark ? #383838 : #FFFFFF;
    out property <color> line: dark ? #ffffff17 : #00000014;
    out property <color> hover-soft: dark ? #ffffff0f : #0000000a;
    out property <color> hover2: dark ? #424242 : #00000017;
    out property <color> field: dark ? #ffffff14 : #0000000e;
    out property <color> segon: dark ? #4A4A4A : #FFFFFF;
    out property <color> inp: dark ? #252525 : #0000000e;
    out property <color> accent-line: dark ? #F0445280 : #F0445299;
    out property <color> accent-tx: dark ? #FF7A85 : #C92A3A;
    out property <color> accent-mark: dark ? #EC4A57 : #F04452;
    out property <color> focus: dark ? #5B9BF0 : #2F7BF0;
    out property <color> ring: dark ? #5B9BF066 : #2F7BF04d;
    out property <color> blue: dark ? #5B9BF0 : #2F6FD6;
    out property <color> blue-soft: dark ? #5B9BF024 : #2F7BF01a;
    out property <color> green: dark ? #4FB587 : #1F9D64;
    out property <color> amber: dark ? #D9A850 : #A8691A;
    out property <color> amber-soft: dark ? #D9A85024 : #A8691A1a;
    out property <color> purple: dark ? #9D8BE0 : #7C5CE0;
    out property <color> cyan: dark ? #5CB6C6 : #1E9DB3;
    out property <color> scrim: dark ? #00000066 : #00000047;
    out property <color> tog-off: dark ? #ffffff33 : #00000033;
    out property <color> wallbg: dark ? #1C1C1C : #E6E4E0;
    out property <color> wallbar: dark ? #262626 : #F2F0ED;
    out property <color> emptyslot: dark ? #ffffff0a : #0000000b;
    // Card shadow ("--shadow") and popover shadow ("--pop").
    out property <color> shadow: dark ? #00000059 : #00000017;
    out property <length> shadow-blur: dark ? 10px : 14px;
    out property <color> card-edge: dark ? #ffffff12 : transparent;
    out property <color> pop-shadow: dark ? #00000080 : #00000040;
    out property <color> pop-edge: dark ? #ffffff1a : #0000000f;
    // Window buttons (min / max / close), drawn by the app on its frameless window.
    out property <color> close-hover: #C42B1C;

    // ---- Names the views used before the redesign, mapped onto the new palette
    out property <color> canvas: dark ? #161616 : #DCDAD6;
    out property <color> bar: side;
    out property <color> surface: surf;
    out property <color> surface-2: surf2;
    out property <color> raised: elev;
    out property <color> input: inp;
    out property <color> hover: hover2;
    out property <color> divider: line;
    out property <color> border: dark ? #ffffff21 : #0000001c;
    out property <color> text: dark ? #F5F5F5 : #1D1D1F;
    out property <color> text-2: dark ? #B0B0B0 : #5F5F66;
    out property <color> text-3: dark ? #8F8F8F : #74747B;
    // Primary fill (buttons, switches); `accent-mark` is the brighter red of marks and icons.
    out property <color> accent: dark ? #D63342 : #DB3141;
    out property <color> accent-hover: dark ? #E5424F : #C8283A;
    out property <color> accent-soft: dark ? #F0445226 : #F044521a;
    out property <color> ok: green;
    out property <color> relay: blue;
    out property <color> wait: amber;
    // Text on an accent-soft or red-tinted surface.
    out property <color> danger-text: accent-tx;

    // Shared sizes
    out property <length> radius-sm: 7px;
    out property <length> radius-md: 9px;
    out property <length> radius-lg: 12px;
    out property <length> control-h: 28px;
    out property <length> font-ui: 12px;
    // Device IDs: JetBrains Mono, bundled in ui/fonts (the text face, Inter, is the window's default font).
    out property <string> mono: "JetBrains Mono";

    // Status colour for a session: amber while connecting, green on P2P, blue through the relay.
    public pure function session-dot(connecting: bool, path: string) -> color {
        if (connecting) {
            return self.wait;
        }
        return path == "P2P" ? self.ok : self.relay;
    }
}

// Stroke icons (12x12 viewbox) drawn with Path so they never depend on font glyph coverage.
export global Icons {
    out property <string> close: "M2.5 2.5 L9.5 9.5 M9.5 2.5 L2.5 9.5";
    out property <string> caret: "M3 4.5 L6 7.5 L9 4.5";
    out property <string> chevron-up: "M2 8 L6 4 L10 8";
    out property <string> chevron-down: "M2 4 L6 8 L10 4";
    out property <string> plus: "M6 1 L6 11 M1 6 L11 6";
    out property <string> arrow-up: "M6 11 L6 1.5 M2 5.5 L6 1.5 L10 5.5";
    out property <string> arrow-down: "M6 1 L6 10.5 M2 6.5 L6 10.5 L10 6.5";
    out property <string> fullscreen: "M1 4.5 L1 1 L4.5 1 M7.5 1 L11 1 L11 4.5 M11 7.5 L11 11 L7.5 11 M4.5 11 L1 11 L1 7.5";
    out property <string> fullscreen-exit: "M4.5 1 L4.5 4.5 L1 4.5 M7.5 1 L7.5 4.5 L11 4.5 M11 7.5 L7.5 7.5 L7.5 11 M1 7.5 L4.5 7.5 L4.5 11";
    out property <string> search: "M5 1.5 A3.5 3.5 0 1 0 5 8.5 A3.5 3.5 0 1 0 5 1.5 M7.6 7.6 L10.5 10.5";
    out property <string> clock: "M6 1 A5 5 0 1 0 6 11 A5 5 0 1 0 6 1 M6 3.5 L6 6 L8 7.5";
    out property <string> server: "M1.5 1.5 L10.5 1.5 L10.5 5.5 L1.5 5.5 Z M1.5 6.5 L10.5 6.5 L10.5 10.5 L1.5 10.5 Z M3.5 3.5 L5 3.5 M3.5 8.5 L5 8.5";
    out property <string> grid: "M1 1 L5 1 L5 5 L1 5 Z M7 1 L11 1 L11 5 L7 5 Z M1 7 L5 7 L5 11 L1 11 Z M7 7 L11 7 L11 11 L7 11 Z";
    // Sliders: the Settings button.
    out property <string> settings: "M1.5 3.5 L10.5 3.5 M1.5 8.5 L10.5 8.5 M4 1.5 L4 5.5 M8 6.5 L8 10.5";
    out property <string> back: "M11 6 L1.5 6 M5.5 2 L1.5 6 L5.5 10";
    // Opens another view or window.
    out property <string> external: "M5 2 L2 2 L2 10 L10 10 L10 7 M7 2 L10 2 L10 5 M10 2 L5.5 6.5";
}

// The OpenDesk logo for the 28 px slots, in the variant of the current theme: on light surfaces its white ribbon
// is darkened to slate so it does not vanish. Rust replaces both with ui/logo-*.png scaled down (Lanczos) to the
// exact physical size, since the GPU renderer scales big images down without smoothing.
export global Brand {
    in property <image> logo-light: @image-url("logo-light.png");
    in property <image> logo-dark: @image-url("logo-dark.png");
    out property <image> logo: Theme.dark ? logo-dark : logo-light;
}
