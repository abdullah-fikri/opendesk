// Monitor wall (admin edition, docs/features/monitor-wall.md): a read-only grid of hosts' screens, paged
// 4, 9 or 16 at a time, with optional automatic page rotation. Only the visible page is streamed.
// The toolbar keeps only navigation; layout, rotation and the device list live in the settings panel.
// Full screen hides every control, like a CCTV wall (Esc or the corner button leaves it).

import { MonitorTile, MonitorPick } from "../../types.slint";
import { Theme, Icons } from "../../theme.slint";
import { Segment } from "../../components/segment.slint";
import { ToolButton } from "../../components/tool_button.slint";
import { MenuCaption } from "../../components/menu.slint";
import { Icon } from "../../components/icon.slint";
import { MonitorTileView } from "monitor_tile.slint";
import { MonitorPicker } from "monitor_picker.slint";

export component MonitorWallView inherits Rectangle {
    in property <[MonitorTile]> tiles;
    in property <[MonitorPick]> picks;
    in property <int> grid: 3;
    in property <int> page: 0;
    in property <int> pages: 1;
    in property <int> total: 0;
    in property <bool> rotate: false;
    in property <int> rotate_secs: 10;
    in property <bool> all: true;
    in property <bool> relay_ok: true;
    // Window full-screen state; while set the wall shows tiles only.
    in-out property <bool> fullscreen: false;

    callback close();
    callback connect(string);
    callback step_page(int);
    callback set_grid(int);
    callback set_rotation(bool, int);
    callback set_all(bool);
    callback toggle_host(string);

    property <bool> show_settings: false;
    property <int> cols: max(2, min(4, grid));
    property <length> gap: root.fullscreen ? 2px : 4px;

    background: root.fullscreen ? #000000 : Theme.bg;

    // Esc leaves full screen; arrow keys turn pages.
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape && root.fullscreen) {
                root.fullscreen = false;
                return accept;
            }
            if (e.text == Key.LeftArrow && root.pages > 1) {
                root.step_page(-1);
                return accept;
            }
            if (e.text == Key.RightArrow && root.pages > 1) {
                root.step_page(1);
                return accept;
            }
            reject
        }
    }

    changed fullscreen => {
        root.show_settings = false;
        keys.focus();
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ---- Toolbar: navigation only
        if !root.fullscreen: Rectangle {
            height: 38px;
            background: #0c0c0f;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 10px;

                Segment {
                    width: 60px;
                    horizontal-stretch: 0;
                    label: "Back";
                    clicked => { root.close(); }
                }
                Text {
                    text: "Monitor wall · " + root.total + (root.total == 1 ? " device" : " devices") + " · view only"
                        + (root.rotate ? " · next page every " + root.rotate_secs + " s" : "");
                    color: Theme.text-2;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }

                // Pages
                if root.pages > 1: HorizontalLayout {
                    spacing: 0px;
                    horizontal-stretch: 0;
                    Segment { width: 26px; label: "‹"; clicked => { root.step_page(-1); } }
                    Rectangle {
                        width: 64px;
                        background: Theme.surface-2;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: "Page " + (root.page + 1) + "/" + root.pages;
                            color: Theme.text-2;
                            font-size: 11px;
                        }
                    }
                    Segment { width: 26px; label: "›"; clicked => { root.step_page(1); } }
                }

                ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.fullscreen;
                    label: "Full screen";
                    tip: "Show only the screens (Esc to leave)";
                    clicked => { root.fullscreen = true; }
                }
                ToolButton {
                    y: (parent.height - self.height) / 2;
                    label: "Settings";
                    active: root.show_settings;
                    tip: "Layout, page rotation and devices on the wall";
                    clicked => { root.show_settings = !root.show_settings; }
                }
            }
        }

        // ---- Tiles and the settings panel
        HorizontalLayout {
            vertical-stretch: 1;
            padding: root.fullscreen ? 0px : 6px;
            spacing: 6px;

            area := Rectangle {
                horizontal-stretch: 1;

                for t[i] in root.tiles: MonitorTileView {
                    property <length> w: (area.width - (root.cols - 1) * root.gap) / root.cols;
                    property <length> h: (area.height - (root.cols - 1) * root.gap) / root.cols;
                    x: Math.mod(i, root.cols) * (self.w + root.gap);
                    y: Math.floor(i / root.cols) * (self.h + root.gap);
                    width: self.w;
                    height: self.h;
                    tile: t;
                    connect(id) => {
                        root.fullscreen = false;
                        root.connect(id);
                    }
                }

                if root.tiles.length == 0: Text {
                    width: parent.width;
                    text: !root.relay_ok ? "This relay does not support the monitor wall. Update the relay to use it."
                        : root.all ? "No device is online." : "No device selected. Open Settings to pick some.";
                    color: Theme.text-3;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.show_settings && !root.fullscreen: Rectangle {
                width: 260px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;
                    Rectangle {
                        height: 2px;
                        background: Theme.accent;
                    }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            Text {
                                horizontal-stretch: 1;
                                text: "Wall settings";
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                background: close-ta.has-hover ? Theme.hover : transparent;
                                close-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show_settings = false; }
                                }
                                Icon {
                                    size: 10px;
                                    commands: Icons.close;
                                    tint: Theme.text-2;
                                }
                            }
                        }

                        MenuCaption { text: "LAYOUT"; }
                        HorizontalLayout {
                            spacing: 0px;
                            Segment { label: "2×2"; selected: root.cols == 2; clicked => { root.set_grid(2); } }
                            Segment { label: "3×3"; selected: root.cols == 3; clicked => { root.set_grid(3); } }
                            Segment { label: "4×4"; selected: root.cols == 4; clicked => { root.set_grid(4); } }
                        }

                        MenuCaption { text: "NEXT PAGE AUTOMATICALLY"; }
                        HorizontalLayout {
                            spacing: 0px;
                            Segment { label: "Off"; selected: !root.rotate; clicked => { root.set_rotation(false, root.rotate_secs); } }
                            for secs in [5, 10, 30, 60]: Segment {
                                label: secs + "s";
                                selected: root.rotate && root.rotate_secs == secs;
                                clicked => { root.set_rotation(true, secs); }
                            }
                        }

                        Rectangle { height: 2px; }
                        MonitorPicker {
                            vertical-stretch: 1;
                            border-width: 0px;
                            background: transparent;
                            picks: root.picks;
                            all: root.all;
                            set_all(a) => { root.set_all(a); }
                            toggle_host(id) => { root.toggle_host(id); }
                        }
                    }
                }
            }
        }

        if !root.relay_ok && root.tiles.length > 0 && !root.fullscreen: Rectangle {
            height: 24px;
            background: Theme.accent-soft;
            Text {
                text: "This relay does not support the monitor wall. Update the relay to use it.";
                color: #fca5a5;
                font-size: 11px;
            }
        }
    }

    // ---- Full screen: a faint corner control that brightens on hover
    if root.fullscreen: Rectangle {
        x: parent.width - self.width - 10px;
        y: 10px;
        width: exit-row.preferred-width + 20px;
        height: 28px;
        background: exit-ta.has-hover ? #000000d0 : #00000060;
        border-width: 1px;
        border-color: exit-ta.has-hover ? Theme.border : transparent;
        opacity: exit-ta.has-hover ? 1.0 : 0.35;
        animate opacity { duration: 150ms; }
        exit-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.fullscreen = false; }
        }
        exit-row := HorizontalLayout {
            x: 10px;
            spacing: 8px;
            if root.pages > 1: Text {
                text: (root.page + 1) + "/" + root.pages;
                color: Theme.text-2;
                font-size: 11px;
                vertical-alignment: center;
            }
            Icon {
                y: (parent.height - self.height) / 2;
                commands: Icons.fullscreen-exit;
                tint: #e4e4e7;
            }
            Text {
                text: "Exit full screen";
                color: #e4e4e7;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}
