// Monitor wall (admin edition, docs/features/monitor-wall.md): a read-only grid of hosts' screens, paged
// 4, 9 or 16 at a time, with optional automatic page rotation. Only the visible page is streamed.

import { MonitorTile, MonitorPick } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { Segment } from "../../components/segment.slint";
import { MonitorTileView } from "monitor_tile.slint";
import { MonitorPicker } from "monitor_picker.slint";

export component MonitorWallView inherits Rectangle {
    in property <[MonitorTile]> tiles;
    in property <[MonitorPick]> picks;
    in property <int> grid: 3;
    in property <int> page: 0;
    in property <int> pages: 1;
    in property <int> total: 0;
    in property <bool> rotate: false;
    in property <int> rotate_secs: 10;
    in property <bool> all: true;
    in property <bool> relay_ok: true;

    callback close();
    callback connect(string);
    callback step_page(int);
    callback set_grid(int);
    callback set_rotation(bool, int);
    callback set_all(bool);
    callback toggle_host(string);

    property <bool> show_picker: false;
    property <int> cols: max(2, min(4, grid));

    background: Theme.bg;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ---- Toolbar
        Rectangle {
            height: 38px;
            background: #0c0c0f;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 10px;

                Segment {
                    width: 60px;
                    horizontal-stretch: 0;
                    label: "Back";
                    clicked => { root.close(); }
                }
                Text {
                    text: "Monitor wall · " + root.total + (root.total == 1 ? " device" : " devices") + " · view only";
                    color: Theme.text-2;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }

                // Grid size
                HorizontalLayout {
                    spacing: 0px;
                    horizontal-stretch: 0;
                    Segment { width: 38px; label: "2×2"; selected: root.cols == 2; clicked => { root.set_grid(2); } }
                    Segment { width: 38px; label: "3×3"; selected: root.cols == 3; clicked => { root.set_grid(3); } }
                    Segment { width: 38px; label: "4×4"; selected: root.cols == 4; clicked => { root.set_grid(4); } }
                }

                // Pages
                HorizontalLayout {
                    spacing: 0px;
                    horizontal-stretch: 0;
                    Segment { width: 26px; label: "‹"; enabled: root.pages > 1; clicked => { root.step_page(-1); } }
                    Rectangle {
                        width: 64px;
                        background: Theme.surface-2;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: "Page " + (root.page + 1) + "/" + root.pages;
                            color: Theme.text-2;
                            font-size: 11px;
                        }
                    }
                    Segment { width: 26px; label: "›"; enabled: root.pages > 1; clicked => { root.step_page(1); } }
                }

                // Automatic rotation
                HorizontalLayout {
                    spacing: 0px;
                    horizontal-stretch: 0;
                    Segment { width: 40px; label: "Off"; selected: !root.rotate; clicked => { root.set_rotation(false, root.rotate_secs); } }
                    for secs in [5, 10, 30, 60]: Segment {
                        width: 40px;
                        label: secs + "s";
                        selected: root.rotate && root.rotate_secs == secs;
                        clicked => { root.set_rotation(true, secs); }
                    }
                }

                Segment {
                    width: 70px;
                    horizontal-stretch: 0;
                    label: "Devices";
                    selected: root.show_picker;
                    clicked => { root.show_picker = !root.show_picker; }
                }
            }
        }

        // ---- Tiles and the device picker
        HorizontalLayout {
            vertical-stretch: 1;
            padding: 6px;
            spacing: 6px;

            area := Rectangle {
                horizontal-stretch: 1;

                for t[i] in root.tiles: MonitorTileView {
                    property <length> w: (area.width - (root.cols - 1) * 4px) / root.cols;
                    property <length> h: (area.height - (root.cols - 1) * 4px) / root.cols;
                    x: Math.mod(i, root.cols) * (self.w + 4px);
                    y: Math.floor(i / root.cols) * (self.h + 4px);
                    width: self.w;
                    height: self.h;
                    tile: t;
                    connect(id) => { root.connect(id); }
                }

                if root.tiles.length == 0: Text {
                    width: parent.width;
                    text: !root.relay_ok ? "This relay does not support the monitor wall. Update the relay to use it."
                        : root.all ? "No device is online." : "No device selected. Open \"Devices\" to pick some.";
                    color: Theme.text-3;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.show_picker: MonitorPicker {
                width: 240px;
                picks: root.picks;
                all: root.all;
                set_all(a) => { root.set_all(a); }
                toggle_host(id) => { root.toggle_host(id); }
            }
        }

        if !root.relay_ok && root.tiles.length > 0: Rectangle {
            height: 24px;
            background: Theme.accent-soft;
            Text {
                text: "This relay does not support the monitor wall. Update the relay to use it.";
                color: #fca5a5;
                font-size: 11px;
            }
        }
    }
}
