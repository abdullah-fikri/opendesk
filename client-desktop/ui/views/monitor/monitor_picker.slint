// Device list of the wall settings popover: which hosts the wall shows when "Selected" is on.

import { MonitorPick } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { Glyph } from "../../components/glyph.slint";

export component MonitorPicker inherits Rectangle {
    in property <[MonitorPick]> picks;
    in property <bool> all;
    callback set_all(bool);
    callback toggle_host(string);

    Flickable {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        list := VerticalLayout {
            width: parent.width;
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 8px;
            spacing: 0px;
            alignment: start;
            if root.picks.length == 0: Text {
                height: 40px;
                text: "No devices registered on the relay yet.";
                color: Theme.text-3;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            for p in root.picks: Rectangle {
                height: 30px;
                border-radius: 7px;
                background: row-ta.has-hover ? Theme.hover-soft : transparent;
                row-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        // Picking a device switches to the hand-picked list.
                        if (root.all) {
                            root.set_all(false);
                        }
                        root.toggle_host(p.id);
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 10px;
                    // Checkbox
                    cb := Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 4px;
                        property <bool> on: p.selected && !root.all;
                        background: self.on ? Theme.accent : Theme.surf;
                        border-width: self.on ? 0px : 1px;
                        border-color: Theme.text-3;
                        if cb.on: Glyph {
                            name: "check";
                            size: 11px;
                            tint: #ffffff;
                        }
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: p.online ? Theme.green : transparent;
                        border-width: p.online ? 0px : 1.5px;
                        border-color: Theme.text-3;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: p.name;
                        color: Theme.text;
                        opacity: p.online ? 1.0 : 0.55;
                        font-size: 12.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if !p.online: Text {
                        text: "Offline";
                        color: Theme.text-3;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
