// Home screen ("Devices"): a sidebar (All / Online / Offline relay hosts in the admin edition, Session History),
// a top bar with the search, view mode and page buttons, quick connect with this device's ID, and the devices
// as cards or a list.

import { HistoryItem, HostItem } from "../types.slint";
import { Theme, Brand } from "../theme.slint";
import { ScrollArea } from "../components/scroll_area.slint";
import { Glyph } from "../components/glyph.slint";
import { AppTile } from "../components/app_tile.slint";
import { Btn, Seg, SegWrap, Card, GroupLabel, RowLine, TipBox, AppearancePicker } from "../components/controls.slint";
import { DragArea } from "../components/window_frame.slint";
import { CommunityItem, GroupItem } from "../types.slint";
import { CommunityChip, ActionRow, MenuSeparator, GlassMenu } from "../components/community.slint";

// Sidebar entry: coloured tile, label and an optional count.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> tile;
    in property <string> count;
    in property <bool> active: false;
    // Narrow window: the tile only.
    in property <bool> compact: false;
    callback clicked();

    height: 30px;
    border-radius: 7px;
    background: root.active ? Theme.hover2 : ta.has-hover ? Theme.hover-soft : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.compact ? (root.width - 22px) / 2 : 10px;
        padding-right: 10px;
        spacing: 10px;
        AppTile {
            y: (parent.height - self.height) / 2;
            kind: root.tile;
        }
        if !root.compact: Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.compact && root.count != "": Text {
            text: root.count;
            color: Theme.text-3;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    if root.compact: Tooltip {
        TipBox { text: root.label + (root.count != "" ? "  " + root.count : ""); }
    }
}

// Platform icon on a soft square with the online dot in its corner.
component PlatformTile inherits Rectangle {
    in property <string> platform;
    in property <bool> online: false;
    // History rows: no online state is known, so no dot.
    in property <bool> show_dot: true;
    in property <length> edge: 40px;

    property <string> p: root.platform.to-lowercase();

    width: root.edge;
    height: root.edge;
    border-radius: root.edge * 0.275;
    background: Theme.surf2;

    Glyph {
        name: root.p.starts-with("android") || root.p.starts-with("ios") ? "phone"
            : root.p.starts-with("windows") ? "windows" : "desktop";
        size: root.edge * 0.47;
        tint: Theme.text-2;
        opacity: root.online || !root.show_dot ? 1.0 : 0.62;
    }
    if root.show_dot: Rectangle {
        x: root.edge - 9px - 2.5px;
        y: root.edge - 9px - 2.5px;
        width: 17px;
        height: 17px;
        border-radius: 8.5px;
        background: Theme.surf;
        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.online ? Theme.green : Theme.surf;
            border-width: root.online ? 0px : 1.5px;
            border-color: Theme.text-3;
        }
    }
}

// Section heading: "Online  10".
component SectionHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    in property <bool> muted: false;
    height: 24px;
    spacing: 8px;
    alignment: start;
    Text {
        text: root.title;
        color: root.muted ? Theme.text-2 : Theme.text;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        text: root.count;
        color: Theme.text-3;
        font-size: 13px;
        vertical-alignment: center;
    }
}

// Context menu of a relay host (admin edition): right-click on a card or row, or its "…" button.
component DeviceActions inherits GlassMenu {
    in property <bool> online;
    in property <bool> can_rename;
    in property <bool> can_group;
    in property <bool> in_group;
    in property <string> group_name;
    in property <bool> can_delete;
    callback connect();
    callback rename();
    callback add_to_group();
    callback remove_from_group();
    callback delete();

    width: 220px;
    ActionRow {
        label: "Connect";
        icon: "desktop";
        enabled: root.online;
        clicked => { root.connect(); }
    }
    if root.can_rename: ActionRow {
        label: "Rename…";
        icon: "pencil";
        clicked => { root.rename(); }
    }
    if root.can_group: MenuSeparator { }
    if root.can_group: ActionRow {
        label: "Add to Group…";
        icon: "group";
        clicked => { root.add_to_group(); }
    }
    if root.in_group: ActionRow {
        label: "Remove from “" + root.group_name + "”";
        icon: "minus";
        clicked => { root.remove_from_group(); }
    }
    if root.can_delete: MenuSeparator { }
    if root.can_delete: ActionRow {
        label: "Delete Device…";
        icon: "trash";
        danger: true;
        // Only offline devices can be deleted; the relay refuses online ones too.
        enabled: !root.online;
        hint: root.online ? "Online" : "";
        clicked => { root.delete(); }
    }
}

// One device as a card: platform tile, name and ID; the host details and the Rename / Remove actions appear in
// the bottom row on hover or selection, beside Connect.
component DeviceCard inherits Rectangle {
    in property <string> name;
    in property <string> desk_id;
    in property <string> detail;
    in property <string> platform;
    in property <bool> online: true;
    in property <bool> history: false;
    in property <bool> selected: false;
    in property <bool> can_rename: false;
    // Admin host list: the context menu (right-click or "…") with the group and delete actions.
    in property <bool> admin_menu: false;
    in property <bool> can_group: false;
    in property <bool> in_group: false;
    in property <string> group_name;
    in property <bool> can_delete: false;
    callback select();
    callback connect();
    callback rename();
    callback remove();
    callback add_to_group();
    callback remove_from_group();
    callback delete();

    property <bool> dim: !root.online && !root.history;
    property <bool> hot: ta.has-hover || root.selected;
    property <length> menu_x;
    property <length> menu_y;

    function open_menu(x: length, y: length) {
        root.menu_x = x;
        root.menu_y = y;
        root.select();
        menu.show();
    }

    border-radius: 12px;
    background: root.hot ? Theme.card-hover : Theme.surf;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: Theme.shadow;
    border-width: root.selected ? 1.5px : Theme.dark ? 0.5px : 0px;
    border-color: root.selected ? Theme.accent-line : Theme.card-edge;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(); }
        double-clicked => {
            if (!root.dim) {
                root.connect();
            }
        }
        pointer-event(e) => {
            if (root.admin_menu && e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.open_menu(self.mouse-x, self.mouse-y);
            }
        }
    }

    menu := PopupWindow {
        x: root.menu_x;
        y: root.menu_y;
        DeviceActions {
            online: root.online;
            can_rename: root.can_rename;
            can_group: root.can_group;
            in_group: root.in_group;
            group_name: root.group_name;
            can_delete: root.can_delete;
            connect => { root.connect(); }
            rename => { root.rename(); }
            add_to_group => { root.add_to_group(); }
            remove_from_group => { root.remove_from_group(); }
            delete => { root.delete(); }
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            height: 40px;
            PlatformTile {
                platform: root.platform;
                online: root.online;
                show_dot: !root.history;
                opacity: root.dim ? 0.62 : 1.0;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                opacity: root.dim ? 0.62 : 1.0;
                Text {
                    text: root.name;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.desk_id;
                    color: Theme.text-2;
                    font-size: 12px;
                    font-family: Theme.mono;
                    overflow: elide;
                }
            }
        }
        HorizontalLayout {
            height: 26px;
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.detail;
                visible: root.hot;
                color: Theme.text-2;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.history && root.hot: Btn {
                height: 26px;
                kind: "ghost";
                icon: "trash";
                icon-size: 13px;
                tip: "Remove from history";
                clicked => { root.remove(); }
            }
            if root.can_rename && root.hot: Btn {
                height: 26px;
                kind: "ghost";
                icon: "pencil";
                icon-size: 13px;
                tip: "Rename";
                clicked => { root.rename(); }
            }
            if root.admin_menu && root.hot: more := Btn {
                height: 26px;
                kind: "ghost";
                icon: "more";
                icon-size: 14px;
                tip: "More";
                // Below the button: card padding 16 px, then the 40 px header and 12 px spacing above this row.
                clicked => { root.open_menu(16px + self.x, 16px + 40px + 12px + self.height + 4px); }
            }
            Btn {
                height: 26px;
                label: "Connect";
                kind: root.dim ? "default" : root.selected ? "acc" : "tint";
                enabled: !root.dim;
                clicked => { root.connect(); }
            }
        }
    }
}

// One device as a list row (56px): name | device ID | host details | actions. Every column has its own
// place, so the actions that appear on hover or selection never squeeze the details.
component DeviceRow inherits Rectangle {
    in property <string> name;
    in property <string> desk_id;
    in property <string> detail;
    in property <string> platform;
    in property <bool> online: true;
    in property <bool> history: false;
    in property <bool> selected: false;
    in property <bool> can_rename: false;
    in property <bool> narrow: false;
    in property <bool> first: false;
    in property <bool> admin_menu: false;
    in property <bool> can_group: false;
    in property <bool> in_group: false;
    in property <string> group_name;
    in property <bool> can_delete: false;
    callback select();
    callback connect();
    callback rename();
    callback remove();
    callback add_to_group();
    callback remove_from_group();
    callback delete();

    property <bool> dim: !root.online && !root.history;
    property <bool> hot: ta.has-hover || root.selected;
    property <length> menu_x;
    property <length> menu_y;

    function open_menu(x: length, y: length) {
        root.menu_x = x;
        root.menu_y = y;
        root.select();
        menu.show();
    }

    height: 56px;
    background: root.selected ? Theme.accent-soft : ta.has-hover ? Theme.hover-soft : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(); }
        double-clicked => {
            if (!root.dim) {
                root.connect();
            }
        }
        pointer-event(e) => {
            if (root.admin_menu && e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.open_menu(self.mouse-x, self.mouse-y);
            }
        }
    }

    menu := PopupWindow {
        x: root.menu_x;
        y: root.menu_y;
        DeviceActions {
            online: root.online;
            can_rename: root.can_rename;
            can_group: root.can_group;
            in_group: root.in_group;
            group_name: root.group_name;
            can_delete: root.can_delete;
            connect => { root.connect(); }
            rename => { root.rename(); }
            add_to_group => { root.add_to_group(); }
            remove_from_group => { root.remove_from_group(); }
            delete => { root.delete(); }
        }
    }
    if !root.first: Rectangle {
        x: 64px;
        y: 0;
        width: root.width - 64px;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 16px;

        PlatformTile {
            y: (parent.height - self.height) / 2;
            edge: 32px;
            platform: root.platform;
            online: root.online;
            show_dot: !root.history;
            opacity: root.dim ? 0.62 : 1.0;
        }
        // Name
        Text {
            // Same base width in every row, so the columns line up.
            horizontal-stretch: 1;
            min-width: 120px;
            preferred-width: 120px;
            text: root.name;
            color: Theme.text;
            opacity: root.dim ? 0.62 : 1.0;
            font-size: 13.5px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        // Device ID
        Text {
            width: 112px;
            text: root.desk_id;
            color: Theme.text-2;
            opacity: root.dim ? 0.62 : 1.0;
            font-size: 12.5px;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
        // No status column: the section heading (Online / Offline) and the dot on the platform tile show it.
        // Host details: the widest column
        if !root.narrow: Text {
            horizontal-stretch: 1.6;
            min-width: 80px;
            preferred-width: 80px;
            text: root.detail;
            color: root.dim ? Theme.text-3 : Theme.text-2;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        // Actions: a fixed slot, filled on hover or selection
        HorizontalLayout {
            width: root.admin_menu ? 216px : 180px;
            spacing: 4px;
            alignment: end;
            if root.history && root.hot: Btn {
                y: (parent.height - self.height) / 2;
                height: 28px;
                kind: "ghost";
                icon: "trash";
                icon-size: 13px;
                tip: "Remove from history";
                clicked => { root.remove(); }
            }
            if root.can_rename && root.hot: Btn {
                y: (parent.height - self.height) / 2;
                height: 28px;
                kind: "ghost";
                icon: "pencil";
                icon-size: 13px;
                label: "Rename";
                clicked => { root.rename(); }
            }
            if root.admin_menu && root.hot: Btn {
                y: (parent.height - self.height) / 2;
                height: 28px;
                kind: "ghost";
                icon: "more";
                tip: "More";
                // Below the button, right-aligned with it (the actions slot ends 12 px from the row's edge).
                clicked => { root.open_menu(root.width - 12px - 220px, root.height - 8px); }
            }
            Btn {
                y: (parent.height - self.height) / 2;
                height: 28px;
                label: "Connect";
                kind: root.dim ? "default" : root.selected ? "acc" : "tint";
                enabled: !root.dim;
                clicked => { root.connect(); }
            }
        }
    }
}

// Sidebar entry of a community: its tile, name, count and (several communities) the chevron of the picker.
component CommunityNavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> hue;
    in property <string> count;
    in property <bool> active: false;
    in property <bool> compact: false;
    in property <bool> chevron: false;
    callback clicked();

    height: 30px;
    border-radius: 7px;
    background: root.active ? Theme.hover2 : ta.has-hover ? Theme.hover-soft : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.compact ? (root.width - 22px) / 2 : 10px;
        padding-right: 10px;
        spacing: 10px;
        CommunityChip {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            hue: root.hue;
        }
        if !root.compact: Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.compact && root.count != "": Text {
            text: root.count;
            color: Theme.text-3;
            font-size: 12px;
            vertical-alignment: center;
        }
        if !root.compact && root.chevron: Glyph {
            y: (parent.height - self.height) / 2;
            name: "chevron-right";
            size: 10px;
            tint: Theme.text-3;
        }
    }
    if root.compact: Tooltip {
        TipBox { text: root.label; }
    }
}

// One community in the cascading picker: tile, name, online / total devices, a check on the open one.
component CommunityMenuRow inherits Rectangle {
    in property <CommunityItem> item;
    in property <bool> current: false;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.hover2 : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 9px;
        CommunityChip {
            y: (parent.height - self.height) / 2;
            edge: 20px;
            icon: root.item.icon;
            hue: root.item.color;
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.name;
            color: Theme.text;
            font-size: 13px;
            font-weight: root.current ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.item.online + "/" + root.item.total;
            color: Theme.text-3;
            font-size: 11.5px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 12px;
            if root.current: Glyph {
                name: "check";
                size: 11px;
                tint: Theme.text-2;
            }
        }
    }
}

// The cascading community picker (several communities): a glass panel beside the sidebar entry.
component CommunityPicker inherits GlassMenu {
    in property <[CommunityItem]> communities;
    in property <string> current;
    callback pick(string);
    callback create();
    callback manage();

    width: 260px;
    Text {
        height: 24px;
        x: 10px;
        text: "Communities";
        color: Theme.text-3;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }
    for c in root.communities: CommunityMenuRow {
        item: c;
        current: c.id == root.current;
        clicked => { root.pick(c.id); }
    }
    MenuSeparator { }
    ActionRow {
        label: "New Community…";
        icon: "plus";
        clicked => { root.create(); }
    }
    ActionRow {
        label: "Manage Communities…";
        icon: "sliders";
        clicked => { root.manage(); }
    }
}

// One group in the group column: name and online / total devices; right-click for rename and delete.
component GroupRow inherits Rectangle {
    in property <GroupItem> item;
    in property <bool> active: false;
    in property <bool> compact: false;
    callback clicked();
    callback rename();
    callback delete();

    property <length> menu_x;
    property <length> menu_y;

    height: 30px;
    border-radius: 7px;
    background: root.active ? Theme.hover2 : ta.has-hover ? Theme.hover-soft : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            // "All Members" (no ID) cannot be renamed or deleted.
            if (root.item.id != "" && e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu_x = self.mouse-x;
                root.menu_y = self.mouse-y;
                menu.show();
            }
        }
    }
    menu := PopupWindow {
        x: root.menu_x;
        y: root.menu_y;
        GlassMenu {
            width: 200px;
            ActionRow {
                label: "Rename Group…";
                icon: "pencil";
                clicked => { root.rename(); }
            }
            MenuSeparator { }
            ActionRow {
                label: "Delete Group…";
                icon: "trash";
                danger: true;
                clicked => { root.delete(); }
            }
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Glyph {
            y: (parent.height - self.height) / 2;
            name: root.item.id == "" ? "grid" : "group";
            size: 14px;
            tint: root.active ? Theme.text : Theme.text-2;
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.name;
            color: Theme.text;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        // Online first, like the sidebar counts: "3/8".
        Text {
            text: root.item.total == 0 ? "" : root.item.online + "/" + root.item.total;
            color: Theme.text-3;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// Second sidebar column of an open community (Slack-like): the community's name with its actions, then its
// groups with counts and "New Group".
component GroupColumn inherits Rectangle {
    in property <string> name;
    in property <string> icon;
    in property <string> hue;
    in property <[GroupItem]> groups;
    in property <string> active_group;
    callback select(string);
    callback new_group();
    callback rename_group(string, string);
    callback delete_group(string, string);
    callback edit_community();
    callback delete_community();
    callback manage();

    background: Theme.dark ? #282828 : #F1EFEB;

    // Hairline towards the content.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line;
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 11px;
        padding-bottom: 12px;
        spacing: 2px;

        // Header: the community, with its menu.
        Rectangle {
            height: 52px;
            DragArea { }
            HorizontalLayout {
                padding-left: 6px;
                spacing: 8px;
                CommunityChip {
                    y: (parent.height - self.height) / 2;
                    edge: 24px;
                    icon: root.icon;
                    hue: root.hue;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.name;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                more := Btn {
                    y: (parent.height - self.height) / 2;
                    height: 24px;
                    kind: "ghost";
                    icon: "more";
                    tip: "Community";
                    clicked => { cmenu.show(); }
                }
            }
            cmenu := PopupWindow {
                x: parent.width - 210px;
                y: 42px;
                GlassMenu {
                    width: 210px;
                    ActionRow {
                        label: "Edit Community…";
                        icon: "pencil";
                        clicked => { root.edit_community(); }
                    }
                    ActionRow {
                        label: "New Group…";
                        icon: "plus";
                        clicked => { root.new_group(); }
                    }
                    ActionRow {
                        label: "Manage Members…";
                        icon: "sliders";
                        clicked => { root.manage(); }
                    }
                    MenuSeparator { }
                    ActionRow {
                        label: "Delete Community…";
                        icon: "trash";
                        danger: true;
                        clicked => { root.delete_community(); }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 22px;
            padding-left: 10px;
            GroupLabel {
                horizontal-stretch: 1;
                text: "Groups";
                vertical-alignment: center;
            }
            Btn {
                y: (parent.height - self.height) / 2;
                height: 20px;
                kind: "ghost";
                icon: "plus";
                icon-size: 11px;
                tip: "New Group";
                clicked => { root.new_group(); }
            }
        }
        for g in root.groups: GroupRow {
            item: g;
            active: g.id == root.active_group;
            clicked => { root.select(g.id); }
            rename => { root.rename_group(g.id, g.name); }
            delete => { root.delete_group(g.id, g.name); }
        }
        // Only "All Members": no group yet.
        if root.groups.length <= 1: VerticalLayout {
            padding: 10px;
            spacing: 6px;
            Text {
                text: "Create groups to sort this community's devices, like shops or floors.";
                color: Theme.text-3;
                font-size: 11.5px;
                wrap: word-wrap;
            }
        }
        // Subtle "+ New Group" at the end of the list, like macOS sidebars.
        Rectangle {
            height: 28px;
            border-radius: 7px;
            background: nta.has-hover ? Theme.hover-soft : transparent;
            nta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.new_group(); }
            }
            HorizontalLayout {
                padding-left: 10px;
                spacing: 8px;
                Glyph {
                    y: (parent.height - self.height) / 2;
                    name: "plus";
                    size: 12px;
                    tint: Theme.text-3;
                }
                Text {
                    text: "New Group";
                    color: Theme.text-3;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

// The root is a FocusScope so Ctrl+F reaches the search box wherever focus is on this screen.
export component DashboardView inherits FocusScope {
    width: 100%;
    height: 100%;
    focus-on-click: false;
    focus-on-tab-navigation: false;

    in property <string> local_desk_id: "";
    in property <bool> is_relay_online: false;
    in property <string> status_text: "";
    in property <bool> is_admin: false;
    // Why this device cannot be controlled in this session (Linux on Wayland); empty when it can.
    in property <string> host_notice: "";
    in-out property <int> active_tab: 0; // 0 = session history, 1 = relay hosts (admin)
    // Relay hosts shown: 0 = all, 1 = online, 2 = offline.
    in-out property <int> host_filter: 0;
    in-out property <string> target_desk_id: "";
    // Rows matching the search; the totals count every row.
    in property <[HistoryItem]> history_items: [];
    in property <[HostItem]> hosts_online: [];
    in property <[HostItem]> hosts_offline: [];
    in property <int> history_total: 0;
    in property <int> host_online_total: 0;
    in property <int> host_offline_total: 0;
    // Text in the search box, and the query the lists are currently filtered by ("" = none).
    in-out property <string> search_text: "";
    in property <string> filter_query: "";
    // Desk ID of the selected row ("" = none).
    in-out property <string> selected_id: "";
    // The relay stores names for devices in its host list (admin edition).
    in property <bool> host_alias_supported: false;
    // 0 = cards, 1 = list.
    in-out property <int> view_mode: 0;
    // Settings or the server dialog is open (highlights its button).
    in property <bool> settings_shown: false;

    // ---- Communities (admin edition; see docs/features/communities.md at the repository root)
    // The relay stores communities / can delete offline devices.
    in property <bool> communities_supported: false;
    in property <bool> host_delete_supported: false;
    in property <[CommunityItem]> communities: [];
    // Groups of the open community, "All Members" first.
    in property <[GroupItem]> community_groups: [];
    // The open community and group (active_tab 2). The UI sets them and calls community_view_changed; Rust
    // fills the names and shows the group's devices in hosts_online / hosts_offline.
    in-out property <string> active_community: "";
    in-out property <string> active_group: "";
    in property <string> active_community_name: "";
    in property <string> active_community_icon: "";
    in property <string> active_community_color: "";
    in property <string> active_group_name: "";
    callback community_view_changed();
    // Asks the window to open the name sheet: (SheetKind, target ID, name, icon, color).
    callback open_name_sheet(int, string, string, string, string);
    // Asks the window to confirm a deletion: (kind, target, title, body).
    callback prompt_confirm(string, string, string, string);
    // (desk ID, display name): the "Add to Group" sheet.
    callback open_group_picker(string, string);
    // (group ID, desk ID, member)
    callback set_group_member(string, string, bool);
    // Deletes every offline device the page shows (after a confirmation Rust prepares).
    callback prompt_delete_offline();
    // Settings › Communities.
    callback manage_communities();

    callback copy_local_id();
    callback request_connect(string);
    callback open_rename(string, string);
    // Admin edition: names a device in the relay's host list for every administrator.
    callback open_host_rename(string, string);
    callback prompt_delete_history(string, string);
    callback refresh_hosts();
    callback host_filter_changed();
    // Admin edition: the monitor wall and settings pages; other editions: the relay dialog.
    callback open_monitor();
    callback open_settings();
    callback save_appearance(int);
    // Every keystroke in the search box.
    callback search_edited(string);
    // Arrow keys: move the selection by this many rows.
    callback move_selection(int);
    // Enter: connect to the selected row.
    callback connect_selected();

    // "+" page while viewer sessions are open (multi-session workspace).
    in property <bool> as_new_session_page: false;
    in property <int> open_sessions: 0;
    callback back_to_sessions();

    // Tab 1: the relay's host list; tab 2: one community's group (the same list, filtered by Rust).
    property <bool> hosts_view: root.is_admin && (root.active_tab == 1 || root.active_tab == 2);
    property <bool> community_view: root.is_admin && root.active_tab == 2 && root.active_community != "";
    property <bool> compact_side: root.width < 980px;
    // Width of the content beside the sidebar (and group column) decides the narrow layout.
    property <bool> narrow: root.width - root.side_w - root.groups_w < 620px;
    property <length> side_w: root.compact_side ? 64px : 260px;
    property <length> groups_w: root.community_view ? (root.compact_side ? 180px : 220px) : 0px;
    // Group actions offered on the device cards.
    property <bool> can_group: root.communities_supported && root.communities.length > 0;
    property <bool> in_group_page: root.community_view && root.active_group != "";

    function open_community(id: string) {
        root.active_tab = 2;
        root.active_community = id;
        root.active_group = "";
        root.host_filter = 0;
        root.community_view_changed();
    }

    function delete_host(id: string, name: string) {
        root.prompt_confirm("delete-hosts", id, "Delete “" + name + "”?",
            "It is removed from the device list and from every group. If it connects to this relay again, it shows up again.");
    }
    property <length> pad: root.narrow ? 20px : 40px;
    property <bool> show_online: root.hosts_view && root.host_filter != 2 && root.hosts_online.length > 0;
    property <bool> show_offline: root.hosts_view && root.host_filter != 1 && root.hosts_offline.length > 0;
    property <bool> copied: false;

    // Arrow keys and Enter act on the list without a click first.
    init => { list-keys.focus(); }

    // A switched page shows other rows; the selection belongs to the old ones.
    changed active_tab => { root.selected_id = ""; }
    changed host_filter => { root.selected_id = ""; }

    capture-key-pressed(e) => {
        if (e.modifiers.control && (e.text == "f" || e.text == "F" || e.text == "\u{6}")) {
            search-input.focus();
            search-input.select-all();
            return accept;
        }
        reject
    }

    function select_row(id: string) {
        root.selected_id = id;
        list-keys.focus();
    }

    function clear_search() {
        root.search_text = "";
        root.search_edited("");
    }

    function show_hosts(filter: int) {
        root.active_tab = 1;
        root.host_filter = filter;
        root.host_filter_changed();
        root.refresh_hosts();
    }

    // Keys the list handles even while the search box has focus.
    function list_key(e: KeyEvent) -> EventResult {
        if (e.text == Key.UpArrow) {
            root.move_selection(-1);
            return accept;
        }
        if (e.text == Key.DownArrow) {
            root.move_selection(1);
            return accept;
        }
        if (e.text == Key.Escape && root.search_text != "") {
            root.clear_search();
            return accept;
        }
        reject
    }

    copy-timer := Timer {
        interval: 1600ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // ---- Sidebar
        Rectangle {
            width: root.side_w;
            background: Theme.side;
            VerticalLayout {
                padding-left: root.compact_side ? 8px : 12px;
                padding-right: self.padding-left;
                padding-bottom: 12px;
                spacing: 0px;

                // Brand (also moves the window)
                Rectangle {
                    height: 52px;
                    DragArea { }
                    HorizontalLayout {
                        padding-left: root.compact_side ? 10px : 10px;
                        spacing: 10px;
                        Image {
                            y: (parent.height - self.height) / 2;
                            width: 28px;
                            height: 28px;
                            source: Brand.logo;
                            image-fit: contain;
                        }
                        if !root.compact_side: Text {
                            text: root.is_admin ? "OpenDesk" : "OpenDesk";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.is_admin: VerticalLayout {
                    spacing: 2px;
                    padding-top: 8px;
                    if !root.compact_side: GroupLabel {
                        text: "Devices";
                        height: 19px;
                        x: 10px;
                    }
                    NavItem {
                        compact: root.compact_side;
                        tile: "devices";
                        label: "All Devices";
                        count: root.host_online_total + root.host_offline_total;
                        active: root.is_admin && root.active_tab == 1 && root.host_filter == 0;
                        clicked => { root.show_hosts(0); }
                    }
                    NavItem {
                        compact: root.compact_side;
                        tile: "online";
                        label: "Online";
                        count: root.host_online_total;
                        active: root.is_admin && root.active_tab == 1 && root.host_filter == 1;
                        clicked => { root.show_hosts(1); }
                    }
                    NavItem {
                        compact: root.compact_side;
                        tile: "offline";
                        label: "Offline";
                        count: root.host_offline_total;
                        active: root.is_admin && root.active_tab == 1 && root.host_filter == 2;
                        clicked => { root.show_hosts(2); }
                    }
                }

                // Communities: one is listed directly; several open the cascading picker from one entry.
                if root.is_admin && root.communities_supported: VerticalLayout {
                    spacing: 2px;
                    padding-top: 20px;
                    if !root.compact_side: HorizontalLayout {
                        height: 19px;
                        padding-left: 10px;
                        GroupLabel {
                            horizontal-stretch: 1;
                            text: "Communities";
                            vertical-alignment: center;
                        }
                        if root.communities.length > 0: Btn {
                            y: (parent.height - self.height) / 2;
                            height: 19px;
                            kind: "ghost";
                            icon: "plus";
                            icon-size: 10px;
                            tip: "New Community";
                            clicked => { root.open_name_sheet(1, "", "", "", ""); }
                        }
                    }
                    if root.communities.length == 1: CommunityNavItem {
                        compact: root.compact_side;
                        label: root.communities[0].name;
                        icon: root.communities[0].icon;
                        hue: root.communities[0].color;
                        count: root.communities[0].total;
                        active: root.community_view && root.active_community == root.communities[0].id;
                        clicked => { root.open_community(root.communities[0].id); }
                    }
                    if root.communities.length > 1: Rectangle {
                        height: 30px;
                        CommunityNavItem {
                            width: parent.width;
                            height: parent.height;
                            compact: root.compact_side;
                            label: root.community_view ? root.active_community_name : "Communities";
                            icon: root.community_view ? root.active_community_icon : "";
                            hue: root.community_view ? root.active_community_color : "indigo";
                            count: root.communities.length;
                            chevron: true;
                            active: root.community_view;
                            clicked => { picker.show(); }
                        }
                        picker := PopupWindow {
                            x: parent.width + 6px;
                            y: -34px;
                            CommunityPicker {
                                communities: root.communities;
                                current: root.community_view ? root.active_community : "";
                                pick(id) => { root.open_community(id); }
                                create => { root.open_name_sheet(1, "", "", "", ""); }
                                manage => { root.manage_communities(); }
                            }
                        }
                    }
                    // Subtle affordance while there is none.
                    if root.communities.length == 0: Rectangle {
                        height: 28px;
                        border-radius: 7px;
                        background: nca.has-hover ? Theme.hover-soft : transparent;
                        nca := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open_name_sheet(1, "", "", "", ""); }
                        }
                        HorizontalLayout {
                            padding-left: root.compact_side ? (parent.width - 12px) / 2 : 15px;
                            spacing: 13px;
                            Glyph {
                                y: (parent.height - self.height) / 2;
                                name: "plus";
                                size: 12px;
                                tint: Theme.text-3;
                            }
                            if !root.compact_side: Text {
                                text: "New Community";
                                color: Theme.text-3;
                                font-size: 12.5px;
                                vertical-alignment: center;
                            }
                        }
                        if root.compact_side: Tooltip {
                            TipBox { text: "New Community"; }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    padding-top: root.is_admin ? 20px : 8px;
                    if !root.compact_side: GroupLabel {
                        text: "Workspaces";
                        height: 19px;
                        x: 10px;
                    }
                    NavItem {
                        compact: root.compact_side;
                        tile: "history";
                        label: "Session History";
                        count: root.history_total > 0 ? root.history_total : "";
                        active: !root.hosts_view;
                        clicked => { root.active_tab = 0; }
                    }
                    if root.is_admin && !root.as_new_session_page: NavItem {
                        compact: root.compact_side;
                        tile: "wall";
                        label: "Monitor Wall";
                        clicked => { root.open_monitor(); }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // Appearance
                HorizontalLayout {
                    padding-left: root.compact_side ? 0px : 10px;
                    padding-right: root.compact_side ? 0px : 0px;
                    padding-top: 4px;
                    alignment: root.compact_side ? center : space-between;
                    if !root.compact_side: Text {
                        text: "Appearance";
                        color: Theme.text-2;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    AppearancePicker {
                        compact: root.compact_side;
                        chosen(a) => { root.save_appearance(a); }
                    }
                }
            }
        }

        // ---- Groups of the open community
        if root.community_view: GroupColumn {
            width: root.groups_w;
            name: root.active_community_name;
            icon: root.active_community_icon;
            hue: root.active_community_color;
            groups: root.community_groups;
            active_group: root.active_group;
            select(id) => {
                root.active_group = id;
                root.selected_id = "";
                root.community_view_changed();
            }
            new_group => { root.open_name_sheet(3, root.active_community, "", "", ""); }
            rename_group(id, name) => { root.open_name_sheet(4, id, name, "", ""); }
            delete_group(id, name) => {
                root.prompt_confirm("delete-group", id, "Delete the group “" + name + "”?",
                    "Its devices stay in All Devices and in their other groups.");
            }
            edit_community => {
                root.open_name_sheet(2, root.active_community, root.active_community_name, root.active_community_icon,
                    root.active_community_color);
            }
            delete_community => {
                root.prompt_confirm("delete-community", root.active_community,
                    "Delete the community “" + root.active_community_name + "”?",
                    "Its groups are deleted for every administrator. The devices stay in All Devices.");
            }
            manage => { root.manage_communities(); }
        }

        // ---- Main
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 0px;

            // Top bar: the search centred over the content, view mode, refresh and Settings on the right. The
            // window buttons sit higher, in the top 32 px of the corner, so the bar's controls start below them and
            // keep clear of them on the right.
            top := Rectangle {
                height: 56px;
                property <length> pr: root.as_new_session_page ? 20px : 150px;
                property <length> cy: 20px;
                // Room for a centred search between the right group and its mirror image on the left.
                property <length> room: self.width - 2 * (tools.width + self.pr + 16px);
                DragArea { }

                Rectangle {
                    x: top.room >= 240px ? (parent.width - self.width) / 2 : root.pad;
                    y: top.cy;
                    width: top.room >= 240px ? min(680px, top.room)
                        : max(120px, parent.width - root.pad - tools.width - top.pr - 16px);
                    height: 28px;
                    border-radius: 7px;
                    // `field`, not `inp`: in dark `inp` is the bar's own colour and the box would vanish.
                    background: search-ta.has-hover || search-input.has-focus ? Theme.hover2 : Theme.field;
                    // Focus ring outside the box, like the design's 3 px ring.
                    if search-input.has-focus: Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: 10px;
                        border-width: 3px;
                        border-color: Theme.ring;
                    }
                    // A click anywhere in the box (icon, placeholder) puts the cursor in it.
                    search-ta := TouchArea {
                        mouse-cursor: text;
                        clicked => { search-input.focus(); }
                    }
                    Glyph {
                        x: 9px;
                        name: "search";
                        size: 14px;
                        tint: Theme.text-3;
                    }
                    if root.search_text == "": Text {
                        x: 34px;
                        width: parent.width - 68px;
                        height: parent.height;
                        text: root.hosts_view ? "Search name, ID, device, platform" : "Search name or ID";
                        color: Theme.text-3;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    search-input := TextInput {
                        x: 34px;
                        width: parent.width - 68px;
                        height: parent.height;
                        text <=> root.search_text;
                        color: Theme.text;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        single-line: true;
                        edited => { root.search_edited(self.text); }
                        key-pressed(e) => { root.list_key(e) }
                    }
                    if root.search_text != "": Rectangle {
                        x: parent.width - 26px;
                        y: 3px;
                        width: 22px;
                        height: 22px;
                        border-radius: 6px;
                        background: clear-ta.has-hover ? Theme.hover2 : transparent;
                        clear-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.clear_search();
                                search-input.focus();
                            }
                        }
                        Glyph {
                            name: "close";
                            size: 10px;
                            tint: Theme.text-2;
                        }
                    }
                }

                tools := HorizontalLayout {
                    x: parent.width - self.width - top.pr;
                    y: top.cy;
                    width: self.preferred-width;
                    height: 28px;
                    spacing: 8px;
                    SegWrap {
                        y: (parent.height - self.height) / 2;
                        Seg {
                            icon: "grid";
                            tip: "Card view";
                            selected: root.view_mode == 0;
                            clicked => { root.view_mode = 0; }
                        }
                        Seg {
                            icon: "list";
                            tip: "List view";
                            selected: root.view_mode == 1;
                            clicked => { root.view_mode = 1; }
                        }
                    }
                    if root.hosts_view: Btn {
                        kind: "ghost";
                        icon: "refresh";
                        tip: "Refresh";
                        clicked => { root.refresh_hosts(); }
                    }
                    if !root.as_new_session_page: Rectangle {
                        width: 9px;
                        Rectangle {
                            width: 1px;
                            height: 18px;
                            background: Theme.line;
                        }
                    }
                    if !root.as_new_session_page: Btn {
                        icon: "sliders";
                        label: root.narrow ? "" : root.is_admin ? "Settings" : "Server";
                        tip: root.is_admin ? "Settings" : "Relay server and performance";
                        on: root.settings_shown;
                        clicked => { root.open_settings(); }
                    }
                }
            }

            // Content
            list-keys := FocusScope {
                vertical-stretch: 1;
                capture-key-pressed(e) => { root.list_key(e) }
                key-pressed(e) => {
                    if (e.text == Key.Return && root.selected_id != "") {
                        root.connect_selected();
                        return accept;
                    }
                    root.list_key(e)
                }

                list := ScrollArea {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;
                    reset_key: root.active_tab * 10 + root.host_filter;

                    body := VerticalLayout {
                        padding-left: root.pad;
                        padding-right: root.pad - 10px;
                        padding-top: 8px;
                        padding-bottom: 40px;
                        spacing: 0px;

                        // "+" page: where the new session goes
                        if root.as_new_session_page: HorizontalLayout {
                            height: 30px;
                            spacing: 10px;
                            padding-bottom: 12px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.open_sessions >= 4
                                    ? "4 sessions are open (the maximum). Close a tab to open a new one."
                                    : "The session opens in a new tab (" + root.open_sessions + " of 4 sessions open).";
                                color: root.open_sessions >= 4 ? Theme.accent-tx : Theme.text-2;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Btn {
                                icon: "chevron-left";
                                label: "Back to sessions";
                                clicked => { root.back_to_sessions(); }
                            }
                        }

                        // Title
                        Text {
                            text: !root.hosts_view ? "Session History"
                                : root.community_view ? (root.active_group != "" ? root.active_group_name : root.active_community_name)
                                : root.host_filter == 1 ? "Online" : root.host_filter == 2 ? "Offline" : "All Devices";
                            color: Theme.text;
                            font-size: 28px;
                            font-weight: 700;
                            letter-spacing: -0.5px;
                            overflow: elide;
                        }
                        Text {
                            text: root.community_view
                                ? (root.active_group != "" ? root.active_community_name : "Every device of this community") + " — "
                                    + root.hosts_online.length + " online · " + root.hosts_offline.length + " offline"
                                : root.hosts_view
                                ? root.host_online_total + " online · " + root.host_offline_total + " offline"
                                : root.history_total == 0 ? "Devices you connect to appear here."
                                : root.history_total + (root.history_total == 1 ? " device" : " devices") + " you connected to";
                            color: Theme.text-2;
                            font-size: 13px;
                        }

                        Rectangle { height: 24px; }

                        // Quick connect and this device
                        HorizontalLayout {
                            spacing: 16px;
                            height: root.narrow ? 124px : 62px;

                            if !root.narrow: Card {
                                y: (parent.height - 48px) / 2;
                                height: 48px;
                                horizontal-stretch: 1;
                                max-width: 560px;
                                min-width: 200px;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 6px;
                                    spacing: 10px;
                                    Glyph {
                                        y: (parent.height - self.height) / 2;
                                        name: "search";
                                        size: 18px;
                                        tint: Theme.text-3;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        if target-input.text == "": Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "Enter a device ID to control";
                                            color: Theme.text-3;
                                            font-size: 15px;
                                            font-family: Theme.mono;
                                            letter-spacing: 0.6px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        target-input := TextInput {
                                            text <=> root.target_desk_id;
                                            color: Theme.text;
                                            font-size: 15px;
                                            font-family: Theme.mono;
                                            letter-spacing: 0.6px;
                                            vertical-alignment: center;
                                            single-line: true;
                                            accepted => {
                                                if (self.text != "") {
                                                    root.request_connect(self.text);
                                                }
                                            }
                                        }
                                    }
                                    Btn {
                                        y: (parent.height - self.height) / 2;
                                        kind: "acc";
                                        large: true;
                                        label: "Connect";
                                        enabled: root.target_desk_id != "";
                                        clicked => { root.request_connect(root.target_desk_id); }
                                    }
                                }
                            }
                            if !root.narrow: Rectangle { horizontal-stretch: 0.0001; }

                            // This device
                            if !root.narrow: Card {
                                width: 287px;
                                VerticalLayout {
                                    padding: 8px;
                                    padding-left: 16px;
                                    spacing: 4px;
                                    Text {
                                        text: "This device";
                                        color: Theme.text-2;
                                        font-size: 11px;
                                        font-weight: 600;
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.local_desk_id;
                                            color: Theme.text;
                                            font-size: 16px;
                                            font-weight: 500;
                                            font-family: Theme.mono;
                                            letter-spacing: 0.8px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Btn {
                                            width: 112px;
                                            label: root.copied ? "Copied" : "Copy ID";
                                            icon: root.copied ? "check" : "";
                                            clicked => {
                                                root.copy_local_id();
                                                root.copied = true;
                                            }
                                        }
                                    }
                                }
                            }

                            // Narrow window: stacked
                            if root.narrow: VerticalLayout {
                                spacing: 12px;
                                horizontal-stretch: 1;
                                Card {
                                    height: 48px;
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 6px;
                                        spacing: 10px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            if target-input-n.text == "": Text {
                                                width: parent.width;
                                                height: parent.height;
                                                text: "Enter a device ID to control";
                                                color: Theme.text-3;
                                                font-size: 15px;
                                                font-family: Theme.mono;
                                                letter-spacing: 0.6px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            target-input-n := TextInput {
                                                text <=> root.target_desk_id;
                                                color: Theme.text;
                                                font-size: 15px;
                                                font-family: Theme.mono;
                                                letter-spacing: 0.6px;
                                                vertical-alignment: center;
                                                single-line: true;
                                                accepted => {
                                                    if (self.text != "") {
                                                        root.request_connect(self.text);
                                                    }
                                                }
                                            }
                                        }
                                        Btn {
                                            y: (parent.height - self.height) / 2;
                                            kind: "acc";
                                            large: true;
                                            label: "Connect";
                                            enabled: root.target_desk_id != "";
                                            clicked => { root.request_connect(root.target_desk_id); }
                                        }
                                    }
                                }
                                Card {
                                    height: 52px;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 8px;
                                        spacing: 10px;
                                        Text {
                                            text: "This device";
                                            color: Theme.text-2;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.local_desk_id;
                                            color: Theme.text;
                                            font-size: 15px;
                                            font-weight: 500;
                                            font-family: Theme.mono;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Btn {
                                            y: (parent.height - self.height) / 2;
                                            label: root.copied ? "Copied" : "Copy ID";
                                            clicked => {
                                                root.copy_local_id();
                                                root.copied = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // This device cannot be controlled (Linux on Wayland)
                        if root.host_notice != "": Rectangle {
                            height: 50px;
                            Card {
                                y: 14px;
                                height: 36px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    Glyph {
                                        y: (parent.height - self.height) / 2;
                                        name: "warn";
                                        size: 14px;
                                        tint: Theme.amber;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.host_notice;
                                        color: Theme.text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        // ---- Nothing matches the search
                        if root.filter_query != ""
                            && (root.hosts_view ? (!root.show_online && !root.show_offline) : root.history_items.length == 0)
                            : VerticalLayout {
                            padding-top: 80px;
                            padding-bottom: 80px;
                            spacing: 8px;
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Glyph {
                                    name: "search";
                                    size: 28px;
                                    tint: Theme.text-3;
                                }
                            }
                            Text {
                                text: "No devices found";
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Nothing matches “" + root.filter_query + "”. "
                                    + (root.hosts_view ? "Search by name, ID, device or platform." : "Search by name or ID.");
                                color: Theme.text-2;
                                font-size: 13px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: center;
                                Btn {
                                    kind: "link";
                                    label: "Clear search";
                                    clicked => { root.clear_search(); }
                                }
                            }
                        }

                        // ---- Empty lists (no search)
                        if root.filter_query == ""
                            && (root.hosts_view ? (!root.show_online && !root.show_offline) : root.history_items.length == 0)
                            : VerticalLayout {
                            padding-top: 72px;
                            spacing: 6px;
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                AppTile {
                                    tile: 44px;
                                    kind: root.community_view ? "community"
                                        : root.hosts_view ? (root.host_filter == 2 ? "offline" : "devices") : "history";
                                }
                            }
                            Text {
                                text: !root.hosts_view ? "No sessions yet"
                                    : root.community_view ? (root.active_group != "" ? "No devices in this group" : "No devices in this community yet")
                                    : root.host_filter == 1 ? "No device is online"
                                    : root.host_filter == 2 ? "No device is offline"
                                    : "No devices on this relay yet";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: !root.hosts_view ? "Enter a device ID above to start your first session."
                                    : root.community_view ? "In All Devices, right-click a device and choose Add to Group, or manage the members here."
                                    : "Devices appear here once OpenDesk runs on them with this relay.";
                                color: Theme.text-2;
                                font-size: 12px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            if root.community_view: HorizontalLayout {
                                alignment: center;
                                padding-top: 6px;
                                Btn {
                                    kind: "link";
                                    label: "Manage Members…";
                                    clicked => { root.manage_communities(); }
                                }
                            }
                        }

                        // ---- Relay hosts: online
                        if root.show_online: on-sec := VerticalLayout {
                            padding-top: 32px;
                            spacing: 12px;
                            SectionHead {
                                title: "Online";
                                count: root.hosts_online.length;
                            }
                            if root.view_mode == 0: on-grid := Rectangle {
                                property <int> cols: max(1, min(4, floor((self.width + 16px) / 316px)));
                                property <length> cw: (self.width - (self.cols - 1) * 16px) / self.cols;
                                height: ceil(root.hosts_online.length / self.cols) * 128px - 16px;
                                for h[i] in root.hosts_online: DeviceCard {
                                    x: mod(i, on-grid.cols) * (on-grid.cw + 16px);
                                    y: floor(i / on-grid.cols) * 128px;
                                    changed selected => {
                                        if (self.selected) {
                                            list.reveal(body.y + on-sec.y + on-grid.y + self.y, self.height);
                                        }
                                    }
                                    width: on-grid.cw;
                                    height: 112px;
                                    name: h.alias != "" ? h.alias : h.device_name;
                                    desk_id: h.desk_id;
                                    platform: h.platform;
                                    detail: h.platform + (h.alias != "" ? " · " + h.device_name : "");
                                    online: true;
                                    selected: h.desk_id == root.selected_id;
                                    can_rename: root.host_alias_supported;
                                    select => { root.select_row(h.desk_id); }
                                    connect => { root.request_connect(h.desk_id); }
                                    rename => { root.open_host_rename(h.desk_id, h.alias); }
                                    admin_menu: root.can_group || root.host_delete_supported;
                                    can_group: root.can_group;
                                    in_group: root.in_group_page;
                                    group_name: root.active_group_name;
                                    can_delete: root.host_delete_supported;
                                    add_to_group => { root.open_group_picker(h.desk_id, h.alias != "" ? h.alias : h.device_name); }
                                    remove_from_group => { root.set_group_member(root.active_group, h.desk_id, false); }
                                    delete => { root.delete_host(h.desk_id, h.alias != "" ? h.alias : h.device_name); }
                                }
                            }
                            if root.view_mode == 1: on-list := Card {
                                height: root.hosts_online.length * 56px;
                                clip: true;
                                for h[i] in root.hosts_online: DeviceRow {
                                    y: i * 56px;
                                    changed selected => {
                                        if (self.selected) {
                                            list.reveal(body.y + on-sec.y + on-list.y + self.y, self.height);
                                        }
                                    }
                                    width: parent.width;
                                    first: i == 0;
                                    narrow: root.narrow;
                                    name: h.alias != "" ? h.alias : h.device_name;
                                    desk_id: h.desk_id;
                                    platform: h.platform;
                                    detail: h.platform + (h.alias != "" ? " · " + h.device_name : "");
                                    online: true;
                                    selected: h.desk_id == root.selected_id;
                                    can_rename: root.host_alias_supported;
                                    select => { root.select_row(h.desk_id); }
                                    connect => { root.request_connect(h.desk_id); }
                                    rename => { root.open_host_rename(h.desk_id, h.alias); }
                                    admin_menu: root.can_group || root.host_delete_supported;
                                    can_group: root.can_group;
                                    in_group: root.in_group_page;
                                    group_name: root.active_group_name;
                                    can_delete: root.host_delete_supported;
                                    add_to_group => { root.open_group_picker(h.desk_id, h.alias != "" ? h.alias : h.device_name); }
                                    remove_from_group => { root.set_group_member(root.active_group, h.desk_id, false); }
                                    delete => { root.delete_host(h.desk_id, h.alias != "" ? h.alias : h.device_name); }
                                }
                            }
                        }

                        // ---- Relay hosts: offline
                        if root.show_offline: off-sec := VerticalLayout {
                            padding-top: 32px;
                            spacing: 12px;
                            HorizontalLayout {
                                SectionHead {
                                    horizontal-stretch: 1;
                                    title: "Offline";
                                    count: root.hosts_offline.length;
                                    muted: true;
                                }
                                // Bulk delete of what this section shows (search and group applied).
                                if root.host_delete_supported: Btn {
                                    height: 24px;
                                    kind: "ghost";
                                    icon: "trash";
                                    icon-size: 12px;
                                    label: root.narrow ? "" : "Delete Offline…";
                                    tip: "Delete the offline devices shown here";
                                    clicked => { root.prompt_delete_offline(); }
                                }
                            }
                            if root.view_mode == 0: off-grid := Rectangle {
                                property <int> cols: max(1, min(4, floor((self.width + 16px) / 316px)));
                                property <length> cw: (self.width - (self.cols - 1) * 16px) / self.cols;
                                height: ceil(root.hosts_offline.length / self.cols) * 128px - 16px;
                                for h[i] in root.hosts_offline: DeviceCard {
                                    x: mod(i, off-grid.cols) * (off-grid.cw + 16px);
                                    y: floor(i / off-grid.cols) * 128px;
                                    changed selected => {
                                        if (self.selected) {
                                            list.reveal(body.y + off-sec.y + off-grid.y + self.y, self.height);
                                        }
                                    }
                                    width: off-grid.cw;
                                    height: 112px;
                                    name: h.alias != "" ? h.alias : h.device_name;
                                    desk_id: h.desk_id;
                                    platform: h.platform;
                                    detail: h.platform + (h.alias != "" ? " · " + h.device_name : "") + " · last seen " + h.last_seen;
                                    online: false;
                                    selected: h.desk_id == root.selected_id;
                                    can_rename: root.host_alias_supported;
                                    select => { root.select_row(h.desk_id); }
                                    connect => { root.request_connect(h.desk_id); }
                                    rename => { root.open_host_rename(h.desk_id, h.alias); }
                                    admin_menu: root.can_group || root.host_delete_supported;
                                    can_group: root.can_group;
                                    in_group: root.in_group_page;
                                    group_name: root.active_group_name;
                                    can_delete: root.host_delete_supported;
                                    add_to_group => { root.open_group_picker(h.desk_id, h.alias != "" ? h.alias : h.device_name); }
                                    remove_from_group => { root.set_group_member(root.active_group, h.desk_id, false); }
                                    delete => { root.delete_host(h.desk_id, h.alias != "" ? h.alias : h.device_name); }
                                }
                            }
                            if root.view_mode == 1: off-list := Card {
                                height: root.hosts_offline.length * 56px;
                                clip: true;
                                for h[i] in root.hosts_offline: DeviceRow {
                                    y: i * 56px;
                                    changed selected => {
                                        if (self.selected) {
                                            list.reveal(body.y + off-sec.y + off-list.y + self.y, self.height);
                                        }
                                    }
                                    width: parent.width;
                                    first: i == 0;
                                    narrow: root.narrow;
                                    name: h.alias != "" ? h.alias : h.device_name;
                                    desk_id: h.desk_id;
                                    platform: h.platform;
                                    detail: h.platform + (h.alias != "" ? " · " + h.device_name : "") + " · last seen " + h.last_seen;
                                    online: false;
                                    selected: h.desk_id == root.selected_id;
                                    can_rename: root.host_alias_supported;
                                    select => { root.select_row(h.desk_id); }
                                    connect => { root.request_connect(h.desk_id); }
                                    rename => { root.open_host_rename(h.desk_id, h.alias); }
                                    admin_menu: root.can_group || root.host_delete_supported;
                                    can_group: root.can_group;
                                    in_group: root.in_group_page;
                                    group_name: root.active_group_name;
                                    can_delete: root.host_delete_supported;
                                    add_to_group => { root.open_group_picker(h.desk_id, h.alias != "" ? h.alias : h.device_name); }
                                    remove_from_group => { root.set_group_member(root.active_group, h.desk_id, false); }
                                    delete => { root.delete_host(h.desk_id, h.alias != "" ? h.alias : h.device_name); }
                                }
                            }
                        }

                        // ---- Session history
                        if !root.hosts_view && root.history_items.length > 0: hist-sec := VerticalLayout {
                            padding-top: 32px;
                            spacing: 12px;
                            SectionHead {
                                title: "Recent";
                                count: root.history_items.length;
                            }
                            if root.view_mode == 0: hist-grid := Rectangle {
                                property <int> cols: max(1, min(4, floor((self.width + 16px) / 316px)));
                                property <length> cw: (self.width - (self.cols - 1) * 16px) / self.cols;
                                height: ceil(root.history_items.length / self.cols) * 128px - 16px;
                                for item[i] in root.history_items: DeviceCard {
                                    x: mod(i, hist-grid.cols) * (hist-grid.cw + 16px);
                                    y: floor(i / hist-grid.cols) * 128px;
                                    changed selected => {
                                        if (self.selected) {
                                            list.reveal(body.y + hist-sec.y + hist-grid.y + self.y, self.height);
                                        }
                                    }
                                    width: hist-grid.cw;
                                    height: 112px;
                                    history: true;
                                    name: item.alias != "" ? item.alias : item.desk_id;
                                    desk_id: item.alias != "" ? item.desk_id : "Unnamed device";
                                    platform: "";
                                    detail: "Last connected " + item.last_connected;
                                    selected: item.desk_id == root.selected_id;
                                    can_rename: true;
                                    select => { root.select_row(item.desk_id); }
                                    connect => { root.request_connect(item.desk_id); }
                                    rename => { root.open_rename(item.desk_id, item.alias); }
                                    remove => {
                                        root.prompt_delete_history(item.desk_id,
                                            item.alias != "" ? item.alias + " (" + item.desk_id + ")" : item.desk_id);
                                    }
                                }
                            }
                            if root.view_mode == 1: hist-list := Card {
                                height: root.history_items.length * 56px;
                                clip: true;
                                for item[i] in root.history_items: DeviceRow {
                                    y: i * 56px;
                                    changed selected => {
                                        if (self.selected) {
                                            list.reveal(body.y + hist-sec.y + hist-list.y + self.y, self.height);
                                        }
                                    }
                                    width: parent.width;
                                    first: i == 0;
                                    narrow: root.narrow;
                                    history: true;
                                    name: item.alias != "" ? item.alias : item.desk_id;
                                    desk_id: item.alias != "" ? item.desk_id : "Unnamed device";
                                    platform: "";
                                    detail: "Last connected " + item.last_connected;
                                    selected: item.desk_id == root.selected_id;
                                    can_rename: true;
                                    select => { root.select_row(item.desk_id); }
                                    connect => { root.request_connect(item.desk_id); }
                                    rename => { root.open_rename(item.desk_id, item.alias); }
                                    remove => {
                                        root.prompt_delete_history(item.desk_id,
                                            item.alias != "" ? item.alias + " (" + item.desk_id + ")" : item.desk_id);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
