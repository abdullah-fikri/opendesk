// Home screen: this device's ID, connect form, history and (admin) host list.

import { HistoryItem, HostItem } from "../types.slint";
import { Theme, Icons } from "../theme.slint";
import { ScrollArea } from "../components/scroll_area.slint";
import { ListRow } from "../components/list_row.slint";
import { DashboardTab } from "dashboard_tab.slint";
import { SearchField } from "search_field.slint";

// The root is a FocusScope so Ctrl+F reaches the search box wherever focus is on this screen.
export component DashboardView inherits FocusScope {
    width: 100%;
    height: 100%;
    focus-on-click: false;
    focus-on-tab-navigation: false;

    in property <string> local_desk_id: "";
    in property <bool> is_relay_online: false;
    in property <bool> is_admin: false;
    // Why this device cannot be controlled in this session (Linux on Wayland); empty when it can.
    in property <string> host_notice: "";
    in-out property <int> active_tab: 0; // 0 = session history, 1 = relay hosts (admin)
    in-out property <string> target_desk_id: "";
    // Rows matching the search; the totals count every row.
    in property <[HistoryItem]> history_items: [];
    in property <[HostItem]> server_hosts: [];
    in property <int> history_total: 0;
    in property <int> host_total: 0;
    // Text in the search box, and the query the lists are currently filtered by ("" = none).
    in-out property <string> search_text: "";
    in property <string> filter_query: "";
    // Desk ID of the selected row ("" = none).
    in-out property <string> selected_id: "";
    // The relay stores names for devices in its host list (admin edition).
    in property <bool> host_alias_supported: false;

    callback copy_local_id();
    callback request_connect(string);
    callback open_rename(string, string);
    // Admin edition: names a device in the relay's host list for every administrator.
    callback open_host_rename(string, string);
    callback prompt_delete_history(string, string);
    callback refresh_hosts();
    // Admin edition: show the monitor wall.
    callback open_monitor();
    // Every keystroke in the search box.
    callback search_edited(string);
    // Arrow keys: move the selection by this many rows.
    callback move_selection(int);
    // Enter: connect to the selected row.
    callback connect_selected();

    // "+" page while viewer sessions are open (multi-session workspace).
    in property <bool> as_new_session_page: false;
    in property <int> open_sessions: 0;
    callback back_to_sessions();

    // Arrow keys and Enter act on the list without a click first.
    init => { list-keys.focus(); }

    // A switched tab shows other rows; the selection belongs to the old ones.
    changed active_tab => { root.selected_id = ""; }

    capture-key-pressed(e) => {
        if (e.modifiers.control && (e.text == "f" || e.text == "F" || e.text == "\u{6}")) {
            search.focus-input();
            return accept;
        }
        reject
    }

    // Count badge of a tab: "8", or "3/8" while a search filters the list.
    pure function badge(shown: int, total: int) -> string {
        root.filter_query != "" ? shown + "/" + total : "" + total
    }

    function select_row(id: string) {
        root.selected_id = id;
        list-keys.focus();
    }

    // Keys the list handles even while the search box has focus.
    function list_key(e: KeyEvent) -> EventResult {
        if (e.text == Key.UpArrow) {
            root.move_selection(-1);
            return accept;
        }
        if (e.text == Key.DownArrow) {
            root.move_selection(1);
            return accept;
        }
        if (e.text == Key.Escape && root.search_text != "") {
            search.clear();
            return accept;
        }
        reject
    }

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        if as_new_session_page: HorizontalLayout {
            height: 28px;
            spacing: 10px;
            Rectangle {
                width: 2px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                background: #dc2626;
            }
            Text {
                horizontal-stretch: 1;
                text: open_sessions >= 4
                    ? "4 sessions are open (the maximum). Close a tab to open a new one."
                    : "The session opens in a new tab (" + open_sessions + " of 4 sessions open).";
                color: open_sessions >= 4 ? #f87171 : #a1a1aa;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: back-txt.preferred-width + 20px;
                height: 28px;
                background: ta-back.has-hover ? #27272a : #18181c;
                border-width: 1px;
                border-color: #27272a;
                ta-back := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { back_to_sessions(); }
                }
                back-txt := Text {
                    text: "Back to sessions";
                    color: #e4e4e7;
                    font-size: 11px;
                    font-weight: 600;
                }
            }
        }

        // Top Split Panels
        HorizontalLayout {
            spacing: 16px;
            height: 168px;

            // Left Panel: ID Anda
            Rectangle {
                background: #111114;
                border-width: 1px;
                border-color: #222227;
                clip: true;

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    Rectangle {
                        height: 2px;
                        background: #dc2626;
                    }

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "This Device's ID";
                                color: #a1a1aa;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                height: 26px;
                                background: ta-copy.has-hover ? #27272a : #18181c;
                                border-width: 1px;
                                border-color: #2e2e36;
                                ta-copy := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { copy_local_id(); }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: "Copy ID";
                                        color: #e4e4e7;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 64px;
                            background: #0a0a0c;
                            border-width: 1px;
                            border-color: #1f1f24;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;
                                alignment: start;

                                Rectangle {
                                    width: 3px;
                                    height: 28px;
                                    background: #dc2626;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: local_desk_id;
                                    color: #fafafa;
                                    font-size: 28px;
                                    font-weight: 800;
                                    letter-spacing: 2px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: host_notice != "" ? host_notice : is_relay_online ? "Ready for connections" : "Waiting for the relay";
                            color: host_notice != "" ? #fbbf24 : #71717a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Right panel: connect to another device
            Rectangle {
                background: #111114;
                border-width: 1px;
                border-color: #222227;
                clip: true;

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    Rectangle {
                        height: 2px;
                        background: #dc2626;
                    }

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        alignment: space-between;

                        Text {
                            text: "Control Another Device";
                            color: #a1a1aa;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        Rectangle {
                            height: 42px;
                            background: #0a0a0c;
                            border-width: 1px;
                            border-color: input-target.has-focus ? #dc2626 : #27272a;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;

                                Rectangle {
                                    if input-target.text == "": Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: "Enter a device ID";
                                        color: #52525b;
                                        font-size: 15px;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                    }

                                    input-target := TextInput {
                                        text <=> target_desk_id;
                                        color: #fafafa;
                                        font-size: 16px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        single-line: true;
                                        accepted => {
                                            request_connect(self.text);
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 38px;
                            background: ta-conn.has-hover ? #e11d48 : #dc2626;
                            ta-conn := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    request_connect(input-target.text);
                                }
                            }
                            Text {
                                text: "Connect";
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Bottom section: session history and relay hosts (admin)
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            border-width: 1px;
            border-color: #222227;
            clip: true;

            list-keys := FocusScope {
                capture-key-pressed(e) => { root.list_key(e) }
                key-pressed(e) => {
                    if (e.text == Key.Return && root.selected_id != "") {
                        root.connect_selected();
                        return accept;
                    }
                    root.list_key(e)
                }

                VerticalLayout {
                    padding: 1px;
                    spacing: 0px;

                    // Tab bar (admin edition): a segmented control across the panel.
                    if is_admin: Rectangle {
                        height: 38px;
                        background: Theme.raised;

                        HorizontalLayout {
                            spacing: 0px;

                            DashboardTab {
                                label: "Relay Hosts";
                                icon: Icons.server;
                                badge: root.badge(server_hosts.length, host_total);
                                active: active_tab == 1;
                                clicked => {
                                    active_tab = 1;
                                    refresh_hosts();
                                }
                            }

                            DashboardTab {
                                label: "Session History";
                                icon: Icons.clock;
                                badge: root.badge(history_items.length, history_total);
                                active: active_tab == 0;
                                clicked => { active_tab = 0; }
                            }

                            // Monitor wall: view-only grid of many hosts (not from the "+" page: sessions are open).
                            if !as_new_session_page: DashboardTab {
                                label: "Monitor Wall";
                                icon: Icons.grid;
                                external: true;
                                clicked => { open_monitor(); }
                            }
                        }
                    }

                    if is_admin: Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    // Toolbar: search, and Refresh on the relay host list.
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 10px;

                        if !is_admin: HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 2px;
                                height: 12px;
                                y: (parent.height - self.height) / 2;
                                background: Theme.accent;
                            }
                            Text {
                                text: "Session History (" + root.badge(history_items.length, history_total) + ")";
                                color: #d4d4d8;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        search := SearchField {
                            placeholder: is_admin && active_tab == 1
                                ? "Search name, ID, device, platform…"
                                : "Search name or ID…";
                            text <=> root.search_text;
                            edited(text) => { root.search_edited(text); }
                        }

                        if is_admin && active_tab == 1: Rectangle {
                            width: ref-txt.preferred-width + 24px;
                            height: 30px;
                            background: ta-ref.has-hover ? Theme.border : Theme.surface-2;
                            border-width: 1px;
                            border-color: #2e2e36;
                            ta-ref := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { refresh_hosts(); }
                            }
                            ref-txt := Text {
                                text: "Refresh";
                                color: #d4d4d8;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    // Content Area: both lists scroll (mouse wheel, drag or scrollbar).
                    VerticalLayout {
                        vertical-stretch: 1;
                        padding-left: 12px;
                        padding-right: 4px;
                        padding-top: 12px;
                        padding-bottom: 12px;

                        list := ScrollArea {
                            vertical-stretch: 1;
                            spacing: 6px;
                            reset_key: active_tab;

                            // Session history (every edition; admin on tab 0)
                            if !is_admin || active_tab == 0: VerticalLayout {
                                spacing: 6px;
                                alignment: start;

                                if history_items.length == 0: Rectangle {
                                    height: 80px;
                                    Text {
                                        text: history_total == 0 ? "No sessions yet." : "No sessions match \"" + filter_query + "\"";
                                        color: #52525b;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                for item in history_items: ListRow {
                                    title: item.alias != "" ? item.alias : item.desk_id;
                                    subtitle: item.alias != "" ? item.desk_id : "";
                                    show_delete: true;
                                    selected: item.desk_id == root.selected_id;
                                    dimmed: root.selected_id != "" && !self.selected;
                                    changed selected => {
                                        if (self.selected) {
                                            list.reveal(self.y, self.height);
                                        }
                                    }
                                    select => { root.select_row(item.desk_id); }
                                    rename => { open_rename(item.desk_id, item.alias); }
                                    connect => { request_connect(item.desk_id); }
                                    remove => {
                                        prompt_delete_history(
                                            item.desk_id,
                                            item.alias != "" ? item.alias + " (" + item.desk_id + ")" : item.desk_id
                                        );
                                    }
                                }
                            }

                            // Relay hosts (admin edition, tab 1)
                            if is_admin && active_tab == 1: VerticalLayout {
                                spacing: 6px;
                                alignment: start;

                                if server_hosts.length == 0: Rectangle {
                                    height: 80px;
                                    Text {
                                        text: host_total == 0
                                            ? "No hosts are registered on the relay yet."
                                            : "No hosts match \"" + filter_query + "\"";
                                        color: #52525b;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                for host in server_hosts: ListRow {
                                    title: (host.alias != "" ? host.alias : host.device_name) + "  •  " + host.desk_id;
                                    subtitle: (host.online ? ("Online • " + host.platform) : ("Offline (" + host.last_seen + ") • " + host.platform))
                                        + (host.alias != "" ? " • " + host.device_name : "");
                                    subtitle_color: host.online ? Theme.ok : Theme.text-3;
                                    muted: !host.online;
                                    dot: true;
                                    marker_color: host.online ? Theme.ok : #52525b;
                                    show_rename: host_alias_supported;
                                    can_connect: host.online;
                                    connect_label: host.online ? "Connect" : "Offline";
                                    selected: host.desk_id == root.selected_id;
                                    dimmed: root.selected_id != "" && !self.selected;
                                    changed selected => {
                                        if (self.selected) {
                                            list.reveal(self.y, self.height);
                                        }
                                    }
                                    select => { root.select_row(host.desk_id); }
                                    rename => { open_host_rename(host.desk_id, host.alias); }
                                    connect => { request_connect(host.desk_id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
