// Home screen: this device's ID, connect form, history and (admin) host list.

import { HistoryItem, HostItem } from "../types.slint";
import { Theme, Icons } from "../theme.slint";
import { ScrollArea } from "../components/scroll_area.slint";
import { ListRow } from "../components/list_row.slint";
import { DashboardTab } from "dashboard_tab.slint";
import { SearchField } from "search_field.slint";

// "This Device's ID" card: the ID in a copyable box and the reachability notice.
component IdPanel inherits Rectangle {
    in property <string> local_desk_id;
    in property <bool> is_relay_online;
    in property <string> host_notice;
    callback copy_local_id();

    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.divider;
    horizontal-stretch: 1;
    min-width: 0px;

    VerticalLayout {
        padding: 16px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;
        alignment: center;

        Text {
            text: "This Device's ID";
            color: Theme.text-2;
            font-size: 12px;
            font-weight: 600;
        }

        Rectangle {
            height: 48px;
            border-radius: Theme.radius-md;
            background: Theme.input;
            border-width: 1px;
            border-color: id-ta.has-hover ? Theme.border : Theme.divider;
            id-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.copy_local_id(); }
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 11px;
                Rectangle {
                    width: 3px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: Theme.accent;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.local_desk_id;
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    width: copy-txt.preferred-width + 20px;
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    background: id-ta.has-hover ? #ffffff1a : #ffffff0d;
                    copy-txt := Text {
                        text: "Copy ID";
                        color: id-ta.has-hover ? Theme.text : Theme.text-2;
                        font-size: 11.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        Text {
            text: root.host_notice != "" ? root.host_notice : root.is_relay_online ? "Ready for connections" : "Waiting for the relay";
            color: root.host_notice != "" ? #fbbf24 : Theme.text-3;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// "Control Another Device" card: ID input and Connect button on one row.
component ConnectPanel inherits Rectangle {
    in-out property <string> target_desk_id;
    callback request_connect(string);

    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.divider;
    horizontal-stretch: 1;
    min-width: 0px;

    VerticalLayout {
        padding: 16px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;
        alignment: center;

        Text {
            text: "Control Another Device";
            color: Theme.text-2;
            font-size: 12px;
            font-weight: 600;
        }

        HorizontalLayout {
            spacing: 10px;
            height: 48px;

            Rectangle {
                horizontal-stretch: 1;
                min-width: 60px;
                border-radius: Theme.radius-md;
                background: Theme.input;
                border-width: 1px;
                border-color: input-target.has-focus ? Theme.accent : Theme.divider;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;

                    Rectangle {
                        if input-target.text == "": Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Enter a device ID";
                            color: Theme.text-3;
                            font-size: 13.5px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                        input-target := TextInput {
                            text <=> root.target_desk_id;
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.request_connect(self.text); }
                        }
                    }
                }
            }

            Rectangle {
                width: 110px;
                border-radius: Theme.radius-md;
                background: ta-conn.has-hover ? Theme.accent-hover : Theme.accent;
                ta-conn := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.request_connect(input-target.text); }
                }
                Text {
                    text: "Connect";
                    color: #ffffff;
                    font-size: 13.5px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// Tabs of the list panel (admin edition): a pill group.
component TabStrip inherits Rectangle {
    in property <bool> as_new_session_page;
    in property <bool> compact;
    in property <string> hosts_badge;
    in property <string> history_badge;
    in property <int> active_tab;
    callback hosts_clicked();
    callback history_clicked();
    callback wall_clicked();

    height: 42px;
    border-radius: Theme.radius-md;
    background: Theme.input;
    border-width: 1px;
    border-color: Theme.divider;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        DashboardTab {
            label: "Relay Hosts";
            icon: Icons.server;
            badge: root.hosts_badge;
            compact: root.compact;
            active: root.active_tab == 1;
            clicked => { root.hosts_clicked(); }
        }
        DashboardTab {
            label: "Session History";
            icon: Icons.clock;
            badge: root.history_badge;
            compact: root.compact;
            active: root.active_tab == 0;
            clicked => { root.history_clicked(); }
        }
        // Monitor wall: view-only grid of many hosts (not from the "+" page: sessions are open).
        if !root.as_new_session_page: DashboardTab {
            label: "Monitor Wall";
            icon: Icons.grid;
            external: true;
            compact: root.compact;
            clicked => { root.wall_clicked(); }
        }
    }
}

// The root is a FocusScope so Ctrl+F reaches the search box wherever focus is on this screen.
export component DashboardView inherits FocusScope {
    width: 100%;
    height: 100%;
    focus-on-click: false;
    focus-on-tab-navigation: false;

    in property <string> local_desk_id: "";
    in property <bool> is_relay_online: false;
    in property <bool> is_admin: false;
    // Why this device cannot be controlled in this session (Linux on Wayland); empty when it can.
    in property <string> host_notice: "";
    in-out property <int> active_tab: 0; // 0 = session history, 1 = relay hosts (admin)
    in-out property <string> target_desk_id: "";
    // Rows matching the search; the totals count every row.
    in property <[HistoryItem]> history_items: [];
    in property <[HostItem]> server_hosts: [];
    in property <int> history_total: 0;
    in property <int> host_total: 0;
    // Text in the search box, and the query the lists are currently filtered by ("" = none).
    in-out property <string> search_text: "";
    in property <string> filter_query: "";
    // Desk ID of the selected row ("" = none).
    in-out property <string> selected_id: "";
    // The relay stores names for devices in its host list (admin edition).
    in property <bool> host_alias_supported: false;

    callback copy_local_id();
    callback request_connect(string);
    callback open_rename(string, string);
    // Admin edition: names a device in the relay's host list for every administrator.
    callback open_host_rename(string, string);
    callback prompt_delete_history(string, string);
    callback refresh_hosts();
    // Admin edition: show the monitor wall.
    callback open_monitor();
    // Every keystroke in the search box.
    callback search_edited(string);
    // Arrow keys: move the selection by this many rows.
    callback move_selection(int);
    // Enter: connect to the selected row.
    callback connect_selected();

    // "+" page while viewer sessions are open (multi-session workspace).
    in property <bool> as_new_session_page: false;
    in property <int> open_sessions: 0;
    callback back_to_sessions();

    // Narrow window: the two cards stack and the tabs sit above the search box.
    property <bool> narrow: root.width < 700px;

    // Arrow keys and Enter act on the list without a click first.
    init => { list-keys.focus(); }

    // A switched tab shows other rows; the selection belongs to the old ones.
    changed active_tab => { root.selected_id = ""; }

    capture-key-pressed(e) => {
        if (e.modifiers.control && (e.text == "f" || e.text == "F" || e.text == "\u{6}")) {
            search.focus-input();
            return accept;
        }
        reject
    }

    // Count badge of a tab: only while a search filters the list ("3/8"); the tabs are plain otherwise.
    pure function badge(shown: int, total: int) -> string {
        root.filter_query != "" ? shown + "/" + total : ""
    }

    function select_row(id: string) {
        root.selected_id = id;
        list-keys.focus();
    }

    // Keys the list handles even while the search box has focus.
    function list_key(e: KeyEvent) -> EventResult {
        if (e.text == Key.UpArrow) {
            root.move_selection(-1);
            return accept;
        }
        if (e.text == Key.DownArrow) {
            root.move_selection(1);
            return accept;
        }
        if (e.text == Key.Escape && root.search_text != "") {
            search.clear();
            return accept;
        }
        reject
    }

    VerticalLayout {
        padding: root.narrow ? 12px : 20px;
        spacing: root.narrow ? 12px : 18px;

        if as_new_session_page: HorizontalLayout {
            height: 30px;
            spacing: 10px;
            Rectangle {
                width: 3px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                border-radius: 2px;
                background: Theme.accent;
            }
            Text {
                horizontal-stretch: 1;
                text: open_sessions >= 4
                    ? "4 sessions are open (the maximum). Close a tab to open a new one."
                    : "The session opens in a new tab (" + open_sessions + " of 4 sessions open).";
                color: open_sessions >= 4 ? #f87171 : Theme.text-2;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: back-txt.preferred-width + 24px;
                height: 30px;
                border-radius: Theme.radius-sm;
                background: ta-back.has-hover ? Theme.hover : Theme.surface-2;
                border-width: 1px;
                border-color: Theme.divider;
                ta-back := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { back_to_sessions(); }
                }
                back-txt := Text {
                    text: "Back to sessions";
                    color: Theme.text;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Connection strip: two cards side by side, stacked in a narrow window.
        if !root.narrow: HorizontalLayout {
            spacing: 16px;
            IdPanel {
                local_desk_id: root.local_desk_id;
                is_relay_online: root.is_relay_online;
                host_notice: root.host_notice;
                copy_local_id => { root.copy_local_id(); }
            }
            ConnectPanel {
                target_desk_id <=> root.target_desk_id;
                request_connect(id) => { root.request_connect(id); }
            }
        }
        if root.narrow: VerticalLayout {
            spacing: 10px;
            IdPanel {
                local_desk_id: root.local_desk_id;
                is_relay_online: root.is_relay_online;
                host_notice: root.host_notice;
                copy_local_id => { root.copy_local_id(); }
            }
            ConnectPanel {
                target_desk_id <=> root.target_desk_id;
                request_connect(id) => { root.request_connect(id); }
            }
        }

        // Directory: search and tabs, then the list.
        Rectangle {
            vertical-stretch: 1;
            min-height: 120px;
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.divider;
            clip: true;

            list-keys := FocusScope {
                capture-key-pressed(e) => { root.list_key(e) }
                key-pressed(e) => {
                    if (e.text == Key.Return && root.selected_id != "") {
                        root.connect_selected();
                        return accept;
                    }
                    root.list_key(e)
                }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    VerticalLayout {
                        padding: 12px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;

                        // Narrow window: the tabs take a row of their own above the search.
                        if is_admin && root.narrow: TabStrip {
                            compact: false;
                            as_new_session_page: root.as_new_session_page;
                            hosts_badge: root.badge(server_hosts.length, host_total);
                            history_badge: root.badge(history_items.length, history_total);
                            active_tab: root.active_tab;
                            hosts_clicked => {
                                root.active_tab = 1;
                                refresh_hosts();
                            }
                            history_clicked => { root.active_tab = 0; }
                            wall_clicked => { open_monitor(); }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            height: 42px;

                            if !is_admin: HorizontalLayout {
                                spacing: 8px;
                                horizontal-stretch: 0;
                                Rectangle {
                                    width: 3px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 2px;
                                    background: Theme.accent;
                                }
                                Text {
                                    text: "Session History";
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            search := SearchField {
                                y: (parent.height - self.height) / 2;
                                placeholder: is_admin && active_tab == 1
                                    ? "Search name, ID, device, platform…"
                                    : "Search name or ID…";
                                text <=> root.search_text;
                                edited(text) => { root.search_edited(text); }
                            }

                            if is_admin && active_tab == 1: Rectangle {
                                width: ref-txt.preferred-width + 24px;
                                height: 34px;
                                y: (parent.height - self.height) / 2;
                                border-radius: Theme.radius-md;
                                background: ta-ref.has-hover ? Theme.hover : #ffffff0d;
                                border-width: 1px;
                                border-color: Theme.divider;
                                ta-ref := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { refresh_hosts(); }
                                }
                                ref-txt := Text {
                                    text: "Refresh";
                                    color: Theme.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }

                            // Wide window: the tabs sit right of the search; icons only below 880 px.
                            if is_admin && !root.narrow: TabStrip {
                                width: root.width < 880px ? 150px : 440px;
                                compact: root.width < 880px;
                                as_new_session_page: root.as_new_session_page;
                                hosts_badge: root.badge(server_hosts.length, host_total);
                                history_badge: root.badge(history_items.length, history_total);
                                active_tab: root.active_tab;
                                hosts_clicked => {
                                    root.active_tab = 1;
                                    refresh_hosts();
                                }
                                history_clicked => { root.active_tab = 0; }
                                wall_clicked => { open_monitor(); }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    // Content Area: both lists scroll (mouse wheel, drag or scrollbar).
                    VerticalLayout {
                        vertical-stretch: 1;
                        padding-left: 12px;
                        padding-right: 4px;
                        padding-top: 12px;
                        padding-bottom: 12px;

                        list := ScrollArea {
                            vertical-stretch: 1;
                            spacing: 6px;
                            reset_key: active_tab;

                            // Session history (every edition; admin on tab 0)
                            if !is_admin || active_tab == 0: VerticalLayout {
                                spacing: 6px;
                                alignment: start;

                                if history_items.length == 0: Rectangle {
                                    height: 80px;
                                    Text {
                                        text: history_total == 0 ? "No sessions yet." : "No sessions match \"" + filter_query + "\"";
                                        color: Theme.text-3;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                for item in history_items: ListRow {
                                    title: item.alias != "" ? item.alias : item.desk_id;
                                    subtitle: item.alias != "" ? item.desk_id : "";
                                    show_delete: true;
                                    selected: item.desk_id == root.selected_id;
                                    dimmed: root.selected_id != "" && !self.selected;
                                    changed selected => {
                                        if (self.selected) {
                                            list.reveal(self.y, self.height);
                                        }
                                    }
                                    select => { root.select_row(item.desk_id); }
                                    rename => { open_rename(item.desk_id, item.alias); }
                                    connect => { request_connect(item.desk_id); }
                                    remove => {
                                        prompt_delete_history(
                                            item.desk_id,
                                            item.alias != "" ? item.alias + " (" + item.desk_id + ")" : item.desk_id
                                        );
                                    }
                                }
                            }

                            // Relay hosts (admin edition, tab 1)
                            if is_admin && active_tab == 1: VerticalLayout {
                                spacing: 6px;
                                alignment: start;

                                if server_hosts.length == 0: Rectangle {
                                    height: 80px;
                                    Text {
                                        text: host_total == 0
                                            ? "No hosts are registered on the relay yet."
                                            : "No hosts match \"" + filter_query + "\"";
                                        color: Theme.text-3;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                for host in server_hosts: ListRow {
                                    title: (host.alias != "" ? host.alias : host.device_name) + "  •  " + host.desk_id;
                                    subtitle: (host.online ? ("Online • " + host.platform) : ("Offline (" + host.last_seen + ") • " + host.platform))
                                        + (host.alias != "" ? " • " + host.device_name : "");
                                    subtitle_color: host.online ? Theme.ok : Theme.text-3;
                                    muted: !host.online;
                                    dot: true;
                                    marker_color: host.online ? Theme.ok : #52525b;
                                    show_rename: host_alias_supported;
                                    can_connect: host.online;
                                    connect_label: host.online ? "Connect" : "Offline";
                                    selected: host.desk_id == root.selected_id;
                                    dimmed: root.selected_id != "" && !self.selected;
                                    changed selected => {
                                        if (self.selected) {
                                            list.reveal(self.y, self.height);
                                        }
                                    }
                                    select => { root.select_row(host.desk_id); }
                                    rename => { open_host_rename(host.desk_id, host.alias); }
                                    connect => { request_connect(host.desk_id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
