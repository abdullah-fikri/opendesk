// Shown while a remote viewer controls this machine.

import { Theme } from "../theme.slint";
import { Glyph } from "../components/glyph.slint";
import { Btn, Card } from "../components/controls.slint";

export component HostActiveView inherits VerticalLayout {
    width: 100%;
    height: 100%;
    padding: 24px;
    alignment: center;

    in property <string> active_partner_id: "";
    in property <bool> is_mic_muted: false;

    callback toggle_mic();
    callback disconnect_session();

    HorizontalLayout {
        alignment: center;

        Card {
            width: 440px;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 10px;
                    Glyph {
                        y: (parent.height - self.height) / 2;
                        name: "info-circle";
                        size: 18px;
                        tint: Theme.blue;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: "This computer is being controlled remotely.";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                Rectangle {
                    height: 64px;
                    border-radius: 10px;
                    background: Theme.surf2;
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Connected to";
                            color: Theme.text-2;
                            font-size: 11px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.active_partner_id != "" ? root.active_partner_id : "-";
                            color: Theme.text;
                            font-size: 20px;
                            font-weight: 600;
                            font-family: Theme.mono;
                            letter-spacing: 1px;
                        }
                    }
                }

                Text {
                    text: "Drag and drop files onto this window to send them to the remote device.";
                    color: Theme.text-2;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Btn {
                        horizontal-stretch: 1;
                        height: 32px;
                        icon: "mic";
                        kind: root.is_mic_muted ? "default" : "tint";
                        label: root.is_mic_muted ? "Microphone Off" : "Microphone On";
                        clicked => { root.toggle_mic(); }
                    }
                    Btn {
                        horizontal-stretch: 1;
                        height: 32px;
                        kind: "acc";
                        label: "End Session";
                        clicked => { root.disconnect_session(); }
                    }
                }
            }
        }
    }
}
