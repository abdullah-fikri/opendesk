// Settings (admin edition): a sidebar with five panes, in two groups.
// - Relay, stored on the relay for every device: Security manages the relay's device allowlist (client tokens,
//   docs/features/device-security.md at the repository root): listed devices receive their token automatically
//   on their first connection, so clients only need the relay address. Communities (page 4,
//   communities_pane.slint) manages communities, groups and group members.
// - This device, stored in the local config.json: Server (relay address, viewing performance), Audio (microphone,
//   client-desktop/docs/features/voice.md) and Mouse (pointer lock, `mouse-relative` in docs/protocol.md).
// In a narrow window the sidebar shows the tiles only.

import { SecurityItem, CommunityItem, GroupItem, MemberPick } from "../../types.slint";
import { CommunitiesPane } from "communities_pane.slint";
import { Theme, Brand } from "../../theme.slint";
import { Glyph } from "../../components/glyph.slint";
import { AppTile } from "../../components/app_tile.slint";
import { ScrollArea } from "../../components/scroll_area.slint";
import { Btn, Seg, SegWrap, Switch, Card, GroupLabel, Pop, AppearancePicker } from "../../components/controls.slint";
import { DragArea } from "../../components/window_frame.slint";
import { NavItem } from "../dashboard.slint";

// Heading above a group.
component GroupTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> count;
    padding-left: 4px;
    padding-right: 4px;
    spacing: 6px;
    height: 24px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        horizontal-stretch: 1;
        text: root.count;
        color: Theme.text-3;
        font-size: 13px;
        vertical-alignment: center;
    }
}

// Row of a group: title and description on the left, the control (@children) on the right.
component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> first: true;
    min-height: self.description == "" ? 52px : 62px;

    if !root.first: Rectangle {
        x: 16px;
        y: 0;
        width: root.width - 16px;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 500;
                wrap: word-wrap;
            }
            if root.description != "": Text {
                text: root.description;
                color: Theme.text-2;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        @children
    }
}

// Text box of a settings row.
component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> mono: false;
    in property <bool> right: false;
    callback accepted(string);
    callback edited(string);

    height: 30px;
    border-radius: 7px;
    background: Theme.inp;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.ring;
    if root.text == "": Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-3;
        font-size: 13px;
        horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.text;
        color: Theme.text;
        font-size: 13px;
        font-family: root.mono ? Theme.mono : "";
        horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
}

// Coloured banner line inside a group (warnings, notes).
component NoteRow inherits Rectangle {
    in property <string> text;
    in property <string> icon: "warn";
    in property <color> tint: Theme.amber;
    in property <bool> first: false;
    min-height: 40px;
    if !root.first: Rectangle {
        x: 16px;
        y: 0;
        width: root.width - 16px;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        Glyph {
            y: (parent.height - self.height) / 2;
            name: root.icon;
            size: 14px;
            tint: root.tint;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.tint;
            font-size: 12px;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        @children
    }
}

export component SettingsView inherits Rectangle {
    // 0 = Security, 1 = Server, 2 = Audio, 3 = Mouse.
    in-out property <int> page: 0;
    // Server pane: the relay address and the viewer performance preset (0 = Low, 1 = Medium, 2 = High).
    in-out property <string> gateway_url: "";
    in property <int> performance: 1;
    callback save_gateway_url(string);
    callback save_performance(int);
    // This device: the microphone is on when a session starts.
    in property <bool> mic_on_at_start: true;
    callback set_mic_on_at_start(bool);
    // This device: a game on the host that captures the mouse locks the pointer here (relative motion).
    in property <bool> pointer_lock: false;
    callback set_pointer_lock(bool);
    // The relay supports the device allowlist (known once registered).
    in property <bool> relay_online: false;
    in property <bool> security_supported: false;
    in property <bool> security_enabled: false;
    in property <bool> security_managed_by_env: false;
    in property <[SecurityItem]> security_items;
    callback save_appearance(int);

    // Communities pane (page 4); see communities_pane.slint.
    in property <bool> communities_supported: false;
    in property <[CommunityItem]> communities: [];
    in property <[GroupItem]> manage_groups: [];
    in property <[MemberPick]> member_picks: [];
    in property <int> member_count: 0;
    in-out property <string> manage_community: "";
    in-out property <string> manage_group: "";
    in property <string> manage_community_name: "";
    in property <string> manage_community_icon: "";
    in property <string> manage_community_color: "";
    in property <string> manage_group_name: "";
    in-out property <string> member_search: "";
    callback manage_changed();
    callback open_name_sheet(int, string, string, string, string);
    callback prompt_confirm(string, string, string, string);
    callback set_group_member(string, string, bool);

    callback close();
    callback refresh();
    callback set_enabled(bool);
    // (desk ID as typed, administrator)
    callback add_device(string, bool);
    callback add_online();
    callback remove_device(string);
    callback reset_device(string);

    property <bool> confirm_enable: false;
    // Alert sheet: "reset" or "remove" for `confirm_id`.
    property <string> confirm_kind: "";
    property <string> confirm_id: "";
    property <string> confirm_name: "";
    property <bool> add_admin: false;
    property <string> add_id: "";
    property <int> picked_perf: root.performance;
    property <bool> gateway_saved: false;
    property <bool> compact: root.width < 760px;
    property <length> pad: root.compact ? 20px : 40px;

    function go(p: int) {
        root.confirm_enable = false;
        root.confirm_kind = "";
        root.page = p;
        if (p == 0) {
            root.refresh();
        }
        if (p == 4) {
            root.manage_changed();
        }
    }

    function add() {
        if (root.add_id != "") {
            root.add_device(root.add_id, root.add_admin);
            root.add_id = "";
            root.add_admin = false;
        }
    }

    background: Theme.bg;

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // ---- Sidebar
        Rectangle {
            width: root.compact ? 64px : 232px;
            background: Theme.side;
            VerticalLayout {
                padding-left: root.compact ? 8px : 12px;
                padding-right: self.padding-left;
                padding-bottom: 12px;
                spacing: 2px;

                Rectangle {
                    height: 52px;
                    DragArea { }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 10px;
                        Image {
                            y: (parent.height - self.height) / 2;
                            width: 28px;
                            height: 28px;
                            source: Brand.logo;
                            image-fit: contain;
                        }
                        if !root.compact: VerticalLayout {
                            alignment: center;
                            Text {
                                text: "OpenDesk";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Settings";
                                color: Theme.text-3;
                                font-size: 11.5px;
                            }
                        }
                    }
                }

                Rectangle { height: 8px; }
                if !root.compact: GroupLabel { text: "Relay"; height: 19px; x: 10px; }
                NavItem { compact: root.compact; tile: "security"; label: "Security"; active: root.page == 0; clicked => { root.go(0); } }
                NavItem { compact: root.compact; tile: "community"; label: "Communities"; count: root.communities.length > 0 ? root.communities.length : ""; active: root.page == 4; clicked => { root.go(4); } }
                Rectangle { height: 18px; }
                if !root.compact: GroupLabel { text: "This device"; height: 19px; x: 10px; }
                NavItem { compact: root.compact; tile: "server"; label: "Server"; active: root.page == 1; clicked => { root.go(1); } }
                NavItem { compact: root.compact; tile: "audio"; label: "Audio"; active: root.page == 2; clicked => { root.go(2); } }
                NavItem { compact: root.compact; tile: "mouse"; label: "Mouse"; active: root.page == 3; clicked => { root.go(3); } }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    padding-left: root.compact ? 0px : 10px;
                    alignment: root.compact ? center : space-between;
                    if !root.compact: Text {
                        text: "Appearance";
                        color: Theme.text-2;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    AppearancePicker {
                        compact: root.compact;
                        chosen(a) => { root.save_appearance(a); }
                    }
                }
            }
        }

        // ---- Main
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 0px;

            Rectangle {
                height: 56px;
                DragArea { }
                // Below the window buttons (top 32 px of the corner).
                HorizontalLayout {
                    y: 12px;
                    height: parent.height - 12px;
                    padding-left: 20px;
                    padding-right: 150px;
                    spacing: 8px;
                    Btn {
                        y: (parent.height - self.height) / 2;
                        kind: "ghost";
                        icon: "chevron-left";
                        label: "Devices";
                        clicked => { root.close(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            ScrollArea {
                vertical-stretch: 1;
                spacing: 0px;
                reset_key: root.page;

                HorizontalLayout {
                    padding-left: root.pad;
                    padding-right: root.pad - 10px;
                    padding-top: 8px;
                    padding-bottom: 48px;
                    alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        max-width: 680px;
                        spacing: 28px;

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.page == 0 ? "Security" : root.page == 1 ? "Server" : root.page == 2 ? "Audio"
                                    : root.page == 4 ? "Communities" : "Mouse";
                                color: Theme.text;
                                font-size: 28px;
                                font-weight: 700;
                                letter-spacing: -0.5px;
                            }
                            Text {
                                text: root.page == 0 ? "Choose which devices are allowed to connect to this relay."
                                    : root.page == 1 ? "The relay this computer uses and how sessions look from here."
                                    : root.page == 2 ? "Your microphone in sessions on this computer."
                                    : root.page == 4 ? "Sort devices into communities and groups, shared with every administrator."
                                    : "How the mouse behaves when you control another device.";
                                color: Theme.text-2;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }

                        // ================= Communities
                        if root.page == 4: CommunitiesPane {
                            supported: root.communities_supported;
                            communities: root.communities;
                            groups: root.manage_groups;
                            members: root.member_picks;
                            member_count: root.member_count;
                            community <=> root.manage_community;
                            group <=> root.manage_group;
                            community_name: root.manage_community_name;
                            community_icon: root.manage_community_icon;
                            community_color: root.manage_community_color;
                            group_name: root.manage_group_name;
                            member_search <=> root.member_search;
                            selection_changed => { root.manage_changed(); }
                            open_name_sheet(k, t, n, i, c) => { root.open_name_sheet(k, t, n, i, c); }
                            prompt_confirm(k, t, ti, b) => { root.prompt_confirm(k, t, ti, b); }
                            set_group_member(g, d, m) => { root.set_group_member(g, d, m); }
                        }

                        // ================= Security
                        if root.page == 0 && !root.security_supported: Card {
                            NoteRow {
                                first: true;
                                text: !root.relay_online ? "Waiting for the relay…" : "This relay does not support client tokens. Update the relay to use them.";
                                icon: !root.relay_online ? "info-circle" : "warn";
                                tint: !root.relay_online ? Theme.blue : Theme.amber;
                            }
                        }

                        // Access
                        if root.page == 0 && root.security_supported: VerticalLayout {
                            spacing: 8px;
                            GroupTitle { text: "Access"; }
                            Card {
                                VerticalLayout {
                                    Rectangle {
                                        min-height: 62px;
                                        HorizontalLayout {
                                            padding: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 12px;
                                            AppTile {
                                                y: (parent.height - self.height) / 2;
                                                kind: root.security_enabled ? "security" : "security-off";
                                                tile: 30px;
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Client token allowlist";
                                                    color: Theme.text;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: root.security_enabled
                                                        ? "On: only devices on the allowlist can connect to this relay."
                                                        : "Off: any device that knows the relay address can connect.";
                                                    color: Theme.text-2;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                            Switch {
                                                y: (parent.height - self.height) / 2;
                                                on: root.security_enabled;
                                                enabled: root.relay_online;
                                                toggled => {
                                                    if (root.security_enabled) {
                                                        root.set_enabled(false);
                                                    } else {
                                                        root.confirm_enable = true;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if !root.security_enabled && !root.confirm_enable: NoteRow {
                                        text: "This relay is open. Turn the allowlist on to restrict access.";
                                    }
                                    if root.confirm_enable: NoteRow {
                                        text: "Devices that are not on the list are disconnected right away. This device is added as an administrator.";
                                        Btn {
                                            y: (parent.height - self.height) / 2;
                                            label: "Cancel";
                                            clicked => { root.confirm_enable = false; }
                                        }
                                        Btn {
                                            y: (parent.height - self.height) / 2;
                                            kind: "acc";
                                            label: "Turn On";
                                            clicked => {
                                                root.confirm_enable = false;
                                                root.set_enabled(true);
                                            }
                                        }
                                    }
                                    if root.security_managed_by_env: NoteRow {
                                        text: "The relay also has OPENDESK_DEVICE_CREDENTIALS set: those devices always need the token configured there, and the list below applies to every other device.";
                                        icon: "info-circle";
                                        tint: Theme.blue;
                                    }
                                }
                            }
                        }

                        // Authorize a device
                        if root.page == 0 && root.security_supported: Rectangle {
                          opacity: root.security_enabled ? 1.0 : 0.45;
                          VerticalLayout {
                            spacing: 8px;
                            GroupTitle { text: "Authorize a device"; }
                            Card {
                                VerticalLayout {
                                    SettingRow {
                                        title: "Device ID";
                                        Field {
                                            y: (parent.height - self.height) / 2;
                                            width: root.compact ? 160px : 240px;
                                            mono: true;
                                            right: true;
                                            placeholder: "e.g. 123 456 789";
                                            text <=> root.add_id;
                                            accepted => { root.add(); }
                                        }
                                    }
                                    SettingRow {
                                        first: false;
                                        title: "Administrator";
                                        description: "Grant administrator permission to this device.";
                                        Switch {
                                            y: (parent.height - self.height) / 2;
                                            on: root.add_admin;
                                            toggled => { root.add_admin = !root.add_admin; }
                                        }
                                    }
                                    Rectangle {
                                        height: 52px;
                                        Rectangle {
                                            x: 16px;
                                            y: 0;
                                            width: parent.width - 16px;
                                            height: 1px;
                                            background: Theme.line;
                                        }
                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 8px;
                                            Btn {
                                                y: (parent.height - self.height) / 2;
                                                label: "Add All Online Devices";
                                                enabled: root.relay_online && root.security_enabled;
                                                clicked => { root.add_online(); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Btn {
                                                y: (parent.height - self.height) / 2;
                                                kind: "acc";
                                                label: "Add Device";
                                                enabled: root.add_id != "" && root.relay_online && root.security_enabled;
                                                clicked => { root.add(); }
                                            }
                                        }
                                    }
                                }
                            }
                          }
                          // Allowlist off: these controls cannot be used.
                          if !root.security_enabled: TouchArea { }
                        }

                        // Allowed devices
                        if root.page == 0 && root.security_supported: Rectangle {
                          opacity: root.security_enabled ? 1.0 : 0.45;
                          VerticalLayout {
                            spacing: 8px;
                            GroupTitle {
                                text: "Allowed devices on this relay";
                                count: root.security_items.length;
                            }
                            Card {
                              clip: true;
                              VerticalLayout {
                                if root.security_items.length == 0: VerticalLayout {
                                    padding-top: 44px;
                                    padding-bottom: 44px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    spacing: 6px;
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: center;
                                        AppTile {
                                            kind: "security-off";
                                            tile: 44px;
                                        }
                                    }
                                    Text {
                                        text: "No Devices Registered";
                                        color: Theme.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Add device IDs above, or add every device that is online now.";
                                        color: Theme.text-2;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                                if root.security_items.length > 0: VerticalLayout {
                                    for d[i] in root.security_items: Rectangle {
                                        min-height: 56px;
                                        if i > 0: Rectangle {
                                            x: 16px;
                                            y: 0;
                                            width: parent.width - 16px;
                                            height: 1px;
                                            background: Theme.line;
                                        }
                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            padding-top: 8px;
                                            padding-bottom: 8px;
                                            spacing: 0px;
                                            Rectangle {
                                                width: 48px;
                                                Rectangle {
                                                    x: 0;
                                                    width: 34px;
                                                    height: 34px;
                                                    border-radius: 9px;
                                                    background: Theme.surf2;
                                                    Glyph {
                                                        name: "windows";
                                                        size: 16px;
                                                        tint: Theme.text-2;
                                                    }
                                                    Rectangle {
                                                        x: 34px - 9px - 2px;
                                                        y: 34px - 9px - 2px;
                                                        width: 15px;
                                                        height: 15px;
                                                        border-radius: 7.5px;
                                                        background: Theme.surf;
                                                        Rectangle {
                                                            width: 11px;
                                                            height: 11px;
                                                            border-radius: 5.5px;
                                                            background: d.online ? Theme.green : Theme.surf;
                                                            border-width: d.online ? 0px : 1.5px;
                                                            border-color: Theme.text-3;
                                                        }
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                min-width: 40px;
                                                alignment: center;
                                                spacing: 1px;
                                                Text {
                                                    text: d.name != "" ? d.name : "Unnamed device";
                                                    color: Theme.text;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: d.desk_id;
                                                    color: Theme.text-2;
                                                    font-size: 12px;
                                                    font-family: Theme.mono;
                                                }
                                            }
                                            if !root.compact: Text {
                                                width: 110px;
                                                text: d.admin ? "Administrator" : "Client";
                                                color: d.admin ? Theme.accent-tx : Theme.text-2;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                            if !root.compact: Text {
                                                width: 120px;
                                                text: !d.enrolled ? "Waiting for first connection" : d.online ? "Online" : "Offline";
                                                color: d.enrolled ? Theme.text-2 : Theme.amber;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: end;
                                                if d.enrolled: Btn {
                                                    y: (parent.height - self.height) / 2;
                                                    height: 26px;
                                                    kind: "ghost";
                                                    label: "Reset Token…";
                                                    enabled: root.relay_online && root.security_enabled;
                                                    clicked => {
                                                        root.confirm_kind = "reset";
                                                        root.confirm_id = d.desk_id;
                                                        root.confirm_name = d.name != "" ? d.name : d.desk_id;
                                                    }
                                                }
                                                Btn {
                                                    y: (parent.height - self.height) / 2;
                                                    height: 26px;
                                                    kind: "ghost";
                                                    icon: "minus";
                                                    icon-size: 13px;
                                                    tip: "Remove from the allowlist";
                                                    enabled: root.relay_online && root.security_enabled;
                                                    clicked => {
                                                        root.confirm_kind = "remove";
                                                        root.confirm_id = d.desk_id;
                                                        root.confirm_name = d.name != "" ? d.name : d.desk_id;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                              }
                            }
                            Text {
                                x: 4px;
                                text: "Reset token: use it when a device was reinstalled and lost its token. Its next connection receives a new one.";
                                color: Theme.text-2;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                          }
                          if !root.security_enabled: TouchArea { }
                        }

                        // ================= Server
                        if root.page == 1: VerticalLayout {
                            spacing: 8px;
                            GroupTitle { text: "Relay"; }
                            Card {
                                VerticalLayout {
                                    SettingRow {
                                        title: "Gateway address";
                                        description: "Server used to discover devices and relay encrypted sessions when direct P2P is unavailable.";
                                    }
                                    Rectangle {
                                        height: 52px;
                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            padding-bottom: 12px;
                                            spacing: 8px;
                                            Field {
                                                y: (parent.height - self.height) / 2;
                                                horizontal-stretch: 1;
                                                text <=> root.gateway_url;
                                                edited => { root.gateway_saved = false; }
                                                accepted(t) => {
                                                    root.save_gateway_url(t);
                                                    root.gateway_saved = true;
                                                }
                                            }
                                            Btn {
                                                y: (parent.height - self.height) / 2;
                                                kind: root.gateway_saved ? "default" : "acc";
                                                icon: root.gateway_saved ? "check" : "";
                                                label: root.gateway_saved ? "Saved" : "Save";
                                                clicked => {
                                                    root.save_gateway_url(root.gateway_url);
                                                    root.gateway_saved = true;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.page == 1: VerticalLayout {
                            spacing: 8px;
                            GroupTitle { text: "Performance when viewing"; }
                            Card {
                                SettingRow {
                                    title: root.picked_perf == 0 ? "Low" : root.picked_perf == 2 ? "High" : "Medium";
                                    description: root.picked_perf == 0 ? "Saves CPU, battery and data (30 FPS). Applies to open sessions at once."
                                        : root.picked_perf == 2 ? "Smoothest, follows your monitor's refresh rate. Applies to open sessions at once."
                                        : "Balanced for everyday work (60 FPS). Applies to open sessions at once.";
                                    SegWrap {
                                        y: (parent.height - self.height) / 2;
                                        Seg {
                                            label: "Low";
                                            selected: root.picked_perf == 0;
                                            clicked => {
                                                root.picked_perf = 0;
                                                root.save_performance(0);
                                            }
                                        }
                                        Seg {
                                            label: "Medium";
                                            selected: root.picked_perf == 1;
                                            clicked => {
                                                root.picked_perf = 1;
                                                root.save_performance(1);
                                            }
                                        }
                                        Seg {
                                            label: "High";
                                            selected: root.picked_perf == 2;
                                            clicked => {
                                                root.picked_perf = 2;
                                                root.save_performance(2);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ================= Audio
                        if root.page == 2: VerticalLayout {
                            spacing: 8px;
                            GroupTitle { text: "Microphone"; }
                            Card {
                                SettingRow {
                                    title: "Microphone when a session starts";
                                    description: root.mic_on_at_start
                                        ? "On: the other side hears you as soon as a session starts. The microphone button in a session still turns it off."
                                        : "Off: turn it on with the microphone button when you want to talk.";
                                    Switch {
                                        y: (parent.height - self.height) / 2;
                                        on: root.mic_on_at_start;
                                        toggled => { root.set_mic_on_at_start(!root.mic_on_at_start); }
                                    }
                                }
                            }
                            Text {
                                x: 4px;
                                text: "Applies to every new session on this computer, whether you control another device or someone controls this one.";
                                color: Theme.text-2;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }

                        // ================= Mouse
                        if root.page == 3: VerticalLayout {
                            spacing: 8px;
                            GroupTitle { text: "Games"; }
                            Card {
                                SettingRow {
                                    title: "Pointer lock for games";
                                    description: root.pointer_lock
                                        ? "On: games that capture the mouse get relative movement. Hold Ctrl+Alt to release."
                                        : "Off: the mouse always moves the remote pointer to where yours is.";
                                    Switch {
                                        y: (parent.height - self.height) / 2;
                                        on: root.pointer_lock;
                                        toggled => { root.set_pointer_lock(!root.pointer_lock); }
                                    }
                                }
                            }
                            Text {
                                x: 4px;
                                text: "When a game or 3D program on the remote computer hides and captures the mouse (mouse look), OpenDesk locks your pointer inside the session window and sends movement instead of positions. Click the remote screen to lock it again. Applies at once, also to open sessions.";
                                color: Theme.text-2;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- Alert sheet: reset or remove an allowed device
    if root.confirm_kind != "": Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Pop {
            width: 360px;
            height: sheet.preferred-height;
            sheet := VerticalLayout {
                padding: 24px;
                padding-bottom: 20px;
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    AppTile {
                        kind: root.confirm_kind == "reset" ? "key" : "security-off";
                        tile: 44px;
                    }
                }
                Rectangle { height: 8px; }
                Text {
                    text: root.confirm_kind == "reset"
                        ? "Reset token for “" + root.confirm_name + "”?"
                        : "Remove “" + root.confirm_name + "”?";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm_kind == "reset"
                        ? "The current token will stop working. The device receives a new one the next time it connects."
                        : root.security_enabled
                        ? "It is disconnected and can no longer connect to this relay."
                        : "It is taken off the allowlist.";
                    color: Theme.text-2;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { height: 14px; }
                HorizontalLayout {
                    spacing: 8px;
                    Btn {
                        horizontal-stretch: 1;
                        height: 30px;
                        label: "Cancel";
                        clicked => { root.confirm_kind = ""; }
                    }
                    Btn {
                        horizontal-stretch: 1;
                        height: 30px;
                        kind: "acc";
                        label: root.confirm_kind == "reset" ? "Reset Token" : "Remove";
                        clicked => {
                            if (root.confirm_kind == "reset") {
                                root.reset_device(root.confirm_id);
                            } else {
                                root.remove_device(root.confirm_id);
                            }
                            root.confirm_kind = "";
                        }
                    }
                }
            }
        }
    }
}
