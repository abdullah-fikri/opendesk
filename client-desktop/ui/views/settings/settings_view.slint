// Settings (admin edition): a sidebar with four panes, in two groups.
// - Relay, stored on the relay for every device: Security manages the relay's device allowlist (client tokens,
//   docs/features/device-security.md at the repository root): listed devices receive their token automatically
//   on their first connection, so clients only need the relay address.
// - This device, stored in the local config.json: Server (relay address, viewing performance), Audio (microphone,
//   client-desktop/docs/features/voice.md) and Mouse (pointer lock, `mouse-relative` in docs/protocol.md).
// In a narrow window the sidebar becomes a row of tabs above the pane.

import { SecurityItem } from "../../types.slint";
import { Theme, Icons } from "../../theme.slint";
import { Icon } from "../../components/icon.slint";
import { SolidIcon } from "../../components/solid_icon.slint";
import { Segment } from "../../components/segment.slint";
import { ScrollArea } from "../../components/scroll_area.slint";

// Entry of the sidebar (wide) or tab strip (narrow).
component NavItem inherits Rectangle {
    in property <string> label;
    in property <int> kind: 0;
    in property <bool> active: false;
    in property <bool> tab: false;
    callback clicked();

    height: root.tab ? 34px : 38px;
    horizontal-stretch: root.tab ? 1 : 0;
    border-radius: Theme.radius-md;
    background: root.active ? #ffffff14 : ta.has-hover ? #ffffff0a : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.tab ? 8px : 12px;
        padding-right: 8px;
        spacing: 10px;
        alignment: root.tab ? center : start;
        SolidIcon {
            y: (parent.height - self.height) / 2;
            kind: root.kind;
            size: 20px;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.text-2;
            font-size: 13px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Small on/off switch.
component Switch inherits Rectangle {
    in property <bool> on: false;
    in property <bool> enabled: true;
    callback toggled();

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : Theme.input;
    border-width: 1px;
    border-color: root.on ? Theme.accent : #ffffff1f;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        x: root.on ? parent.width - self.width - 4px : 3px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.on ? #ffffff : #a6a6b0;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.toggled();
            }
        }
    }
}

// Text button in the settings panes.
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    min-width: txt.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? #ffffff08
        : root.primary ? (ta.has-hover ? Theme.accent-hover : Theme.accent)
        : ta.has-hover ? Theme.hover : #ffffff0d;
    border-width: root.primary && root.enabled ? 0px : 1px;
    border-color: Theme.divider;

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    txt := Text {
        text: root.label;
        color: !root.enabled ? Theme.text-3 : root.primary ? #ffffff : root.danger ? #f87171 : Theme.text;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// A setting: solid icon tile, title and description on the left, the control (@children) on the right.
component SettingCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <int> kind: 0;
    in property <color> frame: #ffffff0b;
    in property <length> control_width: 0px;

    min-height: 70px;
    border-radius: Theme.radius-md;
    background: card-ta.has-hover ? #ffffff0f : #ffffff0a;
    border-width: 1px;
    border-color: root.frame;

    card-ta := TouchArea { }

    HorizontalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;

        VerticalLayout {
            width: 24px;
            alignment: center;
            SolidIcon {
                kind: root.kind;
                size: 24px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: root.description;
                color: Theme.text-3;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            width: root.control_width > 0px ? root.control_width : 40px;
            alignment: center;
            @children
        }
    }
}

// Heading of a pane.
component PageTitle inherits Text {
    color: Theme.text;
    font-size: 22px;
    font-weight: 700;
}

// "Administrator" checkbox of the add row.
component AdminCheck inherits Rectangle {
    in-out property <bool> checked: false;

    width: row.preferred-width + 16px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? #ffffff0a : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
    row := HorizontalLayout {
        x: 8px;
        spacing: 7px;
        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.text-3;
            background: root.checked ? Theme.accent : transparent;
        }
        Text {
            text: "Administrator";
            color: Theme.text-2;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// "Add a device" row of the allowlist. In a narrow window the options go on a second row.
component AddBar inherits VerticalLayout {
    in property <bool> narrow: false;
    in property <bool> relay_online: false;
    in-out property <bool> as_admin: false;
    callback add_device(string, bool);
    callback add_online();

    spacing: 8px;

    HorizontalLayout {
        spacing: 8px;
        height: 36px;
        Rectangle {
            horizontal-stretch: 1;
            min-width: 80px;
            border-radius: Theme.radius-md;
            background: Theme.input;
            border-width: 1px;
            border-color: id-input.has-focus ? Theme.accent : Theme.divider;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                Rectangle {
                    if id-input.text == "": Text {
                        width: parent.width;
                        height: parent.height;
                        text: "Device ID, e.g. 123 456 789";
                        color: Theme.text-3;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    id-input := TextInput {
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => {
                            if (self.text != "") {
                                root.add_device(self.text, root.as_admin);
                                self.text = "";
                            }
                        }
                    }
                }
            }
        }
        if !root.narrow: AdminCheck {
            checked <=> root.as_admin;
        }
        ActionButton {
            label: "Add";
            primary: true;
            enabled: id-input.text != "" && root.relay_online;
            clicked => {
                root.add_device(id-input.text, root.as_admin);
                id-input.text = "";
            }
        }
        if !root.narrow: ActionButton {
            label: "Add all online devices";
            enabled: root.relay_online;
            clicked => { root.add_online(); }
        }
    }
    if root.narrow: HorizontalLayout {
        spacing: 8px;
        height: 32px;
        AdminCheck {
            checked <=> root.as_admin;
        }
        Rectangle { horizontal-stretch: 1; }
        ActionButton {
            label: "Add all online devices";
            enabled: root.relay_online;
            clicked => { root.add_online(); }
        }
    }
}

export component SettingsView inherits Rectangle {
    // 0 = Security, 1 = Server, 2 = Audio, 3 = Mouse.
    in-out property <int> page: 0;
    // Server pane: the relay address and the viewer performance preset (0 = Low, 1 = Medium, 2 = High).
    in-out property <string> gateway_url: "";
    in property <int> performance: 1;
    callback save_gateway_url(string);
    callback save_performance(int);
    // This device: the microphone is on when a session starts.
    in property <bool> mic_on_at_start: true;
    callback set_mic_on_at_start(bool);
    // This device: a game on the host that captures the mouse locks the pointer here (relative motion).
    in property <bool> pointer_lock: false;
    callback set_pointer_lock(bool);
    // The relay supports the device allowlist (known once registered).
    in property <bool> relay_online: false;
    in property <bool> security_supported: false;
    in property <bool> security_enabled: false;
    in property <bool> security_managed_by_env: false;
    in property <[SecurityItem]> security_items;

    callback close();
    callback refresh();
    callback set_enabled(bool);
    // (desk ID as typed, administrator)
    callback add_device(string, bool);
    callback add_online();
    callback remove_device(string);
    callback reset_device(string);

    property <bool> confirm_enable: false;
    property <string> confirm_remove: "";
    property <bool> add_admin: false;
    property <int> picked_perf: root.performance;
    property <bool> gateway_saved: false;
    // Sidebar becomes a row of tabs below this width.
    property <bool> narrow: root.width < 640px;

    function go(p: int) {
        root.confirm_enable = false;
        root.confirm_remove = "";
        root.page = p;
        if (p == 0) {
            root.refresh();
        }
    }

    background: Theme.bg;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ---- Narrow window: back and the pane tabs on top
        if root.narrow: Rectangle {
            background: Theme.bg;
            height: 96px;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                HorizontalLayout {
                    height: 30px;
                    spacing: 10px;
                    Rectangle {
                        width: back-row.preferred-width + 20px;
                        border-radius: Theme.radius-sm;
                        background: back-ta.has-hover ? #ffffff14 : transparent;
                        back-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close(); }
                        }
                        back-row := HorizontalLayout {
                            x: 8px;
                            spacing: 7px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                size: 13px;
                                commands: Icons.back;
                                tint: Theme.text-2;
                            }
                            Text {
                                text: "Back";
                                color: Theme.text-2;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: "OpenDesk Settings";
                        color: Theme.text-3;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    NavItem { tab: true; kind: 0; label: "Security"; active: root.page == 0; clicked => { root.go(0); } }
                    NavItem { tab: true; kind: 1; label: "Server"; active: root.page == 1; clicked => { root.go(1); } }
                    NavItem { tab: true; kind: 2; label: "Audio"; active: root.page == 2; clicked => { root.go(2); } }
                    NavItem { tab: true; kind: 3; label: "Mouse"; active: root.page == 3; clicked => { root.go(3); } }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;

            // ---- Sidebar
            if !root.narrow: Rectangle {
                width: 232px;
                horizontal-stretch: 0;
                background: Theme.bg;

                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    alignment: start;

                    Rectangle {
                        height: 34px;
                        border-radius: Theme.radius-md;
                        background: back-ta2.has-hover ? #ffffff14 : transparent;
                        back-ta2 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close(); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 8px;
                            alignment: start;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                size: 14px;
                                commands: Icons.back;
                                tint: Theme.text-2;
                            }
                            Text {
                                text: "Back";
                                color: Theme.text-2;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // OpenDesk logo and name
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 10px;
                        alignment: start;
                        Image {
                            width: 30px;
                            height: 30px;
                            source: @image-url("../../icon.png");
                            image-fit: contain;
                        }
                        Text {
                            text: "OpenDesk";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "RELAY";
                        color: Theme.text-3;
                        font-size: 10.5px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                    }
                    NavItem { kind: 0; label: "Security"; active: root.page == 0; clicked => { root.go(0); } }

                    Rectangle { height: 10px; }
                    Text {
                        text: "THIS DEVICE";
                        color: Theme.text-3;
                        font-size: 10.5px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                    }
                    NavItem { kind: 1; label: "Server"; active: root.page == 1; clicked => { root.go(1); } }
                    NavItem { kind: 2; label: "Audio"; active: root.page == 2; clicked => { root.go(2); } }
                    NavItem { kind: 3; label: "Mouse"; active: root.page == 3; clicked => { root.go(3); } }
                }
            }
            // ---- Stage
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                clip: true;

                // ---- Security
                if root.page == 0: VerticalLayout {
                    padding: root.narrow ? 14px : 32px;
                    padding-top: root.narrow ? 14px : 28px;
                    spacing: 14px;

                    PageTitle { text: "Security"; }

                    if !root.security_supported: Rectangle {
                        height: 44px;
                        border-radius: Theme.radius-md;
                        background: Theme.accent-soft;
                        border-width: 1px;
                        border-color: Theme.accent;
                        Text {
                            x: 14px;
                            width: parent.width - 28px;
                            text: !root.relay_online ? "Waiting for the relay…" : "This relay does not support client tokens. Update the relay to use them.";
                            color: #fca5a5;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    if root.security_supported: VerticalLayout {
                        spacing: 8px;
                        SettingCard {
                            kind: 0;
                            title: "Client token allowlist";
                            description: root.security_enabled
                                ? "Only devices you list can connect to this relay; each receives its token automatically on first connection."
                                : "Off: any device that knows the relay address can connect.";
                            frame: root.security_enabled ? #dc262666 : #ffffff0b;
                            Switch {
                                on: root.security_enabled;
                                enabled: root.relay_online;
                                toggled => {
                                    if (root.security_enabled) {
                                        root.set_enabled(false);
                                    } else {
                                        root.confirm_enable = true;
                                    }
                                }
                            }
                        }
                        if root.confirm_enable: Rectangle {
                            border-radius: Theme.radius-md;
                            background: #f59e0b14;
                            border-width: 1px;
                            border-color: #f59e0b55;
                            HorizontalLayout {
                                padding: 10px;
                                padding-left: 14px;
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Devices that are not on the list are disconnected right away. This device is added as an administrator.";
                                    color: Theme.wait;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                ActionButton {
                                    y: (parent.height - self.height) / 2;
                                    label: "Cancel";
                                    clicked => { root.confirm_enable = false; }
                                }
                                ActionButton {
                                    y: (parent.height - self.height) / 2;
                                    label: "Turn on";
                                    primary: true;
                                    clicked => {
                                        root.confirm_enable = false;
                                        root.set_enabled(true);
                                    }
                                }
                            }
                        }
                    }

                    if root.security_supported && root.security_managed_by_env: Text {
                        text: "The relay also has OPENDESK_DEVICE_CREDENTIALS set: those devices always need the token configured there, and the list below applies to every other device.";
                        color: Theme.wait;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // Client token off: the list is dimmed and cannot be used (the HTML reference also blurs it).
                    if root.security_supported: Rectangle {
                        vertical-stretch: 1;
                        opacity: root.security_enabled ? 1.0 : 0.38;
                        animate opacity { duration: 150ms; }
                        VerticalLayout {
                            spacing: 14px;
                            Text {
                                text: "Allowed devices on this relay";
                                color: Theme.text-2;
                                font-size: 12px;
                                font-weight: 700;
                            }

                            AddBar {
                                narrow: root.narrow;
                                relay_online: root.relay_online;
                                as_admin <=> root.add_admin;
                                add_device(id, admin) => { root.add_device(id, admin); }
                                add_online => { root.add_online(); }
                            }

                            // Allowed devices
                            Rectangle {
                                vertical-stretch: 1;
                                min-height: 110px;
                                border-radius: Theme.radius-lg;
                                background: #ffffff08;
                                border-width: 1px;
                                border-color: Theme.divider;
                                clip: true;
                                ScrollArea {
                                    spacing: 6px;

                                    Rectangle { height: 4px; }
                                    if root.security_items.length == 0: Text {
                                        height: 60px;
                                        text: "No device is listed yet. Add device IDs above, or add every device that is online now.";
                                        color: Theme.text-3;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                    for d in root.security_items: Rectangle {
                                        height: 52px;
                                        x: 8px;
                                        width: parent.width - 8px;
                                        border-radius: Theme.radius-md;
                                        background: #ffffff0a;
                                        border-width: 1px;
                                        border-color: root.confirm_remove == d.desk_id ? Theme.accent : Theme.divider;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 10px;
                                            spacing: 10px;
                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                y: (parent.height - self.height) / 2;
                                                background: d.online ? Theme.ok : #52525b;
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                alignment: center;
                                                spacing: 2px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: d.name != "" ? d.name + "  •  " + d.desk_id : d.desk_id;
                                                        color: Theme.text;
                                                        font-size: 12.5px;
                                                        font-weight: 600;
                                                        overflow: elide;
                                                    }
                                                    if d.admin: Rectangle {
                                                        width: adm-txt.preferred-width + 12px;
                                                        height: 16px;
                                                        border-radius: 4px;
                                                        background: Theme.accent-soft;
                                                        adm-txt := Text {
                                                            text: "ADMIN";
                                                            color: #fca5a5;
                                                            font-size: 9px;
                                                            font-weight: 700;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                Text {
                                                    text: root.confirm_remove == d.desk_id
                                                        ? (root.security_enabled ? "Remove this device? It is disconnected and can no longer connect." : "Remove this device from the list?")
                                                        : d.enrolled ? "Token issued " + d.enrolled_at
                                                        : "Waiting for its first connection; it receives its token then";
                                                    color: root.confirm_remove == d.desk_id ? Theme.wait : d.enrolled ? Theme.text-3 : Theme.wait;
                                                    font-size: 10.5px;
                                                    overflow: elide;
                                                }
                                            }
                                            if root.confirm_remove != d.desk_id && d.enrolled: ActionButton {
                                                y: (parent.height - self.height) / 2;
                                                height: 28px;
                                                label: "Reset token";
                                                enabled: root.relay_online;
                                                clicked => { root.reset_device(d.desk_id); }
                                            }
                                            if root.confirm_remove != d.desk_id: ActionButton {
                                                y: (parent.height - self.height) / 2;
                                                height: 28px;
                                                label: "Remove";
                                                danger: true;
                                                enabled: root.relay_online;
                                                clicked => { root.confirm_remove = d.desk_id; }
                                            }
                                            if root.confirm_remove == d.desk_id: ActionButton {
                                                y: (parent.height - self.height) / 2;
                                                height: 28px;
                                                label: "Cancel";
                                                clicked => { root.confirm_remove = ""; }
                                            }
                                            if root.confirm_remove == d.desk_id: ActionButton {
                                                y: (parent.height - self.height) / 2;
                                                height: 28px;
                                                label: "Remove";
                                                primary: true;
                                                clicked => {
                                                    root.confirm_remove = "";
                                                    root.remove_device(d.desk_id);
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 4px; }
                                }
                            }

                            Text {
                                text: "Reset token: use it when a device was reinstalled and lost its token; its next connection receives a new one.";
                                color: Theme.text-3;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                        if !root.security_enabled: TouchArea { }
                    }

                    if !root.security_supported: Rectangle { vertical-stretch: 1; }
                }

                // ---- Server
                if root.page == 1: VerticalLayout {
                    padding: root.narrow ? 14px : 32px;
                    padding-top: root.narrow ? 14px : 28px;
                    spacing: 14px;
                    alignment: start;

                    PageTitle { text: "Server"; }

                    Rectangle {
                        border-radius: Theme.radius-lg;
                        background: #ffffff0a;
                        border-width: 1px;
                        border-color: Theme.divider;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            Text {
                                text: "Relay gateway address";
                                color: Theme.text;
                                font-size: 13.5px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Server used to discover devices and relay encrypted sessions when direct P2P is unavailable.";
                                color: Theme.text-3;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                height: 36px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 60px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.input;
                                    border-width: 1px;
                                    border-color: gw-input.has-focus ? Theme.accent : Theme.divider;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        gw-input := TextInput {
                                            text <=> root.gateway_url;
                                            color: Theme.text;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            single-line: true;
                                            edited => { root.gateway_saved = false; }
                                            accepted => {
                                                root.save_gateway_url(self.text);
                                                root.gateway_saved = true;
                                            }
                                        }
                                    }
                                }
                                ActionButton {
                                    label: root.gateway_saved ? "Saved" : "Save";
                                    primary: true;
                                    clicked => {
                                        root.save_gateway_url(gw-input.text);
                                        root.gateway_saved = true;
                                    }
                                }
                            }
                        }
                    }

                    SettingCard {
                        kind: 1;
                        title: "Performance when viewing";
                        description: root.picked_perf == 0 ? "Saves CPU, battery and data (30 FPS). Applies to open sessions at once."
                            : root.picked_perf == 2 ? "Smoothest, follows your monitor's refresh rate. Applies to open sessions at once."
                            : "Balanced for everyday work (60 FPS). Applies to open sessions at once.";
                        control_width: root.narrow ? 200px : 240px;
                        HorizontalLayout {
                            spacing: 4px;
                            height: 30px;
                            Segment {
                                label: "Low";
                                selected: root.picked_perf == 0;
                                clicked => {
                                    root.picked_perf = 0;
                                    root.save_performance(0);
                                }
                            }
                            Segment {
                                label: "Medium";
                                selected: root.picked_perf == 1;
                                clicked => {
                                    root.picked_perf = 1;
                                    root.save_performance(1);
                                }
                            }
                            Segment {
                                label: "High";
                                selected: root.picked_perf == 2;
                                clicked => {
                                    root.picked_perf = 2;
                                    root.save_performance(2);
                                }
                            }
                        }
                    }
                }

                // ---- Audio
                if root.page == 2: VerticalLayout {
                    padding: root.narrow ? 14px : 32px;
                    padding-top: root.narrow ? 14px : 28px;
                    spacing: 14px;
                    alignment: start;

                    PageTitle { text: "Audio"; }
                    SettingCard {
                        kind: 2;
                        title: "Microphone when a session starts";
                        description: root.mic_on_at_start
                            ? "On: the other side hears you as soon as a session starts. The microphone button in a session still turns it off."
                            : "Off: turn it on with the microphone button when you want to talk.";
                        Switch {
                            on: root.mic_on_at_start;
                            toggled => { root.set_mic_on_at_start(!root.mic_on_at_start); }
                        }
                    }
                    Text {
                        text: "Applies to every new session on this computer, whether you control another device or someone controls this one.";
                        color: Theme.text-3;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                // ---- Mouse
                if root.page == 3: VerticalLayout {
                    padding: root.narrow ? 14px : 32px;
                    padding-top: root.narrow ? 14px : 28px;
                    spacing: 14px;
                    alignment: start;

                    PageTitle { text: "Mouse"; }
                    SettingCard {
                        kind: 3;
                        title: "Pointer lock for games";
                        description: root.pointer_lock
                            ? "On: games that capture the mouse get relative movement. Hold Ctrl+Alt to release."
                            : "Off: the mouse always moves the remote pointer to where yours is.";
                        Switch {
                            on: root.pointer_lock;
                            toggled => { root.set_pointer_lock(!root.pointer_lock); }
                        }
                    }
                    Text {
                        text: "When a game or 3D program on the remote computer hides and captures the mouse (mouse look), OpenDesk locks your pointer inside the session window and sends movement instead of positions. Click the remote screen to lock it again. Applies at once, also to open sessions.";
                        color: Theme.text-3;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
