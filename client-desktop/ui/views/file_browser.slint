// File browser: this computer on the left, the remote device on the right. Opened from a device's context menu
// without a remote screen (a files-only session, see service::viewer::controller::request_files). Rust fills both
// panes (src/ui/file_browser_model.rs) and owns the selection; copies run as ordinary transfers in the transfer
// panel, over the direct TCP file channel whenever it is up.
//
// Works like Finder / Explorer: click selects, Ctrl/Cmd+click toggles, Shift+click selects a range; arrows (+Shift),
// Home/End, Ctrl+A, Esc, Enter opens, F2 renames, Delete deletes (after a confirmation), Backspace goes back,
// Alt+Up goes to the parent, F5 refreshes. Double-click opens a folder or a file (a remote file is downloaded to a
// temporary folder first). Dragging rows onto the other pane copies the whole selection; a right click opens the
// glass context menu; column headers sort. Files dropped from Explorer go to the open remote folder (Rust).

import { Theme } from "../theme.slint";
import { Btn, Card, Pop } from "../components/controls.slint";
import { ScrollArea } from "../components/scroll_area.slint";
import { Glyph } from "../components/glyph.slint";
import { GlassMenu, GlassItem, GlassSep } from "../components/menu.slint";
import { FileRow } from "../types.slint";

// One file or folder: icon, name, size and date. Reports clicks (0 plain, 1 Ctrl/Cmd, 2 Shift), double clicks,
// drags and right clicks; the drag and menu positions are window coordinates.
component Row inherits Rectangle {
    in property <FileRow> item;
    in property <bool> last;
    callback select(int);
    callback open();
    callback pressed();
    callback drag-start();
    callback drag-move(length, length);
    callback drag-end(length, length);
    callback menu(length, length);

    property <bool> dragging: false;
    property <length> press-x;
    property <length> press-y;

    height: 36px;
    border-radius: 7px;
    background: root.item.selected ? (Theme.dark ? #5B9BF04d : #2F7BF02e) : ta.has-hover ? Theme.hover-soft : transparent;

    ta := TouchArea {
        mouse-cursor: root.dragging ? MouseCursor.copy : MouseCursor.default;
        double-clicked => { root.open(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pressed();
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                root.dragging = false;
                if (e.modifiers.shift) {
                    root.select(2);
                } else if (e.modifiers.control || e.modifiers.meta) {
                    root.select(1);
                } else if (!root.item.selected) {
                    root.select(0);
                }
            } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                if (root.dragging) {
                    root.dragging = false;
                    root.drag-end(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                } else if (!e.modifiers.control && !e.modifiers.meta && !e.modifiers.shift) {
                    // A plain click on a row of a multiple selection keeps only that row (a drag keeps them all).
                    root.select(0);
                }
            } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.pressed();
                if (!root.item.selected) {
                    root.select(0);
                }
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        moved => {
            if (self.pressed && !root.dragging
                && (abs(self.mouse-x - root.press-x) > 6px || abs(self.mouse-y - root.press-y) > 6px)) {
                root.dragging = true;
                root.drag-start();
            }
            if (root.dragging) {
                root.drag-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 12px;
        Glyph {
            y: (parent.height - self.height) / 2;
            name: root.item.is-dir ? "folder" : "file";
            size: root.item.is-dir ? 19px : 17px;
            tint: root.item.is-dir ? Theme.blue : Theme.text-3;
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.name;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 74px;
            text: root.item.size-text;
            color: Theme.text-3;
            font-size: 11.5px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 104px;
            text: root.item.date-text;
            color: Theme.text-3;
            font-size: 11.5px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    if !root.last && !root.item.selected: Rectangle {
        x: 41px;
        y: root.height - 0.5px;
        width: root.width - 49px;
        height: 0.5px;
        background: Theme.line;
    }
}

// A sortable column title; the active one shows its direction.
component Header inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> descending;
    in property <bool> right;
    callback clicked();
    height: 22px;
    HorizontalLayout {
        alignment: root.right ? LayoutAlignment.end : LayoutAlignment.start;
        spacing: 3px;
        Text {
            text: root.label;
            color: root.active ? Theme.text-2 : Theme.text-3;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.active: Glyph {
            y: (parent.height - self.height) / 2;
            name: root.descending ? "chevron-down" : "chevron-up";
            size: 9px;
            tint: Theme.text-2;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Pane inherits Card {
    in property <string> title;
    in property <string> icon;
    in property <string> path;
    in property <[FileRow]> rows;
    // "Loading…", an error, or "".
    in property <string> note;
    // "24 items" / "3 of 24 selected · 4.2 MB".
    in property <string> footer;
    in property <bool> can-up;
    in property <bool> can-back;
    in property <bool> enabled: true;
    in property <int> selected;
    // The focused row (arrow keys), -1 = none; scrolled into view when it changes.
    in property <int> cursor: -1;
    // The name of the only selected item ("" unless exactly one is), for Rename.
    in property <string> single-name;
    in property <int> sort-key;
    in property <bool> sort-desc;
    // A drag from the other pane hovers here.
    in property <bool> drop-hot;
    // The inline name field: "" (hidden), "new" (New Folder) or "rename".
    in-out property <string> naming;
    callback up();
    callback back();
    callback go(string);
    callback select(int, int);
    callback open(int);
    callback mkdir(string);
    callback rename(string);
    callback action(string);
    callback sort(int);
    callback escape();
    callback delete-request();
    callback drag-start(int);
    callback drag-move(length, length);
    callback drag-end(length, length);
    callback menu(int, length, length);

    public function focus-list() {
        keys.focus();
    }

    public function start-rename() {
        if (root.single-name != "") {
            root.naming = "rename";
        }
    }

    changed cursor => {
        if (root.cursor >= 0) {
            list.reveal(root.cursor * 36px, 36px);
        }
    }

    clip: true;
    border-width: root.drop-hot ? 2px : keys.has-focus ? 1px : (Theme.dark ? 0.5px : 0px);
    border-color: root.drop-hot ? Theme.blue : keys.has-focus ? Theme.ring : Theme.card-edge;

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.UpArrow && (e.modifiers.alt || e.modifiers.control || e.modifiers.meta)) {
                root.up();
            } else if (e.text == Key.UpArrow) {
                root.action(e.modifiers.shift ? "up-extend" : "up");
            } else if (e.text == Key.DownArrow) {
                root.action(e.modifiers.shift ? "down-extend" : "down");
            } else if (e.text == Key.PageUp) {
                root.action(e.modifiers.shift ? "page-up-extend" : "page-up");
            } else if (e.text == Key.PageDown) {
                root.action(e.modifiers.shift ? "page-down-extend" : "page-down");
            } else if (e.text == Key.Home) {
                root.action(e.modifiers.shift ? "home-extend" : "home");
            } else if (e.text == Key.End) {
                root.action(e.modifiers.shift ? "end-extend" : "end");
            } else if (e.text == Key.Return) {
                root.action("open");
            } else if (e.text == Key.Escape) {
                if (root.selected > 0) {
                    root.action("clear");
                } else {
                    root.escape();
                }
            } else if ((e.modifiers.control || e.modifiers.meta) && (e.text == "a" || e.text == "A")) {
                root.action("all");
            } else if (e.text == Key.F2) {
                root.start-rename();
            } else if (e.text == Key.Delete) {
                if (root.selected > 0) {
                    root.delete-request();
                }
            } else if (e.text == Key.Backspace) {
                root.back();
            } else if (e.text == Key.F5) {
                root.action("refresh");
            } else {
                return reject;
            }
            accept
        }

        VerticalLayout {
            padding: 12px;
            padding-bottom: 8px;
            spacing: 8px;

            // Where: back, up, the side's name, and the folder as a typed path
            HorizontalLayout {
                spacing: 4px;
                height: 32px;
                Btn {
                    y: (parent.height - self.height) / 2;
                    kind: "ghost";
                    icon: "chevron-left";
                    icon-size: 14px;
                    tip: "Back";
                    enabled: root.can-back && root.enabled;
                    clicked => { root.back(); }
                }
                Btn {
                    y: (parent.height - self.height) / 2;
                    kind: "ghost";
                    icon: "chevron-up";
                    icon-size: 14px;
                    tip: "Enclosing folder";
                    enabled: root.can-up && root.enabled;
                    clicked => { root.up(); }
                }
                Rectangle { width: 4px; }
                Glyph {
                    y: (parent.height - self.height) / 2;
                    name: root.icon;
                    size: 15px;
                    tint: Theme.text-2;
                }
                Rectangle { width: 4px; }
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    max-width: 200px;
                    overflow: elide;
                }
                Rectangle { width: 6px; }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 9px;
                    background: Theme.field;
                    border-width: path-input.has-focus ? 2px : 0px;
                    border-color: Theme.ring;
                    if path-input.text == "": Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: "Drives";
                        color: Theme.text-3;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    path-input := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: root.path;
                        enabled: root.enabled;
                        color: Theme.text-2;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => {
                            root.go(self.text);
                            keys.focus();
                        }
                    }
                }
            }

            // New folder or rename, from the context menu or F2
            if root.naming != "": HorizontalLayout {
                spacing: 6px;
                height: 32px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 9px;
                    background: Theme.field;
                    border-width: 2px;
                    border-color: Theme.ring;
                    if name-input.text == "": Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: root.naming == "rename" ? "New name" : "Folder name";
                        color: Theme.text-3;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    name-input := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        color: Theme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                        init => {
                            if (root.naming == "rename") {
                                self.text = root.single-name;
                                self.select-all();
                            }
                            self.focus();
                        }
                        accepted => { commit.clicked(); }
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                root.naming = "";
                                keys.focus();
                                return accept;
                            }
                            reject
                        }
                    }
                }
                commit := Btn {
                    label: root.naming == "rename" ? "Rename" : "Create";
                    kind: "acc";
                    enabled: name-input.text != "";
                    clicked => {
                        if (name-input.text != "") {
                            if (root.naming == "rename") {
                                root.rename(name-input.text);
                            } else {
                                root.mkdir(name-input.text);
                            }
                        }
                        root.naming = "";
                        keys.focus();
                    }
                }
                Btn {
                    label: "Cancel";
                    kind: "ghost";
                    clicked => {
                        root.naming = "";
                        keys.focus();
                    }
                }
            }

            // Column headers (click to sort); aligned with the row columns
            HorizontalLayout {
                height: 22px;
                padding-left: 41px;
                padding-right: 22px;
                spacing: 12px;
                Header {
                    horizontal-stretch: 1;
                    label: "Name";
                    active: root.sort-key == 0;
                    descending: root.sort-desc;
                    clicked => { root.sort(0); }
                }
                Header {
                    width: 74px;
                    right: true;
                    label: "Size";
                    active: root.sort-key == 1;
                    descending: root.sort-desc;
                    clicked => { root.sort(1); }
                }
                Header {
                    width: 104px;
                    right: true;
                    label: "Modified";
                    active: root.sort-key == 2;
                    descending: root.sort-desc;
                    clicked => { root.sort(2); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                // Empty space: a left click clears the selection, a right click opens the menu without a row.
                TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            keys.focus();
                            if (e.button == PointerEventButton.right) {
                                root.menu(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            } else if (e.button == PointerEventButton.left && !e.modifiers.control && !e.modifiers.meta) {
                                root.action("clear");
                            }
                        }
                    }
                }
                list := ScrollArea {
                    spacing: 0px;
                    for row[i] in root.rows: Row {
                        item: row;
                        last: i == root.rows.length - 1;
                        pressed => { keys.focus(); }
                        select(mode) => { root.select(i, mode); }
                        open => { root.open(i); }
                        drag-start => { root.drag-start(i); }
                        drag-move(x, y) => { root.drag-move(x, y); }
                        drag-end(x, y) => { root.drag-end(x, y); }
                        menu(x, y) => { root.menu(i, x, y); }
                    }
                }
                if root.note != "": Text {
                    x: 24px;
                    width: parent.width - 48px;
                    height: parent.height;
                    text: root.note;
                    color: Theme.text-3;
                    font-size: 12.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Subtle status line: item count, or what is selected
            Text {
                height: 16px;
                text: root.footer;
                color: Theme.text-3;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Round copy button between the panes.
component Move inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: !root.enabled ? Theme.field : ta.has-hover ? Theme.accent-hover : Theme.accent;
    opacity: root.enabled ? 1.0 : 0.5;
    animate background { duration: 120ms; }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    Glyph {
        name: root.icon;
        size: 18px;
        tint: root.enabled ? #ffffff : Theme.text-3;
    }
}

export component FileBrowser inherits Rectangle {
    background: Theme.bg;
    width: 100%;
    height: 100%;

    in property <string> remote-title;
    // The session for the remote pane is up.
    in property <bool> connected;
    // The host serves rename, delete, extract and compress (newer OpenDesk).
    in property <bool> remote-ops;
    // Local deletes go to the Recycle Bin.
    in property <bool> local-trash;
    // "Show in Explorer" / "Show in Finder" / "Show in Folder".
    in property <string> reveal-label: "Show in Explorer";
    in property <string> local-path;
    in property <string> remote-path;
    in property <[FileRow]> local-rows;
    in property <[FileRow]> remote-rows;
    in property <string> local-note;
    in property <string> remote-note;
    in property <string> local-footer;
    in property <string> remote-footer;
    in property <bool> local-can-up;
    in property <bool> remote-can-up;
    in property <bool> local-can-back;
    in property <bool> remote-can-back;
    in property <int> local-selected;
    in property <int> remote-selected;
    in property <int> local-cursor: -1;
    in property <int> remote-cursor: -1;
    in property <string> local-single;
    in property <string> remote-single;
    in property <int> local-sort;
    in property <int> remote-sort;
    in property <bool> local-sort-desc;
    in property <bool> remote-sort-desc;
    // What the browser last did or why it could not ("" = nothing to say).
    in property <string> status;

    callback close();
    callback local-up();
    callback remote-up();
    callback local-go(string);
    callback remote-go(string);
    callback local-open(int);
    callback remote-open(int);
    callback local-mkdir(string);
    callback remote-mkdir(string);
    callback upload();
    callback download();
    callback refresh();
    // (remote, row, 0 plain / 1 toggle / 2 range)
    callback select(bool, int, int);
    // (remote, what): keys and menu entries without arguments, see file_browser_model::action.
    callback action(bool, string);
    callback rename(bool, string);
    callback delete(bool);
    callback sort(bool, int);

    // Drag between the panes
    property <bool> dragging: false;
    property <bool> drag-from-remote: false;
    property <length> drag-x;
    property <length> drag-y;
    property <bool> over-local: root.dragging && root.drag-from-remote && self.in-local(root.drag-x, root.drag-y);
    property <bool> over-remote: root.dragging && !root.drag-from-remote && self.in-remote(root.drag-x, root.drag-y);
    // Context menu: which pane, which row (-1 = none) and where
    property <bool> menu-remote: false;
    property <int> menu-row: -1;
    property <length> menu-x;
    property <length> menu-y;
    property <int> menu-count: root.menu-remote ? root.remote-selected : root.local-selected;
    property <string> menu-stem: root.menu-row < 0 || root.menu-count != 1 ? ""
        : root.menu-remote ? root.remote-rows[root.menu-row].archive-stem : root.local-rows[root.menu-row].archive-stem;
    // Operations the pane of the menu can do (the remote one only on hosts that serve them)
    property <bool> menu-ops: !root.menu-remote || (root.remote-ops && root.connected);
    // Delete confirmation
    property <bool> confirm-open: false;
    property <bool> confirm-remote: false;
    property <int> confirm-count: root.confirm-remote ? root.remote-selected : root.local-selected;
    property <bool> confirm-trash: !root.confirm-remote && root.local-trash;

    function in-local(x: length, y: length) -> bool {
        return x >= lp.absolute-position.x && x <= lp.absolute-position.x + lp.width
            && y >= lp.absolute-position.y && y <= lp.absolute-position.y + lp.height;
    }

    function in-remote(x: length, y: length) -> bool {
        return x >= rp.absolute-position.x && x <= rp.absolute-position.x + rp.width
            && y >= rp.absolute-position.y && y <= rp.absolute-position.y + rp.height;
    }

    function drop(x: length, y: length) {
        if (root.drag-from-remote && self.in-local(x, y)) {
            root.download();
        } else if (!root.drag-from-remote && self.in-remote(x, y)) {
            root.upload();
        }
        root.dragging = false;
    }

    function open-menu(remote: bool, row: int, x: length, y: length) {
        root.menu-remote = remote;
        root.menu-row = row;
        root.menu-x = max(8px, min(x - root.absolute-position.x, root.width - 250px));
        root.menu-y = max(8px, min(y - root.absolute-position.y, root.height - (row >= 0 ? 430px : 150px)));
        menu.show();
    }

    function ask-delete(remote: bool) {
        if (remote && !(root.remote-ops && root.connected)) {
            return;
        }
        root.confirm-remote = remote;
        root.confirm-open = true;
    }

    function items(n: int) -> string {
        return n == 1 ? "1 item" : n + " items";
    }

    // Swallows clicks below the page; Esc closes it.
    TouchArea { }
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        padding: 18px;
        padding-top: 10px;
        spacing: 12px;

        // Navigation bar: back on the left, the device's name in the middle
        Rectangle {
            height: 40px;
            Btn {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: self.min-width;
                kind: "link";
                icon: "chevron-left";
                label: "Devices";
                clicked => { root.close(); }
            }
            Text {
                x: 140px;
                width: parent.width - 280px;
                height: parent.height;
                text: root.remote-title;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;

            lp := Pane {
                horizontal-stretch: 1;
                title: "This computer";
                icon: "desktop";
                path: root.local-path;
                rows: root.local-rows;
                note: root.local-note;
                footer: root.local-footer;
                can-up: root.local-can-up;
                can-back: root.local-can-back;
                selected: root.local-selected;
                cursor: root.local-cursor;
                single-name: root.local-single;
                sort-key: root.local-sort;
                sort-desc: root.local-sort-desc;
                drop-hot: root.over-local;
                up => { root.local-up(); }
                back => { root.action(false, "back"); }
                go(p) => { root.local-go(p); }
                select(i, mode) => { root.select(false, i, mode); }
                open(i) => { root.local-open(i); }
                mkdir(n) => { root.local-mkdir(n); }
                rename(n) => { root.rename(false, n); }
                action(a) => { root.action(false, a); }
                sort(k) => { root.sort(false, k); }
                escape => { root.close(); }
                delete-request => { root.ask-delete(false); }
                drag-start(i) => {
                    root.drag-from-remote = false;
                    root.dragging = true;
                }
                drag-move(x, y) => {
                    root.drag-x = x;
                    root.drag-y = y;
                }
                drag-end(x, y) => { root.drop(x, y); }
                menu(i, x, y) => { root.open-menu(false, i, x, y); }
            }

            VerticalLayout {
                width: 44px;
                spacing: 12px;
                alignment: center;
                Move {
                    icon: "arrow-right";
                    enabled: root.local-selected > 0 && root.remote-path != "" && root.connected;
                    clicked => { root.upload(); }
                }
                Move {
                    icon: "arrow-left";
                    enabled: root.remote-selected > 0 && root.local-path != "" && root.connected;
                    clicked => { root.download(); }
                }
            }

            rp := Pane {
                horizontal-stretch: 1;
                title: root.remote-title;
                icon: "windows";
                enabled: root.connected;
                path: root.remote-path;
                rows: root.remote-rows;
                note: root.remote-note;
                footer: root.remote-footer;
                can-up: root.remote-can-up;
                can-back: root.remote-can-back;
                selected: root.remote-selected;
                cursor: root.remote-cursor;
                single-name: root.remote-ops ? root.remote-single : "";
                sort-key: root.remote-sort;
                sort-desc: root.remote-sort-desc;
                drop-hot: root.over-remote;
                up => { root.remote-up(); }
                back => { root.action(true, "back"); }
                go(p) => { root.remote-go(p); }
                select(i, mode) => { root.select(true, i, mode); }
                open(i) => { root.remote-open(i); }
                mkdir(n) => { root.remote-mkdir(n); }
                rename(n) => { root.rename(true, n); }
                action(a) => { root.action(true, a); }
                sort(k) => { root.sort(true, k); }
                escape => { root.close(); }
                delete-request => { root.ask-delete(true); }
                drag-start(i) => {
                    root.drag-from-remote = true;
                    root.dragging = true;
                }
                drag-move(x, y) => {
                    root.drag-x = x;
                    root.drag-y = y;
                }
                drag-end(x, y) => { root.drop(x, y); }
                menu(i, x, y) => { root.open-menu(true, i, x, y); }
            }
        }

        if root.status != "": Text {
            text: root.status;
            color: Theme.text-3;
            font-size: 11.5px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    // What is being dragged, under the pointer
    if root.dragging && (root.over-local || root.over-remote): Rectangle {
        x: root.drag-x - root.absolute-position.x + 14px;
        y: root.drag-y - root.absolute-position.y + 10px;
        width: ghost.preferred-width + 24px;
        height: 28px;
        border-radius: 14px;
        background: Theme.blue;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000059;
        ghost := Text {
            text: "Copy " + root.items(root.drag-from-remote ? root.remote-selected : root.local-selected) + " here";
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
        }
    }

    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 240px;
        GlassMenu {
            width: 240px;
            if root.menu-row >= 0: GlassItem {
                label: "Open";
                clicked => {
                    if (root.menu-remote) {
                        root.remote-open(root.menu-row);
                    } else {
                        root.local-open(root.menu-row);
                    }
                }
            }
            if root.menu-row >= 0: GlassItem {
                label: (root.menu-count > 1 ? "Copy " + root.items(root.menu-count) : "Copy")
                    + (root.menu-remote ? " to This Computer" : " to " + root.remote-title);
                enabled: root.connected && (root.menu-remote ? root.local-path != "" : root.remote-path != "");
                clicked => {
                    if (root.menu-remote) {
                        root.download();
                    } else {
                        root.upload();
                    }
                }
            }
            if root.menu-row >= 0 && !root.menu-remote: GlassItem {
                label: root.reveal-label;
                clicked => { root.action(false, "reveal"); }
            }
            if root.menu-row >= 0: GlassItem {
                label: root.menu-count > 1 ? "Copy Paths" : "Copy Path";
                clicked => { root.action(root.menu-remote, "copy-path"); }
            }
            if root.menu-row >= 0: GlassSep { }
            if root.menu-stem != "": GlassItem {
                label: "Extract Here";
                enabled: root.menu-ops;
                clicked => { root.action(root.menu-remote, "extract-here"); }
            }
            if root.menu-stem != "": GlassItem {
                label: "Extract to “" + root.menu-stem + "/”";
                enabled: root.menu-ops;
                clicked => { root.action(root.menu-remote, "extract-folder"); }
            }
            if root.menu-row >= 0: GlassItem {
                label: root.menu-count > 1 ? "Compress " + root.items(root.menu-count) + " to .zip" : "Compress to .zip";
                enabled: root.menu-ops;
                clicked => { root.action(root.menu-remote, "compress"); }
            }
            if root.menu-row >= 0: GlassSep { }
            if root.menu-row >= 0 && root.menu-count == 1: GlassItem {
                label: "Rename…";
                enabled: root.menu-ops;
                clicked => {
                    if (root.menu-remote) {
                        rp.start-rename();
                    } else {
                        lp.start-rename();
                    }
                }
            }
            if root.menu-row >= 0: GlassItem {
                label: !root.menu-remote && root.local-trash ? "Move to Recycle Bin" : "Delete…";
                danger: true;
                enabled: root.menu-ops;
                clicked => { root.ask-delete(root.menu-remote); }
            }
            if root.menu-row < 0: GlassItem {
                label: "New Folder";
                enabled: root.menu-remote ? (root.remote-path != "" && root.connected) : root.local-path != "";
                clicked => {
                    if (root.menu-remote) {
                        rp.naming = "new";
                    } else {
                        lp.naming = "new";
                    }
                }
            }
            if root.menu-row < 0: GlassItem {
                label: "Select All";
                clicked => { root.action(root.menu-remote, "all"); }
            }
            if root.menu-row < 0: GlassItem {
                label: "Refresh";
                clicked => { root.refresh(); }
            }
        }
    }

    // Delete confirmation: a glass sheet over a dimmed page
    if root.confirm-open: Rectangle {
        background: Theme.scrim;
        TouchArea {
            clicked => { root.confirm-open = false; }
        }
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.confirm-open = false;
                    return accept;
                }
                if (e.text == Key.Return) {
                    root.confirm-open = false;
                    root.delete(root.confirm-remote);
                    return accept;
                }
                reject
            }
        }
        Pop {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 340px;
            height: sheet.preferred-height;
            // Keeps clicks on the sheet from closing it.
            TouchArea { }
            sheet := VerticalLayout {
                padding: 20px;
                padding-top: 16px;
                spacing: 8px;
                Glyph {
                    name: root.confirm-trash ? "trash" : "warn";
                    size: 28px;
                    tint: root.confirm-trash ? Theme.text-2 : Theme.accent-tx;
                }
                Text {
                    text: root.confirm-trash
                        ? "Move " + root.items(root.confirm-count) + " to the Recycle Bin?"
                        : "Delete " + root.items(root.confirm-count) + " permanently?";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-trash ? "You can restore them from the Recycle Bin."
                        : root.confirm-remote ? "They are deleted on " + root.remote-title + " right away, folders with everything in them. This cannot be undone."
                        : "Folders are deleted with everything in them. This cannot be undone.";
                    color: Theme.text-2;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 8px;
                    alignment: center;
                    Btn {
                        label: "Cancel";
                        clicked => { root.confirm-open = false; }
                    }
                    Btn {
                        label: root.confirm-trash ? "Move to Recycle Bin" : "Delete";
                        kind: "acc";
                        clicked => {
                            root.confirm-open = false;
                            root.delete(root.confirm-remote);
                        }
                    }
                }
            }
        }
    }
}
