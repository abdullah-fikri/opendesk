// One tab of the session strip: a rounded tab with the connection dot, the device name and a close button.
// The selected tab is raised (surface colour and soft shadow), like the redesign's segments.

import { SessionView } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { Glyph } from "../../components/glyph.slint";
import { TipBox } from "../../components/controls.slint";

export component SessionTab inherits Rectangle {
    in property <SessionView> session;
    in property <bool> selected: false;
    callback select();
    callback close();

    height: 30px;
    min-width: 120px;
    max-width: 220px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: root.selected ? Theme.surf : ta.has-hover ? Theme.hover-soft : transparent;
    drop-shadow-blur: root.selected ? 6px : 0px;
    drop-shadow-offset-y: root.selected ? 1px : 0px;
    drop-shadow-color: root.selected ? Theme.shadow : transparent;
    border-width: root.selected && Theme.dark ? 0.5px : 0px;
    border-color: Theme.card-edge;
    animate background { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            // Middle click closes the tab, like a browser.
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle) {
                root.close();
            }
        }
        clicked => { root.select(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 5px;
        spacing: 8px;

        Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 3.5px;
            background: Theme.session-dot(root.session.connecting, root.session.path);
        }
        Text {
            horizontal-stretch: 1;
            text: root.session.title;
            color: root.selected ? Theme.text : Theme.text-2;
            font-size: 12.5px;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: close-ta.has-hover ? Theme.hover2 : transparent;
            // Shown on the selected or hovered tab only, like the design's quiet controls.
            opacity: root.selected || ta.has-hover || close-ta.has-hover ? 1.0 : 0.0;
            close-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close(); }
            }
            Glyph {
                name: "close";
                size: 9px;
                tint: close-ta.has-hover ? Theme.text : Theme.text-2;
            }
        }
    }

    Tooltip {
        TipBox {
            text: root.session.subtitle != "" ? root.session.title + " — " + root.session.subtitle : root.session.title;
        }
    }
}
