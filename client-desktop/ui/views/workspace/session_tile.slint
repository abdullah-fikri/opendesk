// One session's screen in tab or split view.

import { SessionView } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { RemoteViewerCanvas } from "../../components/remote_canvas.slint";

export component SessionTile inherits Rectangle {
    in property <SessionView> s;
    in property <bool> focused: false;
    in property <bool> show_header: false;
    in property <bool> show_stats: false;
    callback activate(string);
    callback mouse_move(string, int, int);
    callback mouse_down(string, int, int, int);
    callback mouse_up(string, int, int, int);
    callback mouse_wheel(string, int, int, int, int);
    callback key_event(string, string, bool, bool, bool, bool, bool);
    callback release_keys(string);
    callback viewport_resized(string, int, int);
    callback frame_rect(string, int, int, int, int);

    background: Theme.canvas;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        if root.show_header: Rectangle {
            height: 28px;
            background: root.focused ? Theme.surf : Theme.surf2;
            hdr-ta := TouchArea {
                mouse-cursor: root.focused ? default : pointer;
                clicked => {
                    if (!root.focused) {
                        root.activate(root.s.id);
                    }
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3.5px;
                    background: Theme.session-dot(root.s.connecting, root.s.path);
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.s.title;
                    color: root.focused ? Theme.text : Theme.text-2;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.s.connecting ? "Connecting…" : root.s.path + " · " + root.s.fps + " fps";
                    color: Theme.text-3;
                    font-size: 11.5px;
                    font-family: Theme.mono;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            RemoteViewerCanvas {
                has_remote_frame: root.s.has_frame;
                remote_frame: root.s.frame;
                remote_cursor: root.s.cursor;
                active_partner_id: root.s.title;
                focused: root.focused;
                auto_focus: true;
                click_to_focus: !root.focused;
                activate => { root.activate(root.s.id); }
                send_mouse_move(nx, ny) => { root.mouse_move(root.s.id, nx, ny); }
                send_mouse_down(nx, ny, b) => { root.mouse_down(root.s.id, nx, ny, b); }
                send_mouse_up(nx, ny, b) => { root.mouse_up(root.s.id, nx, ny, b); }
                send_mouse_wheel(nx, ny, dx, d) => { root.mouse_wheel(root.s.id, nx, ny, dx, d); }
                send_key_event(t, p, r, c, a, sh) => { root.key_event(root.s.id, t, p, r, c, a, sh); }
                release_remote_keys => { root.release_keys(root.s.id); }
                viewport_resized(w, h) => { root.viewport_resized(root.s.id, w, h); }
                frame_rect(x, y, w, h) => { root.frame_rect(root.s.id, x, y, w, h); }
            }

            // Relay connection lost, no live direct path: the last frame stays under this until the session
            // resumes or the grace runs out. No TouchArea: the toolbar's Close keeps working.
            if root.s.reconnecting > 0: Rectangle {
                width: reconnect-text.preferred-width + 36px;
                height: 38px;
                // Always dark glass over the remote picture, whatever the appearance.
                background: #141416e0;
                border-radius: 10px;
                reconnect-text := Text {
                    text: "Reconnecting… (" + root.s.reconnecting + " s)";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                }
            }

            // Stats overlay, top right. It has no TouchArea, so pointer input reaches the canvas below.
            if root.show_stats && root.s.stats_labels != "": Rectangle {
                x: parent.width - self.width - 8px;
                y: 8px;
                width: stats-row.preferred-width;
                height: stats-row.preferred-height;
                background: #141416e0;
                border-radius: 10px;
                stats-row := HorizontalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 14px;
                    Text {
                        text: root.s.stats_labels;
                        color: #ffffff99;
                        font-size: 11.5px;
                    }
                    Text {
                        text: root.s.stats_values;
                        color: #ffffff;
                        font-size: 11.5px;
                        font-family: Theme.mono;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }

    // Focus frame drawn on top so it never shifts the canvas.
    if root.show_header: Rectangle {
        border-width: root.focused ? 2px : 1px;
        border-color: root.focused ? Theme.accent-line : Theme.line;
    }
}

// ---------------------------------------------------------------- Workspace
