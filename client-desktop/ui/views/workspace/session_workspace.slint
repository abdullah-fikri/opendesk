// Viewer sessions as tabs or a split grid (docs/features/viewer-sessions.md).

import { SessionView } from "../../types.slint";
import { Theme, Icons } from "../../theme.slint";
import { Icon } from "../../components/icon.slint";
import { ToolButton } from "../../components/tool_button.slint";
import { Segment } from "../../components/segment.slint";
import { SessionTab } from "session_tab.slint";
import { SessionToolbar } from "session_toolbar.slint";
import { SessionTile } from "session_tile.slint";

export component SessionWorkspace inherits Rectangle {
    in property <[SessionView]> sessions;
    in-out property <string> focused_session;
    in-out property <int> view_layout;
    in-out property <bool> show_new_session;
    in-out property <bool> fullscreen;
    in-out property <bool> show_settings;
    in property <bool> is_relay_online;
    in property <string> status_text;
    // This PC is also being controlled (host side) while viewing.
    in property <bool> host_active: false;
    in property <string> host_partner: "";
    callback end_host_session();

    callback focus_session(string);
    callback close_session(string);
    callback set_view_layout(int);
    callback new_session_page();
    callback session_mouse_move(string, int, int);
    callback session_mouse_down(string, int, int, int);
    callback session_mouse_up(string, int, int, int);
    callback session_mouse_wheel(string, int, int, int);
    callback session_key_event(string, string, bool, bool, bool, bool, bool);
    callback session_release_keys(string);
    callback session_viewport_resized(string, int, int);
    callback select_monitor(string, int);
    callback session_send_files(string);
    callback session_toggle_mic(string);
    callback session_set_privacy(string, int);
    callback session_toggle_block_input(string);
    callback session_set_resolution(string, int);
    callback session_set_audio_quality(string, int);
    // Stats overlay on every session view.
    in-out property <bool> show_stats: false;
    callback set_stats_overlay(bool);
    // Viewers without a system-key hook (outside Windows) send system shortcuts from a menu.
    in property <bool> system_keys_menu: false;
    callback session_shortcut(string, string);

    // Hide the toolbar for maximum remote space (tab strip stays).
    property <bool> toolbar_hidden: false;
    property <int> count: sessions.length;
    property <bool> split: view_layout == 1 && count > 1;

    background: Theme.bg;

    function pick(id: string) {
        root.show_new_session = false;
        if (root.focused_session != id) {
            root.focused_session = id;
        }
        root.focus_session(id);
    }

    function is-shown(id: string, i: int) -> bool {
        return id == root.focused_session || (root.focused_session == "" && i == 0);
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ---- Tab strip
        Rectangle {
            height: 34px;
            background: #0c0c0f;

            HorizontalLayout {
                padding: 0px;
                spacing: 0px;

                // Relay status square (details in the tooltip).
                Rectangle {
                    width: 30px;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        background: root.is_relay_online ? Theme.ok : Theme.accent;
                    }
                    Tooltip {
                        text: @markdown("\{"OpenDesk · " + root.status_text}");
                    }
                }

                for s[i] in root.sessions: SessionTab {
                    session: s;
                    selected: !root.show_new_session && root.is-shown(s.id, i);
                    select => { root.pick(s.id); }
                    close => { root.close_session(s.id); }
                }

                // "+" = new session page (dashboard). Max 4 sessions.
                Rectangle {
                    width: 34px;
                    background: root.show_new_session ? Theme.surface : (plus-ta.has-hover && root.count < 4) ? #141418 : transparent;
                    plus-ta := TouchArea {
                        mouse-cursor: root.count < 4 ? pointer : default;
                        clicked => {
                            if (root.count < 4) {
                                root.show_new_session = true;
                                root.new_session_page();
                            }
                        }
                    }
                    if root.show_new_session: Rectangle {
                        y: 0;
                        height: 2px;
                        background: Theme.accent;
                    }
                    Icon {
                        commands: Icons.plus;
                        tint: root.count < 4 ? (root.show_new_session ? Theme.text : Theme.text-2) : #3f3f46;
                    }
                    Tooltip {
                        text: @markdown("\{root.count < 4 ? "New session" : "At most 4 sessions at once"}");
                    }
                }

                Rectangle { horizontal-stretch: 1; min-width: 8px; }

                // Right group: everything 28px high, centred in the 34px strip.
                HorizontalLayout {
                    padding-top: 3px;
                    padding-bottom: 3px;
                    padding-right: 4px;
                    spacing: 0px;
                    horizontal-stretch: 0;
                    if root.host_active: Rectangle {
                        background: Theme.accent-soft;
                        border-width: 1px;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 2px;
                            spacing: 8px;
                            Text {
                                text: "Controlled by: " + root.host_partner;
                                color: #fca5a5;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: end-txt.preferred-width + 14px;
                                height: 22px;
                                y: (parent.height - self.height) / 2;
                                background: end-ta.has-hover ? Theme.accent-hover : Theme.accent;
                                end-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.end_host_session(); }
                                }
                                end-txt := Text {
                                    text: "End";
                                    color: #ffffff;
                                    font-size: 11px;
                                    font-weight: 600;
                                }
                            }
                        }
                    }
                    if root.host_active: Rectangle { width: 10px; }

                    // Layout toggle Tab / Split
                    HorizontalLayout {
                        padding-top: 1px;
                        padding-bottom: 1px;
                        spacing: 0px;
                        Segment {
                            width: 46px;
                            label: "Tab";
                            selected: !root.split;
                            clicked => {
                                root.view_layout = 0;
                                root.set_view_layout(0);
                            }
                            Rectangle { Tooltip { text: @markdown("One session fills the window"); } }
                        }
                        Segment {
                            width: 46px;
                            label: "Split";
                            enabled: root.count > 1;
                            selected: root.split;
                            clicked => {
                                root.view_layout = 1;
                                root.set_view_layout(1);
                                root.show_new_session = false;
                            }
                            Rectangle { Tooltip { text: @markdown("\{root.count > 1 ? "Show all sessions side by side" : "Open at least 2 sessions to split"}"); } }
                        }
                    }

                    Rectangle { width: 6px; }

                    ToolButton {
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        pad: 0px;
                        icon: root.toolbar_hidden ? Icons.chevron-down : Icons.chevron-up;
                        tip: root.toolbar_hidden ? "Show toolbar" : "Hide toolbar (more screen space)";
                        clicked => { root.toolbar_hidden = !root.toolbar_hidden; }
                    }
                    ToolButton {
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        pad: 0px;
                        icon: root.fullscreen ? Icons.fullscreen-exit : Icons.fullscreen;
                        active: root.fullscreen;
                        tip: root.fullscreen ? "Exit full screen" : "Full screen";
                        clicked => { root.fullscreen = !root.fullscreen; }
                    }
                    ToolButton {
                        y: (parent.height - self.height) / 2;
                        label: "Server";
                        open: root.show_settings;
                        tip: "Relay settings";
                        clicked => { root.show_settings = !root.show_settings; }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.divider;
            }
        }

        // ---- Toolbar for the focused session
        if !root.toolbar_hidden && !root.show_new_session: Rectangle {
            height: 38px;
            for s[i] in root.sessions: Rectangle {
                if root.is-shown(s.id, i): SessionToolbar {
                    s: s;
                    system_keys_menu: root.system_keys_menu;
                    shortcut(id, sc) => { root.session_shortcut(id, sc); }
                    select_monitor(id, idx) => { root.select_monitor(id, idx); }
                    send_files(id) => { root.session_send_files(id); }
                    toggle_mic(id) => { root.session_toggle_mic(id); }
                    set_privacy(id, m) => { root.session_set_privacy(id, m); }
                    toggle_block_input(id) => { root.session_toggle_block_input(id); }
                    set_resolution(id, m) => { root.session_set_resolution(id, m); }
                    set_audio_quality(id, q) => { root.session_set_audio_quality(id, q); }
                    stats_on: root.show_stats;
                    toggle_stats => {
                        root.show_stats = !root.show_stats;
                        root.set_stats_overlay(root.show_stats);
                    }
                    disconnect(id) => { root.close_session(id); }
                }
            }
        }

        // ---- Body
        body := Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: root.show_new_session ? Theme.bg : root.split ? Theme.divider : Theme.canvas;

            property <int> cols: root.count >= 2 ? 2 : 1;
            property <int> rows: root.count >= 3 ? 2 : 1;
            property <length> gap: 2px;
            property <length> tile-w: (self.width - (cols - 1) * gap) / cols;
            property <length> tile-h: (self.height - (rows - 1) * gap) / rows;

            if !root.split && !root.show_new_session: Rectangle {
                for s[i] in root.sessions: Rectangle {
                    if root.is-shown(s.id, i): SessionTile {
                        s: s;
                        focused: true;
                        show_header: false;
                        show_stats: root.show_stats;
                        activate(id) => { root.pick(id); }
                        mouse_move(id, x, y) => { root.session_mouse_move(id, x, y); }
                        mouse_down(id, x, y, b) => { root.session_mouse_down(id, x, y, b); }
                        mouse_up(id, x, y, b) => { root.session_mouse_up(id, x, y, b); }
                        mouse_wheel(id, x, y, d) => { root.session_mouse_wheel(id, x, y, d); }
                        key_event(id, t, p, r, c, a, sh) => { root.session_key_event(id, t, p, r, c, a, sh); }
                        release_keys(id) => { root.session_release_keys(id); }
                        viewport_resized(id, w, h) => { root.session_viewport_resized(id, w, h); }
                    }
                }
            }

            if root.split && !root.show_new_session: Rectangle {
                for s[i] in root.sessions: SessionTile {
                    x: Math.mod(i, body.cols) * (body.tile-w + body.gap);
                    y: floor(i / body.cols) * (body.tile-h + body.gap);
                    width: body.tile-w;
                    height: body.tile-h;
                    s: s;
                    focused: root.is-shown(s.id, i);
                    show_header: true;
                    show_stats: root.show_stats;
                    activate(id) => { root.pick(id); }
                    mouse_move(id, x, y) => { root.session_mouse_move(id, x, y); }
                    mouse_down(id, x, y, b) => { root.session_mouse_down(id, x, y, b); }
                    mouse_up(id, x, y, b) => { root.session_mouse_up(id, x, y, b); }
                    mouse_wheel(id, x, y, d) => { root.session_mouse_wheel(id, x, y, d); }
                    key_event(id, t, p, r, c, a, sh) => { root.session_key_event(id, t, p, r, c, a, sh); }
                    release_keys(id) => { root.session_release_keys(id); }
                    viewport_resized(id, w, h) => { root.session_viewport_resized(id, w, h); }
                }

                // Three sessions: the free fourth cell offers a new session.
                if root.count == 3: Rectangle {
                    x: body.tile-w + body.gap;
                    y: body.tile-h + body.gap;
                    width: body.tile-w;
                    height: body.tile-h;
                    background: empty-ta.has-hover ? #0e0e11 : Theme.canvas;
                    empty-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_new_session = true;
                            root.new_session_page();
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: center;
                            Icon {
                                size: 18px;
                                commands: Icons.plus;
                                tint: empty-ta.has-hover ? Theme.text : Theme.text-3;
                            }
                        }
                        Text {
                            text: "Open a new session";
                            color: Theme.text-3;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // "+" page: MainWindow places the dashboard here (conditionally on show_new_session).
            @children
        }
    }
}
