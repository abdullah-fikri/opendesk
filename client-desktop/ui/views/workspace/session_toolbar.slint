// Toolbar of the focused session: monitors, files, mic, view, privacy. On Windows, system keys (Win, Alt+Tab,
// Ctrl+Shift+Esc, ...) need no menu: the viewer's keyboard hook sends them to the focused host. Elsewhere the local
// desktop keeps them, so a shortcut menu sends them instead.

import { SessionView } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { ToolButton } from "../../components/tool_button.slint";
import { MenuRow, MenuCaption, PopoverFrame } from "../../components/menu.slint";
import { Segment } from "../../components/segment.slint";
import { VDivider } from "../../components/divider.slint";
import { MonitorPicker } from "monitor_picker.slint";

export component SessionToolbar inherits Rectangle {
    in property <SessionView> s;
    // Show the system-shortcut menu (viewers without a system-key hook).
    in property <bool> system_keys_menu: false;
    callback shortcut(string, string);
    callback select_monitor(string, int);
    callback send_files(string);
    callback toggle_mic(string);
    callback set_privacy(string, int);
    callback toggle_block_input(string);
    callback set_resolution(string, int);
    callback set_audio_quality(string, int);
    callback disconnect(string);

    height: 38px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 4px;

        if root.s.monitors.length > 1: MonitorPicker {
            monitors: root.s.monitors;
            active: root.s.active_monitor;
            select(i) => { root.select_monitor(root.s.id, i); }
        }
        if root.s.monitors.length > 1: Rectangle {
            width: 13px;
            VDivider { }
        }

        ToolButton {
            y: (parent.height - self.height) / 2;
            label: "Send files";
            tip: "Send files to this device (or drag and drop them onto the window)";
            clicked => { root.send_files(root.s.id); }
        }

        ToolButton {
            y: (parent.height - self.height) / 2;
            label: root.s.mic_muted ? "Microphone off" : "Microphone on";
            active: !root.s.mic_muted;
            tip: root.s.mic_muted ? "Unmute the microphone for this session" : "Mute microphone";
            clicked => { root.toggle_mic(root.s.id); }
        }

        kb-btn := ToolButton {
            visible: root.system_keys_menu;
            max-width: self.visible ? 1000px : 0px;
            y: (parent.height - self.height) / 2;
            label: "Keyboard";
            caret: true;
            tip: "Send system shortcuts to this device";
            clicked => { kb-pop.show(); }

            kb-pop := PopupWindow {
                x: 0;
                y: parent.height + 4px;
                width: 220px;
                close-policy: close-on-click;
                PopoverFrame {
                    MenuCaption { text: "KEYBOARD SHORTCUTS"; }
                    VerticalLayout {
                        spacing: 0px;
                        MenuRow { radio: false; label: "Windows key"; hint: "Start"; clicked => { root.shortcut(root.s.id, "win"); } }
                        MenuRow { radio: false; label: "Alt + Tab"; clicked => { root.shortcut(root.s.id, "alt-tab"); } }
                        MenuRow { radio: false; label: "Task Manager"; hint: "Ctrl+Shift+Esc"; clicked => { root.shortcut(root.s.id, "taskmgr"); } }
                        MenuRow { radio: false; label: "File Explorer"; hint: "Win+E"; clicked => { root.shortcut(root.s.id, "explorer"); } }
                        MenuRow { radio: false; label: "Show desktop"; hint: "Win+D"; clicked => { root.shortcut(root.s.id, "desktop"); } }
                    }
                }
            }
        }

        view-btn := ToolButton {
            y: (parent.height - self.height) / 2;
            label: "View";
            caret: true;
            tip: "Stream resolution and voice quality";
            clicked => { view-pop.show(); }

            view-pop := PopupWindow {
                x: 0;
                y: parent.height + 4px;
                width: 300px;
                close-policy: close-on-click-outside;
                PopoverFrame {
                    MenuCaption { text: "STREAM RESOLUTION"; }
                    HorizontalLayout {
                        spacing: 4px;
                        Segment { label: "Auto"; horizontal-stretch: 1.6; selected: root.s.resolution_mode == 1; clicked => { root.set_resolution(root.s.id, 1); } }
                        Segment { label: "Native"; selected: root.s.resolution_mode == 0; clicked => { root.set_resolution(root.s.id, 0); } }
                        Segment { label: "1080"; selected: root.s.resolution_mode == 1080; clicked => { root.set_resolution(root.s.id, 1080); } }
                        Segment { label: "720"; selected: root.s.resolution_mode == 720; clicked => { root.set_resolution(root.s.id, 720); } }
                        Segment { label: "480"; selected: root.s.resolution_mode == 480; clicked => { root.set_resolution(root.s.id, 480); } }
                    }
                    Text {
                        text: root.s.resolution_mode == 1 ? "Follows the size of this window or tile."
                            : root.s.resolution_mode == 0 ? "The host's native resolution, sharpest."
                            : "Smaller means lower latency.";
                        color: Theme.text-3;
                        font-size: 11px;
                    }
                    Rectangle { height: 4px; }
                    MenuCaption { text: "MICROPHONE QUALITY"; }
                    HorizontalLayout {
                        spacing: 4px;
                        Segment { label: "16 kHz Economy"; selected: root.s.audio_quality == 0; clicked => { root.set_audio_quality(root.s.id, 0); } }
                        Segment { label: "24 kHz Clear"; selected: root.s.audio_quality == 1; clicked => { root.set_audio_quality(root.s.id, 1); } }
                        Segment { label: "48 kHz HD"; selected: root.s.audio_quality == 2; clicked => { root.set_audio_quality(root.s.id, 2); } }
                    }
                }
            }
        }

        // Hosts that cannot hide their screen or lock their input (Linux) do not offer these controls.
        priv-btn := ToolButton {
            visible: !root.s.privacy_unavailable || !root.s.block_input_unavailable;
            max-width: self.visible ? 1000px : 0px;
            y: (parent.height - self.height) / 2;
            label: "Privacy";
            caret: true;
            active: root.s.privacy_mode != 0 || root.s.block_input;
            tip: "Physical screen and input of this device";
            clicked => { priv-pop.show(); }

            priv-pop := PopupWindow {
                x: 0;
                y: parent.height + 4px;
                width: 260px;
                close-policy: close-on-click-outside;
                PopoverFrame {
                    if !root.s.privacy_unavailable: MenuCaption { text: "DEVICE SCREEN"; }
                    if !root.s.privacy_unavailable: VerticalLayout {
                        spacing: 0px;
                        MenuRow { label: "Normal"; selected: root.s.privacy_mode == 0; clicked => { root.set_privacy(root.s.id, 0); } }
                        MenuRow { label: "Freeze screen"; selected: root.s.privacy_mode == 1; clicked => { root.set_privacy(root.s.id, 1); } }
                        MenuRow { label: "Maintenance screen"; selected: root.s.privacy_mode == 2; clicked => { root.set_privacy(root.s.id, 2); } }
                        MenuRow { label: "Black screen"; selected: root.s.privacy_mode == 3; clicked => { root.set_privacy(root.s.id, 3); } }
                    }
                    if !root.s.privacy_unavailable && !root.s.block_input_unavailable: Rectangle { height: 1px; background: Theme.divider; }
                    if !root.s.block_input_unavailable: Rectangle {
                        height: 32px;
                        background: block-ta.has-hover ? Theme.hover : transparent;
                        block-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_block_input(root.s.id); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                horizontal-stretch: 1;
                                text: "Lock physical mouse & keyboard";
                                color: Theme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.s.block_input ? "ON" : "OFF";
                                color: root.s.block_input ? #f87171 : Theme.text-3;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Per-session status (transfers, errors): takes the free space and elides when narrow.
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.s.status;
            color: Theme.text-3;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
        Rectangle { width: 8px; }

        // Connection info: path dot, path, fps, stream size.
        HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 0;
            Rectangle {
                width: 7px;
                height: 7px;
                y: (parent.height - self.height) / 2;
                background: Theme.session-dot(root.s.connecting, root.s.path);
            }
            Text {
                text: root.s.connecting ? "Connecting…"
                    : root.s.path + "  ·  " + root.s.fps + " fps" + (root.s.stream_width > 0 ? "  ·  " + root.s.stream_width + "×" + root.s.stream_height : "");
                color: Theme.text-2;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 17px;
            VDivider { }
        }

        ToolButton {
            y: (parent.height - self.height) / 2;
            label: "Disconnect";
            danger: true;
            pad: 12px;
            tip: "Disconnect session " + root.s.title;
            clicked => { root.disconnect(root.s.id); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.divider;
    }
}

// ---------------------------------------------------------------- Session tile / canvas
