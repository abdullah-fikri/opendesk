// Numbered picker for the host's monitors.

import { MonitorItem } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { Segment } from "../../components/segment.slint";
import { TipBox } from "../../components/controls.slint";

export component MonitorPicker inherits HorizontalLayout {
    in property <[MonitorItem]> monitors;
    in property <int> active;
    callback select(int);

    spacing: 3px;
    alignment: start;
    horizontal-stretch: 0;

    Text {
        text: "Screen";
        color: Theme.text-2;
        font-size: 12px;
        font-weight: 500;
        vertical-alignment: center;
    }
    Rectangle { width: 5px; }

    for m in root.monitors: Segment {
        y: (parent.height - self.height) / 2;
        width: 28px;
        horizontal-stretch: 0;
        label: m.label;
        selected: m.index == root.active;
        clicked => { root.select(m.index); }

        // Primary monitor: small mark in the top-right corner.
        if m.primary: Rectangle {
            x: parent.width - 7px;
            y: 3px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: Theme.accent-mark;
        }
        Tooltip {
            TipBox { text: "Monitor " + m.label + (m.primary ? " (primary)" : "") + " · " + m.width + "×" + m.height; }
        }
    }
}

// ---------------------------------------------------------------- Toolbar (focused session)
