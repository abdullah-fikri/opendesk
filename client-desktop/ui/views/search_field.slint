// Search box of the dashboard lists.

import { Theme, Icons } from "../theme.slint";
import { Icon } from "../components/icon.slint";

// Single-line search input with a clear (×) button. Reports every keystroke through `edited`; Enter is not needed.
export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback edited(string);

    // Moves keyboard focus into the box (Ctrl+F).
    public function focus-input() {
        input.focus();
        input.select-all();
    }

    // Empties the box and reports it (×, Esc).
    public function clear() {
        root.text = "";
        root.edited("");
    }

    height: 30px;
    horizontal-stretch: 1;
    min-width: 120px;
    background: #0a0a0c;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;

        Icon {
            y: (parent.height - self.height) / 2;
            commands: Icons.search;
            tint: input.has-focus ? Theme.text-2 : Theme.text-3;
        }

        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: #52525b;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                text <=> root.text;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(self.text); }
            }
        }

        if root.text != "": Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            background: ta-clear.has-hover ? Theme.hover : transparent;
            ta-clear := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.clear();
                    input.focus();
                }
            }
            Icon {
                size: 10px;
                commands: Icons.close;
                tint: ta-clear.has-hover ? Theme.text : Theme.text-3;
            }
        }
    }
}
