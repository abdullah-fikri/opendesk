// Top bar outside viewer sessions: relay status, settings and hosting controls.

import { Theme, Icons } from "../theme.slint";
import { Icon } from "../components/icon.slint";

// Rounded header button: optional icon and label; `active` highlights it in the accent colour, `primary` fills it.
component HeaderButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active: false;
    in property <bool> primary: false;
    callback clicked();

    height: 30px;
    min-width: 30px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: root.primary ? (ta.has-hover ? Theme.accent-hover : Theme.accent)
        : root.active ? Theme.accent-soft
        : ta.has-hover ? Theme.hover : #ffffff0a;
    border-width: root.primary ? 0px : 1px;
    border-color: root.active ? Theme.accent : Theme.divider;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            size: 13px;
            commands: root.icon;
            tint: root.primary ? #ffffff : root.active ? #f87171 : Theme.text-2;
        }
        if root.label != "": Text {
            text: root.label;
            color: root.primary ? #ffffff : root.active ? #f87171 : Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component HeaderBar inherits Rectangle {
    height: 46px;
    background: Theme.bar;
    // Explicit limits: the bar adapts to its width, so its width must not come from its content (binding loop).
    min-width: 0px;
    max-width: 100000px;
    preferred-width: 0px;

    in property <bool> is_relay_online: false;
    in property <string> status_text: "Online";
    in property <bool> is_admin: false;
    // A remote viewer controls this machine: show its file, microphone and disconnect controls.
    in property <bool> hosting: false;
    in property <bool> is_mic_muted: false;
    in-out property <bool> show_settings: false;
    // Window full-screen state, so full-screen can always be left from the header.
    in-out property <bool> fullscreen: false;
    // Admin edition: the settings page is open.
    in property <bool> settings_open: false;

    callback open_admin_settings();
    callback open_file_picker();
    callback toggle_mic();
    callback disconnect_session();

    // Below this width the status text goes and, while hosting, buttons drop their labels.
    property <bool> narrow: root.width < 760px;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 12px;

        // Left: brand and status
        HorizontalLayout {
            spacing: 10px;
            horizontal-stretch: 1;
            min-width: 0px;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: is_relay_online ? Theme.ok : Theme.accent;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: is_admin ? "OpenDesk Admin" : "OpenDesk";
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 700;
                vertical-alignment: center;
            }

            // Divider and status text: positioned freely in a clipped, stretching area so a narrow window only hides
            // them (the layout itself never depends on the width: no binding loop).
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                clip: true;
                visible: !root.narrow;
                Rectangle {
                    x: 0px;
                    width: 1px;
                    height: 13px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border;
                }
                Text {
                    x: 11px;
                    width: parent.width - 11px;
                    height: parent.height;
                    text: status_text;
                    color: Theme.text-3;
                    font-size: 12.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Right: controls
        HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 0;
            alignment: end;

            if fullscreen: HeaderButton {
                y: (parent.height - self.height) / 2;
                label: "Exit full screen";
                clicked => { fullscreen = false; }
            }

            if is_admin: HeaderButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.settings;
                label: "Settings";
                active: settings_open;
                clicked => { open_admin_settings(); }
            }

            // The relay address and performance live in Settings for the admin edition.
            if !is_admin: HeaderButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.server;
                label: "Server";
                active: show_settings;
                clicked => { show_settings = !show_settings; }
            }

            if hosting: HeaderButton {
                y: (parent.height - self.height) / 2;
                label: "Send Files";
                clicked => { open_file_picker(); }
            }

            if hosting: HeaderButton {
                y: (parent.height - self.height) / 2;
                label: is_mic_muted ? "Mic: Off" : "Mic: On";
                active: !is_mic_muted;
                clicked => { toggle_mic(); }
            }

            if hosting: HeaderButton {
                y: (parent.height - self.height) / 2;
                label: "Disconnect";
                primary: true;
                clicked => { disconnect_session(); }
            }
        }
    }
}
