// Top bar while a remote viewer controls this machine: brand, relay status and the hosting controls. It also
// moves the window (no system title bar); the right end stays clear for the window buttons.

import { Theme, Brand } from "../theme.slint";
import { Btn } from "../components/controls.slint";
import { DragArea } from "../components/window_frame.slint";

export component HeaderBar inherits Rectangle {
    height: 52px;
    background: Theme.side;
    // Explicit limits: the bar adapts to its width, so its width must not come from its content (binding loop).
    min-width: 0px;
    max-width: 100000px;
    preferred-width: 0px;

    in property <bool> is_relay_online: false;
    in property <string> status_text: "Online";
    in property <bool> is_mic_muted: false;
    // Window full-screen state, so full-screen can always be left from the header.
    in-out property <bool> fullscreen: false;

    callback open_file_picker();
    callback toggle_mic();
    callback disconnect_session();

    // Below this width the status text is hidden (it never changes the layout: no binding loop).
    property <bool> narrow: root.width < 760px;

    DragArea { }

    HorizontalLayout {
        padding-left: 22px;
        padding-right: root.fullscreen ? 16px : 150px;
        spacing: 10px;

        Image {
            y: (parent.height - self.height) / 2;
            width: 28px;
            height: 28px;
            source: Brand.logo;
            image-fit: contain;
        }
        Text {
            text: "OpenDesk";
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.is_relay_online ? Theme.green : Theme.accent-mark;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            visible: !root.narrow;
            text: root.status_text;
            color: Theme.text-2;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.fullscreen: Btn {
            y: (parent.height - self.height) / 2;
            icon: "fullscreen-exit";
            label: "Exit Full Screen";
            clicked => { root.fullscreen = false; }
        }
        Btn {
            y: (parent.height - self.height) / 2;
            icon: "send";
            label: "Send Files";
            tip: "Send files to the remote device";
            clicked => { root.open_file_picker(); }
        }
        Btn {
            y: (parent.height - self.height) / 2;
            icon: "mic";
            kind: root.is_mic_muted ? "default" : "tint";
            label: root.is_mic_muted ? "Mic Off" : "Mic On";
            tip: root.is_mic_muted ? "Turn the microphone on" : "Turn the microphone off";
            clicked => { root.toggle_mic(); }
        }
        Btn {
            y: (parent.height - self.height) / 2;
            kind: "acc";
            label: "Disconnect";
            clicked => { root.disconnect_session(); }
        }
    }
}
