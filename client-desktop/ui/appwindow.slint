import { HistoryItem, HostItem } from "types.slint";
import { HeaderBar } from "header.slint";
import { DashboardView } from "dashboard.slint";
import { HostActiveView } from "host_panel.slint";
import { RemoteViewerCanvas } from "remote_canvas.slint";
import {
    ServerSettingsModal,
    RenameDeviceModal,
    DeleteConfirmModal,
    IncomingCallModal,
    SessionOptionsModal
} from "modals.slint";

export { HistoryItem, HostItem }

export component MainWindow inherits Window {
    title: "OpenDesk - " + local_desk_id;
    icon: @image-url("icon.png");
    min-width: 880px;
    min-height: 560px;
    preferred-width: 920px;
    preferred-height: 600px;
    background: #09090b;

    in-out property <string> local_desk_id: "145 494 982";
    in-out property <string> target_desk_id: "";
    in-out property <string> active_partner_id: "";
    in-out property <string> gateway_url: "ws://127.0.0.1:8088";
    in-out property <string> status_text: "Online";
    in-out property <bool> is_connected: false;
    in-out property <bool> is_relay_online: false;
    in-out property <bool> is_host: false;
    in-out property <bool> is_admin: false;
    in-out property <int> active_dashboard_tab: 0;
    in-out property <bool> is_mic_muted: false;
    in-out property <bool> has_remote_frame: false;
    in-out property <int> remote_cursor: 1;
    in-out property <image> remote_frame;
    in-out property <bool> has_incoming: false;
    in-out property <string> incoming_caller: "";
    in-out property <bool> show_settings: false;
    in-out property <bool> show_session_options: false;
    in-out property <int> privacy_mode: 0;
    in-out property <bool> block_remote_input: false;
    in-out property <int> resolution_mode: 1080;
    in-out property <int> audio_quality: 2;

    in-out property <[HistoryItem]> history_items: [];
    in-out property <[HostItem]> server_hosts: [];
    in-out property <bool> show_rename_modal: false;
    in-out property <string> rename_target_id: "";
    in-out property <string> rename_input_val: "";

    in-out property <bool> show_delete_modal: false;
    in-out property <string> delete_target_id: "";
    in-out property <string> delete_target_label: "";

    callback request_connect(string);
    callback disconnect_session();
    callback accept_incoming();
    callback reject_incoming();
    callback send_mouse_move(int, int);
    callback send_mouse_down(int, int, int);
    callback send_mouse_up(int, int, int);
    callback send_mouse_wheel(int, int, int);
    callback send_key(int);
    callback send_key_event(string, bool, bool, bool);
    callback switch_monitor();
    callback open_file_picker();
    callback save_gateway_url(string);
    callback open_rename(string, string);
    callback save_rename(string, string);
    callback delete_history(string);
    callback copy_local_id();
    callback toggle_mic();
    callback set_privacy_mode(int);
    callback toggle_block_input();
    callback send_system_shortcut(string);
    callback refresh_hosts();
    callback set_resolution_mode(int);
    callback set_audio_quality(int);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Top classic crimson accent line (2px)
        Rectangle {
            height: 2px;
            background: #dc2626;
        }

        HeaderBar {
            is_relay_online: root.is_relay_online;
            status_text: root.status_text;
            is_connected: root.is_connected;
            is_host: root.is_host;
            is_admin: root.is_admin;
            is_mic_muted: root.is_mic_muted;
            show_settings <=> root.show_settings;
            show_session_options <=> root.show_session_options;
            switch_monitor => { root.switch_monitor(); }
            open_file_picker => { root.open_file_picker(); }
            toggle_mic => { root.toggle_mic(); }
            disconnect_session => { root.disconnect_session(); }
        }

        // Thin divider
        Rectangle {
            height: 1px;
            background: #1f1f23;
        }

        // Solid Full-Window Body Container
        Rectangle {
            vertical-stretch: 1;
            background: #09090b;
            clip: true;

            if !is_connected: DashboardView {
                local_desk_id: root.local_desk_id;
                is_relay_online: root.is_relay_online;
                is_admin: root.is_admin;
                active_tab <=> root.active_dashboard_tab;
                target_desk_id <=> root.target_desk_id;
                history_items: root.history_items;
                server_hosts: root.server_hosts;
                copy_local_id => { root.copy_local_id(); }
                request_connect(id) => { root.request_connect(id); }
                open_rename(id, alias) => { root.open_rename(id, alias); }
                prompt_delete_history(id, label) => {
                    root.delete_target_id = id;
                    root.delete_target_label = label;
                    root.show_delete_modal = true;
                }
                refresh_hosts => { root.refresh_hosts(); }
            }

            if is_connected && is_host: HostActiveView {
                active_partner_id: root.active_partner_id;
                is_mic_muted: root.is_mic_muted;
                toggle_mic => { root.toggle_mic(); }
                disconnect_session => { root.disconnect_session(); }
            }

            if is_connected && !is_host: RemoteViewerCanvas {
                has_remote_frame: root.has_remote_frame;
                remote_frame: root.remote_frame;
                remote_cursor: root.remote_cursor;
                active_partner_id: root.active_partner_id;
                send_mouse_move(nx, ny) => { root.send_mouse_move(nx, ny); }
                send_mouse_down(nx, ny, btn) => { root.send_mouse_down(nx, ny, btn); }
                send_mouse_up(nx, ny, btn) => { root.send_mouse_up(nx, ny, btn); }
                send_mouse_wheel(nx, ny, dy) => { root.send_mouse_wheel(nx, ny, dy); }
                send_key_event(txt, ctrl, alt, shift) => {
                    root.send_key_event(txt, ctrl, alt, shift);
                }
            }
        }
    }

    if show_settings: ServerSettingsModal {
        gateway_url <=> root.gateway_url;
        show_settings <=> root.show_settings;
        save_gateway_url(url) => { root.save_gateway_url(url); }
    }

    if show_session_options: SessionOptionsModal {
        show_session_options <=> root.show_session_options;
        privacy_mode: root.privacy_mode;
        block_remote_input: root.block_remote_input;
        resolution_mode: root.resolution_mode;
        audio_quality: root.audio_quality;
        set_privacy_mode(m) => { root.set_privacy_mode(m); }
        toggle_block_input => { root.toggle_block_input(); }
        send_system_shortcut(sc) => { root.send_system_shortcut(sc); }
        set_resolution_mode(m) => { root.set_resolution_mode(m); }
        set_audio_quality(q) => { root.set_audio_quality(q); }
    }

    if show_rename_modal: RenameDeviceModal {
        rename_target_id: root.rename_target_id;
        rename_input_val <=> root.rename_input_val;
        show_rename_modal <=> root.show_rename_modal;
        save_rename(id, alias) => { root.save_rename(id, alias); }
    }

    if show_delete_modal: DeleteConfirmModal {
        delete_target_id: root.delete_target_id;
        delete_target_label: root.delete_target_label;
        show_delete_modal <=> root.show_delete_modal;
        confirm_delete(id) => { root.delete_history(id); }
    }

    if has_incoming: IncomingCallModal {
        incoming_caller: root.incoming_caller;
        reject_incoming => { root.reject_incoming(); }
        accept_incoming => { root.accept_incoming(); }
    }
}
