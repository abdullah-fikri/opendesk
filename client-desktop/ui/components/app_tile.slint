// Coloured icon tiles of the redesign (gradient square, white mark), as SVG files in ui/icons/tile-*.svg.

export component AppTile inherits Rectangle {
    // devices, online, offline, history, security, security-off, server, audio, mouse, key, wall
    in property <string> kind;
    in property <length> tile: 22px;

    width: root.tile;
    height: root.tile;
    border-radius: root.tile * 0.236;
    drop-shadow-blur: 1.5px;
    drop-shadow-offset-y: 0.5px;
    drop-shadow-color: #00000030;

    Image {
        width: root.tile;
        height: root.tile;
        source: root.kind == "devices" ? @image-url("../icons/tile-devices.svg") : root.kind == "online" ? @image-url("../icons/tile-online.svg") : root.kind == "offline" ? @image-url("../icons/tile-offline.svg") : root.kind == "history" ? @image-url("../icons/tile-history.svg") : root.kind == "security" ? @image-url("../icons/tile-security.svg") : root.kind == "security-off" ? @image-url("../icons/tile-security-off.svg") : root.kind == "server" ? @image-url("../icons/tile-server.svg") : root.kind == "audio" ? @image-url("../icons/tile-audio.svg") : root.kind == "mouse" ? @image-url("../icons/tile-mouse.svg") : root.kind == "key" ? @image-url("../icons/tile-key.svg") : @image-url("../icons/tile-wall.svg");
        image-fit: contain;
    }
}
