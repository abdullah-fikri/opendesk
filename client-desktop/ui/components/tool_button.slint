// Toolbar button of a viewer session, in the redesign's button style (grey fill, red when on).

import { Theme, Icons } from "../theme.slint";
import { Icon } from "icon.slint";
import { Glyph } from "glyph.slint";
import { TipBox } from "controls.slint";

// `active` = a setting is on (soft red), `open` = its popover is showing, `danger` = the red primary button.
// Children (typically a PopupWindow) are placed inside the button so popovers anchor to it.
export component ToolButton inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <bool> active: false;
    in property <bool> open: false;
    in property <bool> caret: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <length> pad: 12px;
    // Optional stroke icon (Icons.*) before the label.
    in property <string> icon;
    // Optional glyph (Glyph names) before the label.
    in property <string> glyph;
    callback clicked();

    property <bool> hot: ta.has-hover && root.enabled;
    property <color> fg: root.danger ? #ffffff : root.active ? Theme.accent-tx : Theme.text;

    height: Theme.control-h;
    horizontal-stretch: 0;
    // Hidden buttons (visible: false, max-width: 0) take no room.
    min-width: root.visible ? Theme.control-h : 0px;
    border-radius: Theme.radius-sm;
    opacity: root.enabled ? 1.0 : 0.4;
    background: root.danger ? (root.hot ? Theme.accent-hover : Theme.accent)
        : root.active ? (root.hot || root.open ? Theme.accent-line : Theme.accent-soft)
        : (root.open || root.hot) ? Theme.hover2
        : Theme.field;
    animate background { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.caret ? root.pad - 3px : root.pad;
        spacing: 6px;
        alignment: center;
        if root.glyph != "": Glyph {
            y: (parent.height - self.height) / 2;
            name: root.glyph;
            size: 13px;
            tint: root.fg;
        }
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            tint: root.fg;
        }
        if root.label != "": Text {
            text: root.label;
            color: root.fg;
            font-size: 12.5px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        if root.caret: Glyph {
            y: (parent.height - self.height) / 2;
            name: "chevron-down";
            size: 9px;
            tint: root.danger ? #ffffff : Theme.text-3;
        }
    }

    if root.tip != "": Tooltip {
        TipBox { text: root.tip; }
    }

    @children
}
