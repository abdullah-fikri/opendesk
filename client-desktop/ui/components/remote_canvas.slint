// Remote screen with pointer and keyboard capture; coordinates are normalized to 0..10000.

export component RemoteViewerCanvas inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #050507;
    clip: true;

    in property <bool> has_remote_frame: false;
    in property <image> remote_frame;
    in property <string> active_partner_id: "";
    // Host cursor shape code (see core_engine::capture::cursor_shape); the local cursor takes this shape, except
    // that a hidden host cursor shows as the arrow.
    in property <int> remote_cursor: 1;

    callback send_mouse_move(int, int);
    callback send_mouse_down(int, int, int);
    callback send_mouse_up(int, int, int);
    callback send_mouse_wheel(int, int, int);
    // (text, pressed, repeat, ctrl, alt, shift): every physical press AND release goes to the host.
    callback send_key_event(string, bool, bool, bool, bool, bool);
    // Lift every key held on the host (focus lost / window deactivated) so nothing stays stuck.
    callback release_remote_keys();
    // Canvas size in physical pixels, for the host's automatic stream resolution.
    callback viewport_resized(int, int);

    // Multi-session additions. Defaults keep the single-session behaviour unchanged.
    // `focused`: this canvas owns the keyboard; when it becomes true (and `auto_focus`) it takes key focus.
    in property <bool> focused: true;
    in property <bool> auto_focus: false;
    // `click_to_focus`: an unfocused split tile. A click only calls `activate()`; nothing reaches the host.
    in property <bool> click_to_focus: false;
    callback activate();

    init => {
        root.viewport_resized(self.width / 1phx, self.height / 1phx);
        if (root.auto_focus && root.focused) {
            viewer-focus.focus();
        }
    }
    changed focused => {
        if (root.auto_focus && root.focused) {
            viewer-focus.focus();
        }
    }
    changed width => { root.viewport_resized(self.width / 1phx, self.height / 1phx); }
    changed height => { root.viewport_resized(self.width / 1phx, self.height / 1phx); }

    property <bool> left-down: false;
    property <bool> right-down: false;
    property <float> frame_w: remote_frame.width > 0 ? remote_frame.width : 16;
    property <float> frame_h: remote_frame.height > 0 ? remote_frame.height : 9;
    property <float> scale_x: self.width / (frame_w * 1px);
    property <float> scale_y: self.height / (frame_h * 1px);
    property <float> fit_scale: Math.min(scale_x, scale_y);
    property <length> fitted_w: frame_w * 1px * fit_scale;
    property <length> fitted_h: frame_h * 1px * fit_scale;

    viewer-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            send_key_event(
                event.text,
                true,
                event.repeat,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift
            );
            accept
        }

        key-released(event) => {
            send_key_event(
                event.text,
                false,
                false,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift
            );
            accept
        }

        focus-lost => { release_remote_keys(); }

        if has_remote_frame: Rectangle {
            width: root.fitted_w;
            height: root.fitted_h;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #000000;

            Image {
                source: remote_frame;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
                image-rendering: smooth;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                // A hidden host cursor (0) shows as the default arrow: the user still points with this one,
                // and the host hides its cursor for keyboard use (Start, Alt+Tab, typing) without a mouse move.
                mouse-cursor: remote_cursor == 2 ? MouseCursor.text
                    : remote_cursor == 3 ? MouseCursor.pointer
                    : remote_cursor == 4 ? MouseCursor.wait
                    : remote_cursor == 5 ? MouseCursor.progress
                    : remote_cursor == 6 ? MouseCursor.crosshair
                    : remote_cursor == 7 ? MouseCursor.move
                    : remote_cursor == 8 ? MouseCursor.ew-resize
                    : remote_cursor == 9 ? MouseCursor.ns-resize
                    : remote_cursor == 10 ? MouseCursor.nwse-resize
                    : remote_cursor == 11 ? MouseCursor.nesw-resize
                    : remote_cursor == 12 ? MouseCursor.not-allowed
                    : remote_cursor == 13 ? MouseCursor.help
                    : MouseCursor.default;

                pointer-event(event) => {
                    if (self.width > 0px && self.height > 0px) {
                        // `moved` only fires while a button is held; move events also cover hover.
                        if (event.kind == PointerEventKind.move) {
                            send_mouse_move(
                                (self.mouse-x / self.width) * 10000,
                                (self.mouse-y / self.height) * 10000
                            );
                            return;
                        }
                    }
                    viewer-focus.focus();
                    if (self.width > 0px && self.height > 0px) {
                        if (event.kind == PointerEventKind.down) {
                            if (event.button == PointerEventButton.right) {
                                root.right-down = true;
                            } else {
                                root.left-down = true;
                            }
                            send_mouse_down(
                                (self.mouse-x / self.width) * 10000,
                                (self.mouse-y / self.height) * 10000,
                                event.button == PointerEventButton.right ? 2 : 0
                            );
                        } else if (event.kind == PointerEventKind.up
                            && (event.button == PointerEventButton.right ? root.right-down : root.left-down)) {
                            // Only release what was pressed here: a click that closed a popover
                            // delivers just the release, which must not reach the host.
                            if (event.button == PointerEventButton.right) {
                                root.right-down = false;
                            } else {
                                root.left-down = false;
                            }
                            send_mouse_up(
                                (self.mouse-x / self.width) * 10000,
                                (self.mouse-y / self.height) * 10000,
                                event.button == PointerEventButton.right ? 2 : 0
                            );
                        }
                    }
                }

                scroll-event(event) => {
                    viewer-focus.focus();
                    if (self.width > 0px && self.height > 0px && event.delta-y != 0px) {
                        send_mouse_wheel(
                            (self.mouse-x / self.width) * 10000,
                            (self.mouse-y / self.height) * 10000,
                            event.delta-y > 0px ? 120 : -120
                        );
                    }
                    accept
                }
            }
        }
    }

    if !has_remote_frame: Rectangle {
        width: Math.min(320px, parent.width - 24px);
        height: 100px;
        background: #111114;
        border-width: 1px;
        border-color: #27272a;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            padding: 0px;
            Rectangle {
                height: 2px;
                background: #dc2626;
            }
            VerticalLayout {
                padding: 20px;
                spacing: 6px;
                alignment: center;
                Text {
                    text: "Connecting to the screen...";
                    color: #f4f4f5;
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: active_partner_id;
                    color: #71717a;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }

    // Unfocused split tile: swallow pointer input, a click focuses this session only.
    if click_to_focus: focus-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
        scroll-event(event) => { accept }
        Rectangle {
            background: focus-ta.has-hover ? #00000040 : transparent;
            if focus-ta.has-hover: Rectangle {
                width: hint.preferred-width + 20px;
                height: 26px;
                background: #111114e6;
                border-width: 1px;
                border-color: #27272a;
                hint := Text {
                    text: "Click to focus";
                    color: #f4f4f5;
                    font-size: 11px;
                    font-weight: 600;
                }
            }
        }
    }
}
