// One option of a segmented control.

import { Theme } from "../theme.slint";

// Segment of a segmented control (resolution, audio, layout, monitors).
export component Segment inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 26px;
    min-width: 26px;
    horizontal-stretch: 1;
    background: selected ? Theme.accent : (ta.has-hover && enabled) ? Theme.hover : Theme.surface-2;
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.border;

    ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    Text {
        text: root.label;
        color: root.selected ? #ffffff : root.enabled ? #d4d4d8 : Theme.text-3;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    @children
}
