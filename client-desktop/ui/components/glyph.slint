// Line and solid icons of the redesign, as SVG files in ui/icons/ (generated from the design's SVGs). Slint
// renders an SVG at its displayed pixel size, so the icons stay sharp at any size and scale. `tint` colours the
// icon; the status icons (warn, *-circle) keep a white mark on top.

export component Glyph inherits Rectangle {
    in property <string> name;
    in property <length> size: 14px;
    in property <color> tint: #808080;

    width: root.size;
    height: root.size;

    Image {
        width: root.size;
        height: root.size;
        source: root.name == "minimize" ? @image-url("../icons/minimize.svg") : root.name == "maximize" ? @image-url("../icons/maximize.svg") : root.name == "restore" ? @image-url("../icons/restore.svg") : root.name == "close" ? @image-url("../icons/close.svg") : root.name == "search" ? @image-url("../icons/search.svg") : root.name == "grid" ? @image-url("../icons/grid.svg") : root.name == "list" ? @image-url("../icons/list.svg") : root.name == "refresh" ? @image-url("../icons/refresh.svg") : root.name == "wall" ? @image-url("../icons/wall.svg") : root.name == "sliders" ? @image-url("../icons/sliders.svg") : root.name == "spinner" ? @image-url("../icons/spinner.svg") : root.name == "windows" ? @image-url("../icons/windows.svg") : root.name == "phone" ? @image-url("../icons/phone.svg") : root.name == "desktop" ? @image-url("../icons/desktop.svg") : root.name == "sun" ? @image-url("../icons/sun.svg") : root.name == "moon" ? @image-url("../icons/moon.svg") : root.name == "chevron-left" ? @image-url("../icons/chevron-left.svg") : root.name == "chevron-right" ? @image-url("../icons/chevron-right.svg") : root.name == "chevron-down" ? @image-url("../icons/chevron-down.svg") : root.name == "chevron-up" ? @image-url("../icons/chevron-up.svg") : root.name == "fullscreen" ? @image-url("../icons/fullscreen.svg") : root.name == "fullscreen-exit" ? @image-url("../icons/fullscreen-exit.svg") : root.name == "expand" ? @image-url("../icons/expand.svg") : root.name == "minus" ? @image-url("../icons/minus.svg") : root.name == "plus" ? @image-url("../icons/plus.svg") : root.name == "pencil" ? @image-url("../icons/pencil.svg") : root.name == "trash" ? @image-url("../icons/trash.svg") : root.name == "copy" ? @image-url("../icons/copy.svg") : root.name == "check" ? @image-url("../icons/check.svg") : root.name == "send" ? @image-url("../icons/send.svg") : root.name == "mic" ? @image-url("../icons/mic.svg") : root.name == "warn" ? @image-url("../icons/warn.svg") : root.name == "ok-circle" ? @image-url("../icons/ok-circle.svg") : root.name == "info-circle" ? @image-url("../icons/info-circle.svg") : @image-url("../icons/error-circle.svg");
        colorize: root.tint;
        image-fit: contain;
    }
    if root.name == "warn" || root.name == "ok-circle" || root.name == "info-circle" || root.name == "error-circle": Image {
        width: root.size;
        height: root.size;
        source: root.name == "warn" ? @image-url("../icons/warn-mark.svg") : root.name == "ok-circle" ? @image-url("../icons/ok-circle-mark.svg") : root.name == "info-circle" ? @image-url("../icons/info-circle-mark.svg") : @image-url("../icons/error-circle-mark.svg");
        image-fit: contain;
    }
}
