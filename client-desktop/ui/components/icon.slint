// Stroke icon drawn from a 12x12 path.

export component Icon inherits Path {
    in property <color> tint: #a1a1aa;
    in property <length> size: 12px;
    width: size;
    height: size;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: tint;
    stroke-width: 1.5px;
    fill: transparent;
}
