// Popover menu frame, rows and captions, in the redesign's popover style.

import { Theme } from "../theme.slint";
import { Glyph } from "glyph.slint";

// One option inside a popover: a round radio mark (or none) + label (+ an optional hint on the right).
export component MenuRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> selected: false;
    in property <bool> radio: true;
    callback clicked();

    height: 30px;
    border-radius: 7px;
    background: ta.has-hover ? Theme.hover-soft : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.radio: Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            border-width: root.selected ? 0px : 1.5px;
            border-color: Theme.text-3;
            background: root.selected ? Theme.accent : transparent;
            if root.selected: Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: #ffffff;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            font-weight: root.selected ? 500 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.text-3;
            font-size: 11.5px;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
    }
}

// Section caption inside a popover.
export component MenuCaption inherits Text {
    color: Theme.text-3;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

// Popover frame: elevated surface with the soft popover shadow (same as `Pop`).
export component PopoverFrame inherits Rectangle {
    background: Theme.elev;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.pop-edge;
    drop-shadow-blur: 28px;
    drop-shadow-color: Theme.pop-shadow;
    drop-shadow-offset-y: 10px;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        @children
    }
}

// iOS-style glass popover (context menus): translucent rounded panel, plain text rows, hairline separators.
export component GlassMenu inherits Rectangle {
    background: Theme.dark ? #2c2c2ef0 : #f7f7f8f2;
    border-radius: 14px;
    border-width: 0.5px;
    border-color: Theme.dark ? #ffffff26 : #0000001a;
    drop-shadow-blur: 30px;
    drop-shadow-color: #00000059;
    drop-shadow-offset-y: 10px;
    clip: true;

    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        @children
    }
}

// One action of a glass popover; `danger` paints it red.
export component GlassItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    opacity: root.enabled ? 1.0 : 0.4;
    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        border-radius: 8px;
        background: ta.has-hover && root.enabled ? (Theme.dark ? #ffffff1a : #0000000f) : transparent;
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    Text {
        x: 20px;
        width: parent.width - 40px;
        text: root.label;
        color: root.danger ? Theme.accent-tx : Theme.text;
        font-size: 13.5px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Hairline between groups of a glass popover.
export component GlassSep inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 20px;
        width: parent.width - 40px;
        height: 0.5px;
        background: Theme.dark ? #ffffff26 : #00000026;
    }
}
