// Popover menu frame, rows and captions, in the redesign's popover style.

import { Theme } from "../theme.slint";
import { Glyph } from "glyph.slint";

// One option inside a popover: a round radio mark (or none) + label (+ an optional hint on the right).
export component MenuRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> selected: false;
    in property <bool> radio: true;
    callback clicked();

    height: 30px;
    border-radius: 7px;
    background: ta.has-hover ? Theme.hover-soft : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.radio: Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            border-width: root.selected ? 0px : 1.5px;
            border-color: Theme.text-3;
            background: root.selected ? Theme.accent : transparent;
            if root.selected: Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: #ffffff;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            font-weight: root.selected ? 500 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.text-3;
            font-size: 11.5px;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
    }
}

// Section caption inside a popover.
export component MenuCaption inherits Text {
    color: Theme.text-3;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

// Popover frame: elevated surface with the soft popover shadow (same as `Pop`).
export component PopoverFrame inherits Rectangle {
    background: Theme.elev;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.pop-edge;
    drop-shadow-blur: 28px;
    drop-shadow-color: Theme.pop-shadow;
    drop-shadow-offset-y: 10px;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        @children
    }
}
