export component HeaderBar inherits Rectangle {
    height: 40px;
    background: #101013;

    in property <bool> is_relay_online: false;
    in property <string> status_text: "Online";
    in property <bool> is_connected: false;
    in property <bool> is_host: false;
    in property <bool> is_admin: false;
    in property <bool> is_mic_muted: false;
    in-out property <bool> show_settings: false;
    in-out property <bool> show_session_options: false;
    // Window full-screen state, so full-screen can always be left from the header.
    in-out property <bool> fullscreen: false;

    callback switch_monitor();
    callback open_file_picker();
    callback toggle_mic();
    callback disconnect_session();

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        alignment: space-between;

        // Left: Brand + Status
        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 7px;
                height: 7px;
                background: is_relay_online ? #22c55e : #dc2626;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: is_admin ? "OpenDesk Admin" : "OpenDesk";
                color: #f4f4f5;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                width: 1px;
                height: 12px;
                background: #27272a;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: status_text;
                color: #a1a1aa;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // Right: Controls
        HorizontalLayout {
            spacing: 8px;
            y: (parent.height - 28px) / 2;

            if fullscreen: Rectangle {
                height: 28px;
                background: ta-fs.has-hover ? #1c1c21 : #141418;
                border-width: 1px;
                border-color: #27272a;
                ta-fs := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { fullscreen = false; }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "Keluar layar penuh";
                        color: #d4d4d8;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 28px;
                background: ta-gw.has-hover ? #1c1c21 : #141418;
                border-width: 1px;
                border-color: show_settings ? #dc2626 : #27272a;
                ta-gw := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { show_settings = !show_settings; }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "Server";
                        color: #d4d4d8;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            if is_connected && !is_host: Rectangle {
                height: 28px;
                background: ta-top-opt.has-hover ? #1c1c21 : #141418;
                border-width: 1px;
                border-color: show_session_options ? #dc2626 : #27272a;
                ta-top-opt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { show_session_options = !show_session_options; }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "Opsi";
                        color: #d4d4d8;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            if is_connected && !is_host: Rectangle {
                height: 28px;
                background: ta-top-mon.has-hover ? #1c1c21 : #141418;
                border-width: 1px;
                border-color: #27272a;
                ta-top-mon := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { switch_monitor(); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "Layar";
                        color: #d4d4d8;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            if is_connected: Rectangle {
                height: 28px;
                background: ta-top-file.has-hover ? #1c1c21 : #141418;
                border-width: 1px;
                border-color: #27272a;
                ta-top-file := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { open_file_picker(); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "Kirim File";
                        color: #d4d4d8;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            if is_connected: Rectangle {
                height: 28px;
                background: !is_mic_muted ? #dc262628 : (ta-top-mic.has-hover ? #1c1c21 : #141418);
                border-width: 1px;
                border-color: !is_mic_muted ? #dc2626 : #27272a;
                ta-top-mic := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { toggle_mic(); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: is_mic_muted ? "Mic: Mati" : "Mic: Aktif";
                        color: !is_mic_muted ? #f87171 : #d4d4d8;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            if is_connected: Rectangle {
                height: 28px;
                background: ta-top-disc.has-hover ? #b91c1c : #dc2626;
                ta-top-disc := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { disconnect_session(); }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: "Putuskan";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
