// Rename a history entry (local) or a device in the relay's host list (shared with every administrator).

import { Theme } from "../theme.slint";
import { Btn, Pop } from "../components/controls.slint";

export component RenameDeviceModal inherits Rectangle {
    background: Theme.scrim;
    width: 100%;
    height: 100%;

    in property <string> rename_target_id: "";
    in-out property <string> rename_input_val: "";
    in-out property <bool> show_rename_modal: false;
    // The name is stored on the relay and seen by every administrator; empty restores the device's own name.
    in property <bool> shared: false;

    callback save_rename(string, string);

    function save() {
        root.save_rename(root.rename_target_id, input-alias.text);
        root.show_rename_modal = false;
    }

    // Swallows clicks outside the dialog; Esc cancels.
    TouchArea { }
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.show_rename_modal = false;
                return accept;
            }
            reject
        }
    }

    Pop {
        width: 360px;
        height: body.preferred-height;
        body := VerticalLayout {
            padding: 24px;
            padding-bottom: 20px;
            spacing: 6px;

            Text {
                text: "Rename Device";
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: root.shared
                    ? "Shown to every administrator. Leave empty to use the device's own name."
                    : "Name for " + root.rename_target_id + " in your session history.";
                color: Theme.text-2;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle { height: 10px; }
            Rectangle {
                height: 32px;
                border-radius: 7px;
                background: Theme.inp;
                border-width: input-alias.has-focus ? 2px : 0px;
                border-color: Theme.ring;
                if input-alias.text == "": Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: root.rename_target_id;
                    color: Theme.text-3;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                input-alias := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text <=> root.rename_input_val;
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    single-line: true;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    accepted => { root.save(); }
                }
            }
            Rectangle { height: 14px; }
            HorizontalLayout {
                spacing: 8px;
                Btn {
                    horizontal-stretch: 1;
                    height: 30px;
                    label: "Cancel";
                    clicked => { root.show_rename_modal = false; }
                }
                Btn {
                    horizontal-stretch: 1;
                    height: 30px;
                    kind: "acc";
                    label: "Save";
                    clicked => { root.save(); }
                }
            }
        }
    }
}
