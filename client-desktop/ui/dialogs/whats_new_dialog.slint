// "What's new" after an update: the plain-English highlights of the installed version (and of skipped ones).
// Close (or Esc) hides it until the next update; Don't show again turns it off for good.

import { Theme } from "../theme.slint";
import { ScrollArea } from "../components/scroll_area.slint";
import { Btn, Pop } from "../components/controls.slint";
import { Glyph } from "../components/glyph.slint";

export component WhatsNewModal inherits Rectangle {
    background: Theme.scrim;
    width: 100%;
    height: 100%;

    in property <string> title: "";
    in property <string> body: "";
    callback closed(bool);  // true = Don't show again

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.closed(false);
                return accept;
            }
            reject
        }
    }

    // Swallows clicks outside the dialog.
    TouchArea { }

    Pop {
        width: 440px;
        // Long lists (several skipped versions) scroll; at most about 60 % of the window.
        height: min(root.height * 0.6, text.preferred-height + 140px);
        clip: true;

        VerticalLayout {
            padding: 24px;
            padding-bottom: 20px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Glyph {
                    y: (parent.height - self.height) / 2;
                    name: "info-circle";
                    size: 18px;
                    tint: Theme.blue;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.title;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            ScrollArea {
                vertical-stretch: 1;
                text := Text {
                    text: root.body;
                    color: Theme.text-2;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Btn {
                    kind: "ghost";
                    label: "Don't show again";
                    clicked => { root.closed(true); }
                }
                Rectangle { horizontal-stretch: 1; }
                Btn {
                    kind: "acc";
                    label: "Close";
                    clicked => { root.closed(false); }
                }
            }
        }
    }
}
