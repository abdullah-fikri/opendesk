// "What's new" after an update: the plain-English highlights of the installed version (and of skipped ones).
// Close (or Esc) hides it until the next update; Don't show again turns it off for good.

import { ScrollArea } from "../components/scroll_area.slint";

export component WhatsNewModal inherits Rectangle {
    background: #000000bb;
    width: 100%;
    height: 100%;

    in property <string> title: "";
    in property <string> body: "";
    callback closed(bool);  // true = Don't show again

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.closed(false);
                return accept;
            }
            reject
        }
    }

    // Swallows clicks outside the dialog.
    TouchArea { }

    Rectangle {
        width: 420px;
        // Long lists (several skipped versions) scroll; at most about 60 % of the window.
        height: min(root.height * 0.6, text.preferred-height + 124px);
        background: #111114;
        border-width: 1px;
        border-color: #27272a;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            Rectangle {
                height: 2px;
                background: #2563eb;
            }

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: root.title;
                    color: #f4f4f5;
                    font-size: 13px;
                    font-weight: 700;
                }

                ScrollArea {
                    vertical-stretch: 1;
                    text := Text {
                        text: root.body;
                        color: #a1a1aa;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        width: 128px;
                        height: 32px;
                        background: #18181c;
                        border-width: 1px;
                        border-color: #27272a;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.closed(true); }
                        }
                        Text {
                            text: "Don't show again";
                            color: #d4d4d8;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        width: 88px;
                        height: 32px;
                        background: #2563eb;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.closed(false); }
                        }
                        Text {
                            text: "Close";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
