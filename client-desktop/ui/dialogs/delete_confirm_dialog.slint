// Confirm removing a history entry (alert sheet).

import { Theme } from "../theme.slint";
import { Btn, Pop } from "../components/controls.slint";
import { AppTile } from "../components/app_tile.slint";

export component DeleteConfirmModal inherits Rectangle {
    background: Theme.scrim;
    width: 100%;
    height: 100%;

    in property <string> delete_target_id: "";
    in property <string> delete_target_label: "";
    in-out property <bool> show_delete_modal: false;

    callback confirm_delete(string);

    // Swallows clicks outside the dialog.
    TouchArea { }

    Pop {
        width: 360px;
        height: body.preferred-height;
        body := VerticalLayout {
            padding: 24px;
            padding-bottom: 20px;
            spacing: 6px;

            HorizontalLayout {
                alignment: center;
                AppTile {
                    kind: "history";
                    tile: 44px;
                }
            }
            Rectangle { height: 8px; }
            Text {
                text: "Remove from History?";
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: root.delete_target_label + " is removed from your session history. You can still connect to it by its ID.";
                color: Theme.text-2;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle { height: 14px; }
            HorizontalLayout {
                spacing: 8px;
                Btn {
                    horizontal-stretch: 1;
                    height: 30px;
                    label: "Cancel";
                    clicked => { root.show_delete_modal = false; }
                }
                Btn {
                    horizontal-stretch: 1;
                    height: 30px;
                    kind: "acc";
                    label: "Remove";
                    clicked => {
                        root.confirm_delete(root.delete_target_id);
                        root.show_delete_modal = false;
                    }
                }
            }
        }
    }
}
