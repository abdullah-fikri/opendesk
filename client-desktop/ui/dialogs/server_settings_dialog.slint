// Relay address and viewer performance dialog.

import { Theme } from "../theme.slint";
import { Btn, Seg, SegWrap, Pop } from "../components/controls.slint";
import { AppTile } from "../components/app_tile.slint";

export component ServerSettingsModal inherits Rectangle {
    background: Theme.scrim;
    width: 100%;
    height: 100%;

    in-out property <string> gateway_url: "";
    in-out property <bool> show_settings: false;
    // Viewer performance preset: 0 = Low, 1 = Medium, 2 = High. Saved with the relay address; applies to
    // running sessions at once.
    in property <int> performance: 1;
    property <int> picked_preset: performance;
    callback save_gateway_url(string);
    callback save_performance(int);

    function save() {
        root.save_performance(root.picked_preset);
        root.save_gateway_url(input-gw.text);
        root.show_settings = false;
    }

    // Swallows clicks outside the dialog.
    TouchArea { }

    Pop {
        width: 420px;
        height: body.preferred-height;
        body := VerticalLayout {
            padding: 24px;
            padding-bottom: 20px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 12px;
                AppTile {
                    y: (parent.height - self.height) / 2;
                    kind: "server";
                    tile: 32px;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Relay Server";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Used to find devices and relay sessions when P2P is unavailable.";
                        color: Theme.text-2;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Gateway address";
                    color: Theme.text-2;
                    font-size: 12px;
                }
                Rectangle {
                    height: 32px;
                    border-radius: 7px;
                    background: Theme.inp;
                    border-width: input-gw.has-focus ? 2px : 0px;
                    border-color: Theme.ring;
                    input-gw := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text <=> root.gateway_url;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => { root.save(); }
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Performance when viewing";
                    color: Theme.text-2;
                    font-size: 12px;
                }
                SegWrap {
                    horizontal-stretch: 1;
                    Seg { horizontal-stretch: 1; label: "Low"; selected: root.picked_preset == 0; clicked => { root.picked_preset = 0; } }
                    Seg { horizontal-stretch: 1; label: "Medium"; selected: root.picked_preset == 1; clicked => { root.picked_preset = 1; } }
                    Seg { horizontal-stretch: 1; label: "High"; selected: root.picked_preset == 2; clicked => { root.picked_preset = 2; } }
                }
                Text {
                    text: root.picked_preset == 0 ? "Saves CPU, battery and data (30 FPS)."
                        : root.picked_preset == 2 ? "Smoothest, follows your monitor's refresh rate."
                        : "Balanced for everyday work (60 FPS).";
                    color: Theme.text-2;
                    font-size: 12px;
                }
            }

            Rectangle { height: 4px; }
            HorizontalLayout {
                spacing: 8px;
                Btn {
                    horizontal-stretch: 1;
                    height: 30px;
                    label: "Cancel";
                    clicked => { root.show_settings = false; }
                }
                Btn {
                    horizontal-stretch: 1;
                    height: 30px;
                    kind: "acc";
                    label: "Save";
                    clicked => { root.save(); }
                }
            }
        }
    }
}
