<?xml version="1.0" encoding="utf-8"?>
<!-- The relay token is a credential and the desk ID belongs to this device: copy neither to the cloud or another phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
