<?xml version="1.0" encoding="utf-8"?>
<!-- Devices (tablet): the list on the left, the selected computer on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <include layout="@layout/view_devices_list" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_pad"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <include layout="@layout/view_id_bar" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/line" />

    <FrameLayout
        android:id="@+id/detail"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/detail_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="88dp"
                android:paddingBottom="32dp">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/icon_tile_big">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_desktop"
                        app:tint="@color/text2" />
                </FrameLayout>

                <TextView
                    android:id="@+id/detail_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:textColor="@color/text"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/detail_id"
                    style="@style/Od.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text2"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/detail_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />

                <include
                    android:id="@+id/detail_state"
                    layout="@layout/view_connect_state"
                    android:layout_width="420dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:id="@+id/detail_connect"
                    style="@style/Od.Button.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_accent_large"
                    android:minWidth="160dp"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="420dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:background="@drawable/card"
                    android:elevation="1dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/detail_recent"
                        layout="@layout/row_setting" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="56dp"
                        android:background="@color/line" />

                    <include
                        android:id="@+id/detail_security"
                        layout="@layout/row_setting" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/detail_empty"
            layout="@layout/view_empty" />
    </FrameLayout>
</LinearLayout>
