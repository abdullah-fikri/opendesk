<?xml version="1.0" encoding="utf-8"?>
<!-- Title, counts, search and the scrolling device list with its empty state; shared by phone and tablet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
        style="@style/Od.LargeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="20dp"
        android:text="@string/tab_devices" />

    <TextView
        android:id="@+id/devices_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="20dp"
        android:paddingEnd="@dimen/page_pad"
        android:textColor="@color/text2"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_search"
        style="@style/Od.Field"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="@dimen/page_pad"
        android:layout_marginTop="14dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        app:drawableTint="@color/text3" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/devices_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadingEdgeLength="28dp"
            android:paddingBottom="12dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/devices_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/page_pad" />
        </ScrollView>

        <include
            android:id="@+id/devices_empty"
            layout="@layout/view_empty"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
