<?xml version="1.0" encoding="utf-8"?>
<!--
  Remote session: the host's screen, the local cursor and, on top, the controls overlay (view_overlay), which the
  activity inflates again on rotation so the portrait sheet or the landscape side panel is used.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_remote_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_bg">

    <!-- H.264 pictures from the hardware decoder, under the JPEG layer; ScreenRenderer transforms both alike. -->
    <TextureView
        android:id="@+id/tv_remote_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- JPEG frames, scaled by ScreenRenderer through the image matrix (fit, fill, pinch zoom and pan); it also takes
         the touches, and turns transparent while H.264 pictures show below. -->
    <ImageView
        android:id="@+id/iv_remote_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="matrix" />

    <!-- Owns the soft keyboard while typing on the remote machine. -->
    <com.opendesk.app.ui.viewer.RemoteKeyboardView
        android:id="@+id/view_remote_keyboard"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="@string/incoming_input_label" />

    <!-- Local pointer: drawn at once, before the host's next frame shows its own cursor. -->
    <FrameLayout
        android:id="@+id/view_virtual_cursor"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:background="@drawable/dot"
            android:backgroundTint="#FFFFFF" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:background="@drawable/dot"
            android:backgroundTint="@color/accent_fill" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_connecting_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/card_elev"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/connecting"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlay_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
