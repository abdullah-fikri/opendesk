<?xml version="1.0" encoding="utf-8"?>
<!-- Where a connection attempt stands: ready (presence and encryption), connecting, or failed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/state_ready"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/state_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot"
                android:backgroundTint="@color/green" />

            <TextView
                android:id="@+id/state_presence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/green"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="@string/e2e_viewer_only"
            android:textColor="@color/text2"
            android:textSize="13sp"
            app:drawableTint="@color/text2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/state_connecting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/connecting"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/connecting_e2e"
            android:textColor="@color/text3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/state_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/banner_error"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_warn"
            app:tint="@color/accent_fill" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/state_error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/connect_failed_title"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/state_error_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
