<?xml version="1.0" encoding="utf-8"?>
<!--
  Monitor wall (admin edition): a toolbar with navigation only (back, pages, settings, full screen), a status
  banner, and the grid (added in code, MonitorGrid). Full screen hides the toolbar and banner; the faint corner
  button leaves it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wall_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/wall_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:id="@+id/wall_back"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:paddingEnd="8dp"
                android:text="@string/tab_devices"
                android:textColor="@color/wall_text"
                android:textSize="16sp"
                app:drawableTint="@color/wall_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:text="@string/monitor_wall"
                android:textColor="@color/wall_text"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/wall_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/wall_prev"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                app:tint="@color/wall_text" />

            <TextView
                android:id="@+id/wall_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="center"
                android:textColor="@color/wall_text2"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/wall_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/wall_next"
                android:padding="9dp"
                android:src="@drawable/ic_chev"
                app:tint="@color/wall_text" />

            <ImageView
                android:id="@+id/wall_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/wall_settings"
                android:padding="11dp"
                android:src="@drawable/ic_gear"
                app:tint="@color/wall_text" />

            <ImageView
                android:id="@+id/wall_full"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/wall_fullscreen"
                android:padding="11dp"
                android:src="@drawable/ic_fit"
                app:tint="@color/wall_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/wall_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:background="@color/wall_banner"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/wall_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/wall_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="6dp">

            <TextView
                android:id="@+id/wall_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/wall_text2"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/wall_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp"
            android:text="@string/wall_hint"
            android:textColor="@color/wall_text2"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/wall_exit_full"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:alpha="0.35"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/wall_exit_fullscreen"
        android:padding="11dp"
        android:src="@drawable/ic_fit"
        android:visibility="gone"
        app:tint="@color/wall_text" />
</FrameLayout>
