<?xml version="1.0" encoding="utf-8"?>
<!-- "Enter a device ID" + Connect, on a raised card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_elev"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:outlineSpotShadowColor="@color/bar_shadow"
    android:padding="8dp"
    tools:targetApi="28">

    <EditText
        android:id="@+id/et_target_id"
        style="@style/Od.Field"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="1"
        android:fontFamily="@font/inter_regular"
        android:paddingHorizontal="16dp"
        android:digits="0123456789 "
        android:hint="@string/enter_target_id"
        android:imeOptions="actionGo"
        android:inputType="number"
        android:maxLength="11" />

    <TextView
        android:id="@+id/btn_connect"
        style="@style/Od.Button.Accent"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginStart="8dp"
        android:minWidth="104dp"
        android:text="@string/connect_to_pc" />
</LinearLayout>
