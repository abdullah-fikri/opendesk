<?xml version="1.0" encoding="utf-8"?>
<!-- Sessions: what this phone opened, grouped by day; an empty state before the first one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/sessions_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/sessions_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_pad"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Od.LargeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:paddingStart="4dp"
                android:text="@string/tab_sessions" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/sessions_empty"
        layout="@layout/view_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="120dp"
        android:visibility="gone" />
</FrameLayout>
