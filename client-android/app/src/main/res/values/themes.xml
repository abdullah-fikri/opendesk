<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OpenDesk" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorPrimaryVariant">@color/accent_red_dark</item>
        <item name="colorOnPrimary">@color/text_main</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:windowBackground">@color/bg_main</item>
