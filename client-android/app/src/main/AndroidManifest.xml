<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenDesk for Android is a viewer only: it controls other machines and can never be controlled. It declares no
  accessibility service, no screen capture, no overlay and no foreground service (see README.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WebSocket to the relay. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reconnect as soon as the network comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice; asked at runtime only when the user turns the microphone on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenDesk">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles rotation and keyboard changes itself so the stream and its zoom survive them. -->
        <activity
            android:name=".ui.viewer.RemoteViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:exported="false"
            android:theme="@style/Theme.OpenDesk.Fullscreen"
            android:windowSoftInputMode="adjustResize|stateHidden" />

    </application>

</manifest>
