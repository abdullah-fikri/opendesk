# Settings for docker-compose.yml. Copy to .env (never commit .env).

# Relay release to run (image tag ghcr.io/abdullah-fikri/opendesk-relay:<version>, and the version of a local
# --build). Empty = the version this docker-compose.yml was released with.
RELAY_VERSION=
# Overrides the whole image reference, e.g. a private registry.
# RELAY_IMAGE=ghcr.io/abdullah-fikri/opendesk-relay:1.0.2
TZ=UTC

# PostgreSQL (runs on the Docker host by default).
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=opendesk

# Optional per-device tokens: {"123456789":{"token":"<32+ random chars>","admin":true}}. Empty = open relay.
OPENDESK_DEVICE_CREDENTIALS=
# Optional token for GET /metrics (32+ characters). Empty disables the endpoint.
OPENDESK_METRICS_TOKEN=
# 1 keeps every session on the relay (no direct P2P path).
OPENDESK_P2P_DISABLED=0
